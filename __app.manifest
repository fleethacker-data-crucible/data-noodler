<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Transform</title>
<script src="../js/core/embed.js"></script>
<script src="../js/core/theme.js"></script>
<link rel="stylesheet" href="../css/theme.css">
<style>
  /* No visible scrollbars; scrolling is by mouse wheel (global rules in embed.js: Ctrl = 4x, Shift = sideways in tables). */
  * { scrollbar-width: none; }
  *::-webkit-scrollbar { display: none; }
  .lst, .log { overscroll-behavior: contain; }
  /* Column separator: full height of .main (header line to page bottom), 20px either side of it, matching the page padding. */
  .split { column-gap: 40px; }
  .main { background: linear-gradient(var(--border), var(--border)) no-repeat 340px 0 / 1px 100%; }
  @media (max-width: 800px) { .main { background-image: none; } }
  /* Section headings: 25px above each, none above the first one in each column. */
  .split h2 { margin: 25px 0 10px; }
  aside > section:first-child > h2, #editor > section:first-child > h2 { margin-top: 0; }
  #editor { margin-top: 0; }
  aside { display: flex; flex-direction: column; }
  .lst { border: 1px solid var(--border); border-radius: 4px; background: var(--bg); max-height: 300px; overflow: auto; }
  .lst > div { display: flex; justify-content: space-between; align-items: center; gap: 8px; height: 25px; box-sizing: border-box; padding: 0 8px; cursor: pointer; }   /* rows as tall as a text box */
  .lst > div + div { border-top: 1px solid var(--border); }
  .lst > div:hover { background: var(--panel); }
  .lst > div.sel { background: var(--sel); font-weight: 600; }
  .lst small { color: var(--muted); white-space: nowrap; }
  /* Expand arrow: the same ▾ glyph, size and weight as the Preview Source Datasets button; turned when shut. */
  .lst .tw { color: var(--muted); display: inline-block; width: 16px; font-size: 17px; font-weight: 600; line-height: 1; text-align: center; margin-right: 4px; }
  .lst .tw.shut { transform: rotate(-90deg); }
  .lst > div.fsrch { padding: 0 8px 0 30px; cursor: default; }
  .lst > div.fsrch:hover { background: none; }
  .fsrch input { width: 100%; height: 19px; box-sizing: border-box; font-size: 12.5px; }
  .lst > div.fld { padding-left: 30px; font-family: var(--mono); font-size: 12.5px; }
  .lst .n { color: var(--muted); font-family: var(--mono); margin-right: 6px; }
  /* Preview grid (same as Import's) ends 20px above the page bottom; fit() sets its max-height. */
  .progress.busy > i { width: 30% !important; animation: busy 1.2s linear infinite; }
  @keyframes busy { from { margin-left: -30%; } to { margin-left: 100%; } }
  #result .table-wrap { max-height: 480px; }
  #outName { width: 100%; box-sizing: border-box; font-family: var(--mono); }
  #qName.bad, #qName.bad:focus { border-color: var(--err); outline: 1px solid var(--err); }
  #qName::placeholder { color: var(--muted); }
  #qName { min-width: 260px; font-family: var(--mono); }
  .lst .act { color: var(--ok); font-weight: 600; letter-spacing: .04em; }
</style>
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="brand"><span class="logo">DN</span><div><h1 id="title">Transform</h1><div class="sub" id="sub"></div></div></div>
    <div class="spacer"></div>
  </header>
  <div class="main">
    <div class="split">
      <aside>
        <section>
          <h2 title="Click a dataset: show its fields
Shift+click a dataset: insert its name in the SQL
Click a field: insert it in the SQL">Input datasets</h2>
          <div class="lst" id="dsList"></div>
        </section>
        <section id="outSec"><h2 title="The active query's result is saved under this name (Parquet parts in data/source)">Output dataset name</h2><input id="outName" type="text" placeholder="CLEAN_NAME" spellcheck="false"><div class="row" style="margin-top:10px"><button id="run" title="Run the active query over all of the input data and save the result as the output dataset">Build Output Dataset</button></div></section>
        <section>
          <h2 title="Write and try out as many queries as you like; the active one builds the output dataset">Queries</h2>
          <div class="row" style="margin-bottom:8px"><button id="add">Add</button><button id="setActive" class="ghost" title="Make the selected query the one Build Output Dataset runs">Set Active</button><button id="del" class="danger">Delete</button></div>
          <div class="lst" id="qList"></div>
        </section>
      </aside>
      <section class="stack">
        <div id="none" class="muted">Click Add to write a query. A query is one SELECT, or a script (CREATE TABLE, INSERT, UPDATE, ... ) that ends with a SELECT. The active query builds the output dataset (Parquet in data/source). The simplest one is <span class="mono">SELECT * FROM &lt;input dataset&gt;</span>.</div>
        <div id="editor" hidden class="stack">
          <section><h2>Query name</h2><input id="qName" type="text" placeholder="Required: name this query" spellcheck="false"></section>
          <h2 title="One SELECT, or several statements separated by ; that end with a SELECT (its result is the output)">SQL <small class="muted" style="text-transform:none;letter-spacing:0">Tab / Shift+Tab indent · Ctrl+Space suggestions · Ctrl+Enter preview</small></h2>
          <div id="sql"></div>
          <div id="sqlErr" class="err" hidden style="font-size:12.5px;margin-top:4px"></div>
          <section class="stack"><h2>Activity</h2><div class="progress"><i id="bar"></i></div><div class="log" id="log"></div></section>
          <div class="row">
            <span style="position:relative"><button id="srcPrev" class="ghost">Preview Source Datasets ▾</button><div id="srcMenu" class="sqled-pop" hidden style="top:100%;left:0;margin-top:4px"></div></span><button id="preview" class="ghost" title="Run this query (top 100 rows and the total row count)">Preview Output</button><button id="popout" class="ghost" title="Show the preview table in its own window; it comes back here when that window closes">Pop-out Preview</button><span id="pinfo" class="muted" style="margin-left:15px"></span>
          </div>
          <div id="result"></div>
        </div>
      </section>
    </div>
  </div>
</div>

<script src="../js/dn-fs.js"></script>
<script src="../js/core/engine-client.js"></script>
<script src="../js/core/ui.js"></script>
<script src="../js/core/project-log.js"></script>
<script src="../js/core/projects.js"></script>
<script src="../js/core/module-page.js"></script>
<script src="../js/pipeline/steps.js"></script>
<script src="../js/pipeline/runner.js"></script>
<script src="../js/pipeline/sql-editor.js"></script>
<script>
// Transform = a list of SQL queries (each one SELECT or a script ending in a SELECT; engine/Core/Script.cs). The
// active query builds the output dataset data/source/<CLEAN_name>/ (Parquet parts). Saved in pipeline/pipeline.json as
// { version: 2, queries: [{ id, name, sql }], active, output } (see js/pipeline/runner.js).
const { $, esc } = UI;
// Input datasets: click expands the field list, Shift+click inserts the dataset name; click a field to insert it.
const open = new Set(), fq = new Map();   // fq: field search text per dataset
const fhit = (ds, col) => col.toLowerCase().includes((fq.get(ds) || '').trim().toLowerCase());
let ctx, pipe = { version: 2, queries: [], active: null, output: '' }, sel = -1, dirty = false, saveT;
// Auto-save: every edit schedules a write of pipeline.json shortly after typing stops.
const touch = () => { dirty = true; clearTimeout(saveT); saveT = setTimeout(() => save().catch(e => UI.toast('Auto-save failed: ' + e.message, 'err')), 600); };
const FILE = () => PipelineRunner.file(ctx);
const OUT = /^CLEAN_[A-Z0-9_]+$/;
// Dataset and field lists are alphabetical (queries keep their own order).
const abc = (a, b) => a.localeCompare(b, undefined, { sensitivity: 'base', numeric: true });
const staged = () => (ctx?.cfg.datasets || []).filter(d => Projects.stageOf(d) === 'staged').sort((a, b) => abc(a.name, b.name));
const cur = () => pipe.queries[sel];
const named = q => !!(q && (q.name || '').trim());
const locked = () => !named(cur()) || $('sql').querySelector('textarea').readOnly;

const ed = SqlEditor.mount($('sql'), {
  onChange: v => { const q = cur(); if (q) { q.sql = v; touch(); } },
  // Live syntax / name check by the engine; the first error is shown under the editor.
  check: text => ctx ? Engine.check(text, Engine.views(ctx.cfg.datasets || [])) : [],
  onCheck: errs => { const e = errs[0], el = $('sqlErr'); el.hidden = !e; el.textContent = e ? (e.line ? `Line ${e.line}: ` : '') + e.message : ''; },
  words: () => ({ tables: (ctx?.cfg.datasets || []).map(d => d.name),
                  columns: [...new Set((ctx?.cfg.datasets || []).flatMap(d => (d.columns || []).map(c => c.name)))] }),
});

function render() {
  $('dsList').innerHTML = staged().map(d => `<div data-ds="${esc(d.name)}" title="Click: show fields · Shift+click: insert name"><span><span class="tw${open.has(d.name) ? '' : ' shut'}">▾</span>${esc(d.name)}</span><small>${UI.rows(d.rows)} rows · ${d.columns.length} cols</small></div>`
    + (open.has(d.name) ? `<div class="fsrch"><input type="search" data-fs="${esc(d.name)}" placeholder="Search fields…" value="${esc(fq.get(d.name) || '')}" spellcheck="false"></div>` + [...d.columns].sort((a, b) => abc(a.name, b.name)).map(c => `<div class="fld" data-col="${esc(c.name)}" title="Click to insert"${fhit(d.name, c.name) ? '' : ' hidden'}><span>${esc(c.name)}</span><small>${esc(c.type)}</small></div>`).join('') : '')).join('') || '<div class="muted">Nothing staged. Import data first.</div>';
  $('qList').innerHTML = pipe.queries.map((q, i) => `<div data-i="${i}" draggable="true" title="Drag to reorder" class="${i === sel ? 'sel' : ''}"><span><span class="n">${i + 1}</span>${named(q) ? esc(q.name) : '<span class="muted" style="font-weight:400">blank</span>'}</span>${q.id === pipe.active ? '<small class="act" title="Build Output Dataset runs this query">ACTIVE</small>' : ''}</div>`).join('') || '<div class="muted">No queries yet.</div>';
  $('none').hidden = sel >= 0; $('editor').hidden = sel < 0;
  $('del').disabled = sel < 0;
  $('setActive').disabled = sel < 0 || cur().id === pipe.active;
  $('run').disabled = !PipelineRunner.active(pipe);
  $('run').title = PipelineRunner.active(pipe) ? `Run "${PipelineRunner.active(pipe).name || 'blank'}" over all of the input data and save the result as ${pipe.output || 'the output dataset'}` : 'Set an active query first';
  // A query needs a name before its SQL can be edited or previewed: the empty box is outlined red.
  const q = cur(), need = !!q && !named(q), ta = $('sql').querySelector('textarea');
  $('qName').classList.toggle('bad', need); $('preview').disabled = need;
  if (ta) { ta.readOnly = need; ta.title = need ? 'Enter a query name first' : ''; }
  $('sql').style.opacity = need ? '.5' : '';
}
function select(i) {
  sel = i; const q = cur();
  ed.value = q ? q.sql : ''; $('qName').value = q ? q.name || '' : '';
  last = null; showTable(); info(''); render();
}

$('dsList').onclick = ev => {
  const f = ev.target.closest('[data-col]'); if (f) { if (sel >= 0 && !locked()) ed.insert(f.dataset.col); return; }
  const el = ev.target.closest('[data-ds]'); if (!el) return;
  if (ev.shiftKey) { if (sel >= 0 && !locked()) ed.insert(el.dataset.ds); return; }
  const n = el.dataset.ds; open.has(n) ? open.delete(n) : open.add(n); render();
};
// Field search: filters that dataset's fields in place (no re-render, so the box keeps focus).
$('dsList').oninput = ev => {
  const i = ev.target.closest('[data-fs]'); if (!i) return; const ds = i.dataset.fs; fq.set(ds, i.value);
  for (let el = i.parentElement.nextElementSibling; el?.classList.contains('fld'); el = el.nextElementSibling) el.hidden = !fhit(ds, el.dataset.col);
};
$('dsList').onmousedown = ev => { if (ev.shiftKey) ev.preventDefault(); };   // no text selection on Shift+click
$('qList').onclick = ev => { const el = ev.target.closest('[data-i]'); if (el) select(+el.dataset.i); };
// The output name is upper case, spaces become _, and always starts with CLEAN_ (a partly deleted prefix is restored).
const PRE = 'CLEAN_';
$('outName').oninput = () => { const o = $('outName'); let p = o.selectionStart, u = o.value.toUpperCase().replace(/\s/g, '_'), k = 0; while (k < PRE.length && u[k] === PRE[k]) k++; if (k < PRE.length) { u = PRE + u.slice(k); p = Math.max(PRE.length, p + PRE.length - k); } if (u !== o.value) { o.value = u; o.setSelectionRange(p, p); } pipe.output = o.value.trim(); touch(); render(); };
// Query names are upper case with _ for spaces, as you type.
$('qName').oninput = () => { const o = $('qName'), p = o.selectionStart, u = o.value.toUpperCase().replace(/\s/g, '_'); if (u !== o.value) { o.value = u; o.setSelectionRange(p, p); } const q = cur(); if (!q) return; q.name = o.value; touch(); render(); };
$('add').onclick = () => {
  const first = staged()[0]?.name || 'my_dataset';
  pipe.queries.push({ id: crypto.randomUUID(), name: '', sql: `SELECT *\nFROM ${first}` });
  if (!PipelineRunner.active(pipe)) pipe.active = pipe.queries[pipe.queries.length - 1].id;   // there is always an active query
  touch(); select(pipe.queries.length - 1); $('qName').focus();
};
$('setActive').onclick = () => {
  const q = cur(); if (!q) return;
  pipe.active = q.id; touch(); render();
  ctx.log(`Active query: ${named(q) ? q.name : 'blank'}`);
};
// Drag a query up or down the list to reorder it; the selection follows the selected query.
let dragFrom = -1;
const qMark = el => { [...$('qList').children].forEach(c => c.style.boxShadow = ''); if (el) el.style.boxShadow = el._after ? 'inset 0 -2px 0 var(--accent, #4a8cff)' : 'inset 0 2px 0 var(--accent, #4a8cff)'; };
$('qList').addEventListener('dragstart', ev => { const el = ev.target.closest('[data-i]'); if (!el) return; dragFrom = +el.dataset.i; ev.dataTransfer.effectAllowed = 'move'; ev.dataTransfer.setData('text/plain', ''); el.style.opacity = '.4'; });
$('qList').addEventListener('dragover', ev => { const el = ev.target.closest('[data-i]'); if (dragFrom < 0 || !el) return; ev.preventDefault(); const r = el.getBoundingClientRect(); el._after = ev.clientY > r.top + r.height / 2; qMark(el); });
$('qList').addEventListener('dragleave', ev => { if (!$('qList').contains(ev.relatedTarget)) qMark(null); });
$('qList').addEventListener('dragend', () => { dragFrom = -1; render(); });
$('qList').addEventListener('drop', ev => {
  const el = ev.target.closest('[data-i]'); if (dragFrom < 0 || !el) return; ev.preventDefault();
  let to = +el.dataset.i + (el._after ? 1 : 0); if (to > dragFrom) to--;
  const from = dragFrom; dragFrom = -1; if (to === from) return render();
  const c = cur(), [q] = pipe.queries.splice(from, 1); pipe.queries.splice(to, 0, q);
  touch(); sel = pipe.queries.indexOf(c); render();
});
$('del').onclick = UI.guard(async () => {
  const q = cur();
  if (!await UI.confirm(`Are you sure you want to delete the query "${named(q) ? q.name.trim() : 'blank'}"?`, { danger: true, ok: 'Delete' })) return;
  pipe.queries.splice(sel, 1);
  if (pipe.active === q.id) {
    // The active query is gone: the first remaining one takes over, so there is always an active query.
    pipe.active = pipe.queries[0]?.id || null;
    if (pipe.active) ctx.log(`Active query is now: ${named(pipe.queries[0]) ? pipe.queries[0].name : 'blank'}`, 'warn');
  }
  touch(); select(Math.min(sel, pipe.queries.length - 1));
});

// Building needs an active, named query with SQL and a valid CLEAN_ output name that is not an input dataset.
function validate() {
  const q = PipelineRunner.active(pipe);
  if (!q) throw new Error('Set an active query first (Add a query, then Set Active).');
  if (!named(q)) throw new Error('Give the active query a name.');
  if (!q.sql.trim()) throw new Error(`The active query "${q.name}" is empty.`);
  if (!OUT.test(pipe.output || '')) throw new Error('Enter an output dataset name: CLEAN_ followed by letters, digits or _.');
  if (staged().some(d => d.name === pipe.output)) throw new Error(`"${pipe.output}" is an input dataset; pick another output name.`);
}

// Preview: the selected query's output, or a source dataset. Top 100 rows plus the total row count; for a script
// the engine runs its statements once, then the rows and the count of the final SELECT in parallel on all workers.
async function preview(label, sql) {
  const st = ctx.step(`Previewing ${label}…`), pb = $('bar').parentElement, t0 = performance.now();
  pb.classList.add('busy');
  let dots = 0; const calc = () => info(`Running${'.'.repeat(dots++ % 4 + 1)}`);
  calc(); const tick = setInterval(calc, 500);
  try {
    const r = await Engine.preview(sql, { views: Engine.views(ctx.cfg.datasets || []), limit: 100 });
    last = { cols: r.cols, rows: r.rows, title: label }; showTable();
    info(`${UI.num(r.count)} rows · ${r.cols.length} columns · ${UI.ms(performance.now() - t0)}`);
    st.done(`Previewed ${label}: ${UI.num(r.count)} rows`);
  }
  catch (e) { st.fail(`Preview of ${label} failed: ${e.message}`); info('Preview failed'); throw e; }
  finally { clearInterval(tick); pb.classList.remove('busy'); }
}
$('preview').onclick = UI.guard(async () => {
  const q = cur(); if (!q || !named(q)) return;
  if (!q.sql.trim()) throw new Error('Write a query first.');
  await ctx.reload();
  await preview(q.name.trim(), q.sql);
});
$('srcPrev').onclick = ev => {
  ev.stopPropagation(); const m = $('srcMenu');
  if (!m.hidden) return m.hidden = true;
  m.innerHTML = staged().map(d => `<div data-ds="${esc(d.name)}"><span>${esc(d.name)}</span><small>${UI.rows(d.rows)} rows</small></div>`).join('') || '<div class="muted">Nothing staged.</div>';
  m.hidden = false;
};
$('srcMenu').onclick = UI.guard(async ev => {
  const el = ev.target.closest('[data-ds]'); if (!el) return;
  $('srcMenu').hidden = true;
  await preview(el.dataset.ds, `SELECT * FROM ${Engine.q(el.dataset.ds)}`);
});
addEventListener('click', ev => { if (!ev.target.closest('#srcMenu')) $('srcMenu').hidden = true; });
function fit(win = window) { const w = win.document.getElementById('result')?.querySelector('.table-wrap'); if (w) w.style.maxHeight = Math.max(120, win.innerHeight - w.getBoundingClientRect().top - 20) + 'px'; }
addEventListener('resize', () => fit());

// Pop-out preview: the table (and its row/column info) moves to its own window; every preview updates it there.
// When that window closes the table comes back here.
let last = null, pop = null, popWatch;
const popped = () => pop && !pop.closed;
function info(t) { $('pinfo').textContent = t; if (popped()) pop.document.getElementById('info').textContent = t; }
function showTable() {
  const el = popped() ? pop.document.getElementById('result') : $('result');
  if (last) UI.dataTable(el, last.cols, last.rows); else el.innerHTML = '';
  if (popped()) { pop.document.title = last ? last.title : 'Preview'; fit(pop); } else fit();
}
$('popout').onclick = () => {
  if (popped()) return pop.focus();
  pop = window.open('', 'dn-preview', 'width=1100,height=700');
  if (!pop) return UI.toast('The browser blocked the pop-out window. Allow pop-ups for this site.', 'err');
  const u = f => new URL(f, location.href).href;
  pop.document.open();
  pop.document.write(`<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Preview · Data Noodler</title>
<link rel="stylesheet" href="${u('../css/theme.css')}">
<style>body { padding: 20px; } #info { margin-bottom: 10px; } * { scrollbar-width: none; } *::-webkit-scrollbar { display: none; }</style>
</head><body><div id="info" class="muted"></div><div id="result"></div></body></html>`);
  pop.document.close();
  // No scripts in the pop-out (a script tag would delay parsing past this point); copy the theme instead.
  pop.document.documentElement.dataset.theme = document.documentElement.dataset.theme || 'dark';
  pop.document.getElementById('info').textContent = $('pinfo').textContent;
  pop.addEventListener('resize', () => fit(pop));
  $('result').hidden = true; $('popout').disabled = true;
  showTable();
  clearInterval(popWatch);
  popWatch = setInterval(() => { if (popped()) return; clearInterval(popWatch); pop = null; $('result').hidden = false; $('popout').disabled = false; showTable(); }, 500);
};
addEventListener('pagehide', () => { if (popped()) pop.close(); });
$('sql').addEventListener('keydown', ev => { if (ev.key === 'Enter' && ev.ctrlKey) { ev.preventDefault(); $('preview').click(); } });

async function save() { clearTimeout(saveT); pipe.version = 2; pipe.updated = new Date().toISOString(); pipe.rev = (pipe.rev || 0) + 1; await DNFS.writeJSON(FILE(), pipe); dirty = false; }
$('run').onclick = UI.guard(async () => {
  try { validate(); } catch (e) { ctx.log(e.message, 'err'); throw e; }
  await save();
  $('run').disabled = true;
  try {
    // Progress bar: the engine's job % when it reports one, otherwise the busy animation.
    const pb = $('bar').parentElement, bar = p => $('bar').style.width = `${Math.round(p)}%`;
    pb.classList.add('busy'); bar(0);
    const st = ctx.step(`Building ${pipe.output}…`);
    const rec = await PipelineRunner.run(ctx, pipe, (m, l) => ctx.log(m, l), null, j => { if (j.progress != null) { pb.classList.remove('busy'); bar(100 * j.progress); } })
      .catch(e => { st.fail(`Build failed: ${e.message}`); throw e; }).finally(() => pb.classList.remove('busy'));
    if (!rec.ok) { st.fail(`Build failed: ${rec.error}`); throw new Error(`Build failed: ${rec.error}`); }
    bar(100); st.done(`Built ${pipe.output}`); UI.toast(`${pipe.output} built`, 'ok');
    setTimeout(() => bar(0), 1200);
  } finally { $('run').disabled = false; await ctx.reload(); render(); }
});
window.addEventListener('beforeunload', ev => { if (dirty) { ev.preventDefault(); ev.returnValue = ''; } });

(async () => {
  try {
    ctx = await ModulePage.init('pipeline', 'Transform');
    pipe = await PipelineRunner.load(ctx);
    if (!pipe.output) pipe.output = 'CLEAN_OUTPUT';
    if (pipe.queries.length && !PipelineRunner.active(pipe)) pipe.active = pipe.queries[0].id;
    $('outName').value = pipe.output;
    const ai = pipe.queries.findIndex(q => q.id === pipe.active);
    select(pipe.queries.length ? Math.max(0, ai) : -1);
  } catch (e) { UI.toast(e.message, 'err'); $('none').textContent = e.message; }
})();
</script>
</body>
</html>

=== FILE text 14771 14771 893e620f93da01fa1741c699abde2d3082b6ada96231a2cc44307fab196df4af 210 html/update.html
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Update</title>
<script src="../js/core/embed.js"></script>
<script src="../js/core/theme.js"></script>
<link rel="stylesheet" href="../css/theme.css">
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="brand"><span class="logo">DN</span><div><h1 id="title">Update</h1><div class="sub" id="sub"></div></div></div>
    <button id="check" class="ghost">Check sources</button>
    <button id="go">Update selected</button>
    <button id="arch" class="ghost">Archive</button>
    <div class="spacer"></div>
  </header>
  <div class="main stack">
    <div class="muted">Re-imports datasets whose source files changed (with the same column choices as the first import), then re-runs the pipeline. Copy a new version of a file over the old one in data/raw (or at its original path), or upload it with the same name in Import.</div>
    <label class="row"><input type="checkbox" id="rerun" checked> Re-run the pipeline afterwards</label>
    <div class="table-wrap"><table class="grid" id="tbl"></table></div>
    <h2>Changes</h2>
    <div id="changes" class="muted">Run an update to see what changed.</div>
    <h2>Activity</h2>
    <div class="log" id="log"></div>
  </div>
</div>

<dialog id="archDlg" class="arch-dlg">
  <header class="row">Archive<div class="spacer"></div><button id="archClose" class="ghost small">Close</button></header>
  <div class="body">
    <div class="muted">A snapshot copies the project's settings, staged datasets, pipeline and dashboard into archives/. Source files and published output are not included.</div>
    <div class="row"><input id="note" type="text" placeholder="Note for the snapshot (optional)" style="flex:1"><button id="snap">Take snapshot</button></div>
    <div class="table-wrap"><table class="grid" id="snapTbl"></table></div>
    <h2>Compare with current</h2>
    <div id="cmp" class="muted">Click Compare on a snapshot.</div>
  </div>
</dialog>
<style>.arch-dlg { width: min(1000px, 94vw); max-height: 88vh; overflow: auto; } .arch-dlg header { display: flex; align-items: center; padding-bottom: 4px; }</style>

<script src="../js/dn-fs.js"></script>
<script src="../js/core/ui.js"></script>
<script src="../js/core/project-log.js"></script>
<script src="../js/core/projects.js"></script>
<script src="../js/core/module-page.js"></script>
<script src="../js/core/engine-client.js"></script>
<script src="../js/import/external-source.js"></script>
<script src="../js/pipeline/steps.js"></script>
<script src="../js/pipeline/runner.js"></script>
<script>
const { $, esc } = UI;
let ctx, state = []; // [{ d, stat, status }]

// Sources live in the project (source.path) or outside it (source.origin: local/network path, via the server).
const X = ExternalSource;
const srcName = d => (d.source.path || d.source.origin || '').split(/[\\/]/).pop();
async function statSource(d) {
  if (d.source.path) return DNFS.stat(d.source.path).catch(() => ({ exists: false }));
  try { const p = await X.probe(d.source.origin, { onWait: dr => UI.toast(`Waiting on drive ${dr}…`) }); return { exists: true, size: p.size, modified: p.modified }; }
  catch (e) { ctx.log(`${d.name}: ${e.message}`, 'err'); return { exists: false, error: e.message }; }
}

async function check() {
  await ctx.reload();
  state = [];
  for (const d of (ctx.cfg.datasets || []).filter(x => x.source && x.source.kind !== 'pipeline')) {
    const st = await statSource(d);
    const status = !st.exists ? 'missing' : (d.source.size == null ? 'unknown' : st.size !== d.source.size || st.modified !== d.source.modified ? 'changed' : 'same');
    state.push({ d, st, status });
  }
  $('tbl').innerHTML = `<thead><tr><th></th><th>Dataset</th><th>Source file</th><th>Imported</th><th>Source now</th><th>Status</th></tr></thead><tbody>` +
    state.map((s, i) => `<tr><td><input type="checkbox" data-i="${i}" ${s.status === 'changed' || s.status === 'unknown' ? 'checked' : ''} ${s.status === 'missing' ? 'disabled' : ''}></td>
      <td><b>${esc(s.d.name)}</b><div class="sub">${UI.num(s.d.rows)} rows</div></td><td class="mono">${esc(srcName(s.d))}${s.d.source.table ? ` : ${esc(s.d.source.table)}` : ''}</td>
      <td>${UI.date(s.d.imported)}</td><td>${s.st.exists ? `${UI.bytes(s.st.size)} · ${UI.date(s.st.modified)}` : '-'}</td>
      <td>${{ same: '<span class="muted">unchanged</span>', changed: '<span class="warn">changed</span>', missing: '<span class="err">missing</span>', unknown: '<span class="muted">unknown (older import)</span>' }[s.status]}</td></tr>`).join('') + '</tbody>';
  if (!state.length) $('tbl').innerHTML = '<tbody><tr><td class="muted">No imported datasets yet.</td></tr></tbody>';
}
$('check').onclick = UI.guard(check);

// Re-import one dataset (the engine reads the source where it is, same columns as the first import);
// returns a description of what changed.
async function reimport(d) {
  const oldCols = d.columns, ext = !d.source.path;
  const from = Engine.src(ext ? d.source.origin : d.source.path, d.source.table || '');
  const total = await Engine.count(from);
  const w = await Engine.write({ sql: `SELECT ${d.source.select} FROM ${from}`, dest: d.path.replace(/\.parquet$/, ''), meta: { source: d.source.origin || d.source.path } });
  const rows = w.rowCount, columns = Engine.columnsOf(w);
  if (rows !== total) throw new Error(`${d.name}: ${UI.num(total)} rows in source, ${UI.num(rows)} written.`);
  const st = await statSource(d);
  await Projects.upsertDataset(ctx.folder, { ...d, path: w.path, parts: w.files, rows, bytes: w.bytes, columns, version: w.version, imported: new Date().toISOString(), source: { ...d.source, size: st.size, modified: st.modified } });
  const was = new Map(oldCols.map(c => [c.name, c.type])), now = new Map(columns.map(c => [c.name, c.type]));
  return {
    name: d.name, before: d.rows, after: rows,
    added: columns.filter(c => !was.has(c.name)).map(c => c.name),
    removed: oldCols.filter(c => !now.has(c.name)).map(c => c.name),
    retyped: columns.filter(c => was.has(c.name) && was.get(c.name) !== c.type).map(c => `${c.name} ${was.get(c.name)}→${c.type}`),
  };
}
const delta = (a, b) => { const d = b - a; return `${UI.num(a)} → ${UI.num(b)} <span class="${d > 0 ? 'ok' : d < 0 ? 'err' : 'muted'}">(${d >= 0 ? '+' : ''}${UI.num(d)})</span>`; };

$('go').onclick = UI.guard(async () => {
  const picked = [...document.querySelectorAll('#tbl input:checked')].map(c => state[+c.dataset.i]);
  if (!picked.length && !$('rerun').checked) throw new Error('Nothing selected.');
  $('go').disabled = true;
  const out = [];
  try {
    for (const s of picked) {
      const st = ctx.step(`Re-importing ${s.d.name}…`);
      let c; try { c = await reimport(s.d); } catch (e) { st.fail(`${s.d.name}: ${e.message}`); throw e; }
      out.push(c); st.done(`${c.name}: ${UI.num(c.before)} → ${UI.num(c.after)} rows`);
    }
    let run = null;
    if ($('rerun').checked) {
      const pipe = await PipelineRunner.load(ctx);
      // Only the outputs downstream of re-imported datasets run again (all of them when nothing was re-imported).
      if (PipelineRunner.active(pipe)) { const st = ctx.step('Rebuilding the transform output…'); run = await PipelineRunner.run(ctx, pipe, (m, l) => ctx.log(m, l), out.length ? out.map(c => c.name) : null).catch(e => { st.fail(e.message); throw e; }); st.done(run.ok ? 'Transform output rebuilt' : 'Transform rebuild failed', run.ok ? 'ok' : 'error'); }
    }
    await Projects.touchModule(ctx.folder, 'update', { datasets: out.length });
    $('changes').innerHTML = `<div class="table-wrap"><table class="grid"><thead><tr><th>Dataset</th><th>Rows</th><th>Columns added</th><th>Columns removed</th><th>Type changes</th></tr></thead><tbody>` +
      out.map(c => `<tr><td>${esc(c.name)}</td><td>${delta(c.before, c.after)}</td><td>${esc(c.added.join(', ')) || '-'}</td><td>${esc(c.removed.join(', ')) || '-'}</td><td>${esc(c.retyped.join(', ')) || '-'}</td></tr>`).join('') +
      (run ? run.outputs.map(o => `<tr><td>${esc(o.name)} <span class="muted">(pipeline)</span></td><td>${o.before == null ? UI.num(o.rows) : delta(o.before, o.rows)}</td><td colspan="3" class="muted">re-run ${run.ok ? 'ok' : 'failed'}</td></tr>`).join('') : '') +
      `</tbody></table></div>` + (run && !run.ok ? `<div class="err">Pipeline failed: ${esc(run.error)}</div>` : '');
    UI.toast('Update finished', 'ok');
  } finally { $('go').disabled = false; await check(); }
});

// ---- Archive popup (snapshots of the project) ----
const PARTS = ['project-config.json', 'data/staged', 'data/source', 'pipeline', 'dashboard']; // what a snapshot holds
const stamp = () => new Date().toISOString().slice(0, 19).replace(/[-:]/g, '').replace('T', '-');

async function snapshots() {
  let dirs = [];
  try { dirs = (await DNFS.list(`${ctx.dir}/archives`)).filter(d => d.dir); } catch {}
  const out = [];
  for (const d of dirs) { try { out.push({ ...(await DNFS.readJSON(`${d.path}/snapshot.json`)), path: d.path }); } catch {} }
  return out.sort((a, b) => b.at.localeCompare(a.at));
}
async function render() {
  const list = await snapshots();
  $('snapTbl').innerHTML = `<thead><tr><th>Taken</th><th>Note</th><th class="num">Datasets</th><th class="num">Size</th><th></th></tr></thead><tbody>` +
    list.map(s => `<tr data-p="${esc(s.path)}"><td>${UI.date(s.at)}</td><td>${esc(s.note || '')}</td><td class="num">${s.datasets.length}</td><td class="num">${UI.bytes(s.bytes)}</td>
      <td><button class="ghost small" data-act="cmp">Compare</button> <button class="small" data-act="restore">Restore</button> <button class="danger small" data-act="del">Delete</button></td></tr>`).join('') + '</tbody>';
  if (!list.length) $('snapTbl').innerHTML = '<tbody><tr><td class="muted">No snapshots yet.</td></tr></tbody>';
}

async function take(note) {
  await ctx.reload();
  const dir = `${ctx.dir}/archives/${stamp()}`;
  for (const p of PARTS) if ((await DNFS.stat(`${ctx.dir}/${p}`)).exists) await DNFS.copy(`${ctx.dir}/${p}`, `${dir}/${p}`);
  let bytes = 0;
  try { bytes = (await DNFS.list(dir, { recursive: true })).reduce((s, f) => s + (f.dir ? 0 : f.size), 0); } catch {}
  const info = { at: new Date().toISOString(), note, bytes, datasets: (ctx.cfg.datasets || []).map(d => ({ name: d.name, rows: d.rows, columns: d.columns.length })) };
  await DNFS.writeJSON(`${dir}/snapshot.json`, info);
  await Projects.touchModule(ctx.folder, 'archives');
  ctx.log(`Snapshot taken: ${dir.split('/').pop()}${note ? ` (${note})` : ''}, ${UI.bytes(bytes)}`, 'ok');
  return dir;
}
$('snap').onclick = UI.guard(async () => { $('snap').disabled = true; try { await take($('note').value.trim()); $('note').value = ''; UI.toast('Snapshot taken', 'ok'); await render(); } finally { $('snap').disabled = false; } });

// Current state vs a snapshot: datasets (rows, columns), pipeline steps, dashboard widgets.
async function compare(path) {
  const cur = await ctx.reload(), old = await DNFS.readJSON(`${path}/project-config.json`);
  const read = async p => { try { return await DNFS.readJSON(p); } catch { return null; } };
  const [pn, po, dn, dO] = await Promise.all([read(`${ctx.dir}/pipeline/pipeline.json`), read(`${path}/pipeline/pipeline.json`), read(`${ctx.dir}/dashboard/dashboard.json`), read(`${path}/dashboard/dashboard.json`)]);
  const names = [...new Set([...(old.datasets || []), ...(cur.datasets || [])].map(d => d.name))];
  const by = (l, n) => (l || []).find(d => d.name === n);
  const row = n => {
    const a = by(old.datasets, n), b = by(cur.datasets, n);
    const st = !a ? '<span class="ok">new</span>' : !b ? '<span class="err">removed</span>' : a.rows !== b.rows || a.columns.length !== b.columns.length ? '<span class="warn">changed</span>' : '<span class="muted">same</span>';
    return `<tr><td>${esc(n)}</td><td class="num">${a ? UI.num(a.rows) : '-'}</td><td class="num">${b ? UI.num(b.rows) : '-'}</td><td class="num">${a ? a.columns.length : '-'}</td><td class="num">${b ? b.columns.length : '-'}</td><td>${st}</td></tr>`;
  };
  $('cmp').innerHTML = `<div class="table-wrap"><table class="grid"><thead><tr><th>Dataset</th><th class="num">Rows then</th><th class="num">Rows now</th><th class="num">Columns then</th><th class="num">Columns now</th><th></th></tr></thead><tbody>${names.map(row).join('')}</tbody></table></div>
    <div style="margin-top:8px">Transform queries: ${PipelineRunner.migrate(po).queries.length} then, ${PipelineRunner.migrate(pn).queries.length} now · Dashboard widgets: ${dO?.widgets?.length ?? 0} then, ${dn?.widgets?.length ?? 0} now · Status then: ${esc(old.status)}, now: ${esc(cur.status)}</div>`;
}

// Restore: snapshot the current state first, then copy the snapshot back. Name and folder stay as they are now.
async function restore(path) {
  if (!await UI.confirm('Restore this snapshot? Staged datasets, pipeline and dashboard are replaced. The current state is saved as a new snapshot first.', { danger: true, ok: 'Restore' })) return;
  await take(`Before restoring ${path.split('/').pop()}`);
  for (const p of PARTS.filter(p => p !== 'project-config.json')) {
    if ((await DNFS.stat(`${ctx.dir}/${p}`)).exists) await DNFS.remove(`${ctx.dir}/${p}`, { recursive: true });
    if ((await DNFS.stat(`${path}/${p}`)).exists) await DNFS.copy(`${path}/${p}`, `${ctx.dir}/${p}`); else await DNFS.mkdir(`${ctx.dir}/${p}`);
  }
  const old = await DNFS.readJSON(`${path}/project-config.json`), cur = await ctx.reload();
  await Projects.save({ ...old, name: cur.name, folder: cur.folder, id: cur.id, created: cur.created });
  ctx.log(`Restored snapshot ${path.split('/').pop()}`, 'ok'); UI.toast('Snapshot restored', 'ok');
}

$('snapTbl').onclick = UI.guard(async ev => {
  const b = ev.target.closest('[data-act]'); if (!b) return;
  const path = b.closest('tr').dataset.p;
  if (b.dataset.act === 'cmp') return compare(path);
  if (b.dataset.act === 'restore') { await restore(path); return render(); }
  if (!await UI.confirm(`Delete snapshot ${path.split('/').pop()}? This cannot be undone.`, { danger: true, ok: 'Delete' })) return;
  await DNFS.remove(path, { recursive: true }); ctx.log(`Deleted snapshot ${path.split('/').pop()}`); render();
});

$('arch').onclick = UI.guard(async () => { $('archDlg').showModal(); await render(); });
$('archClose').onclick = () => $('archDlg').close();

(async () => {
  try {
    ctx = await ModulePage.init('update', 'Update');
    await check();
  } catch (e) { UI.toast(e.message, 'err'); }
})();
</script>
</body>
</html>

=== FILE text 8272 8272 42c68af514c2c531f83d17e6a3790214f4713e23182ac0a64d5b42cf98df087c 126 js/core/embed.js
// Global header. Runs first (in <head>) on the Project Manager page and every module page; each opens in its own window.
// Adds the same top bar everywhere: logo with the module's initials, "Data Noodler", module · project,
// Server and Engine status, and a separator line. The page's own logo/title is hidden (theme.css html.embedded),
// so its own header row is left as the page toolbar. No Back buttons.
// Global: GlobalHeader.setInfo(title, project)   (ModulePage calls it once the project is loaded)
(() => {
  const id = location.pathname.split('/').pop().replace(/\.html$/, '');
  const MODS = { project_manager: ['Project Management Module', 'PR'], import: ['Import', 'IM'], pipeline: ['Transform', 'PL'], dashboard: ['Dashboard', 'DA'],
    publish: ['Publish', 'PU'], update: ['Update', 'UP'] };
  const [label, initials] = MODS[id] || [document.title || id, id.slice(0, 2).toUpperCase()];
  document.documentElement.classList.add('embedded');
  const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const G = window.GlobalHeader = {
    setInfo(title, project) {
      if (id === 'import') {
        const el = document.getElementById('gh-sub'); if (el) el.textContent = project ? `Import Module (${project})` : 'Import Module';
        document.title = 'Import'; return;
      }
      const el = document.getElementById('gh-sub'); if (el) el.textContent = project ? `${title} · ${project}` : title;
      document.title = project ? `${title} · ${project}` : id === 'project_manager' ? 'Project Manager' : `${title} · Data Noodler`;
    },
  };

  addEventListener('DOMContentLoaded', () => {
    const h = document.createElement('header');
    h.className = 'topbar gh';
    h.innerHTML = `<div class="brand"><span class="logo">${esc(initials)}</span><div><h1>Data Noodler</h1><div class="sub" id="gh-sub">${esc(label)}</div></div></div>
      <div class="spacer"></div>
      <div class="gh-status"><div class="stat"><label>Web Server (PowerShell)</label><b id="gh-srv" class="wait">CONNECTING</b></div>
      <div class="stat"><label>Data Engine (C#)</label><b id="gh-eng" class="wait" title="Click to re-run the test">TESTING</b></div></div>`;
    document.body.prepend(h);
    G.setInfo(label, null);
    const hdr = () => ({ 'X-DN-Token': window.DN_TOKEN || '', 'Content-Type': 'application/json' });

    async function server() {
      const el = document.getElementById('gh-srv');
      try {
        // 3 s timeout: a request to a stopped server can hang instead of failing.
        const r = await fetch('/api/status', { headers: hdr(), cache: 'no-store', signal: AbortSignal.timeout(3000) });
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        const s = await r.json();
        if (s.theme && window.Theme && s.theme !== Theme.current) Theme.apply(s.theme);   // changed from another window
        el.textContent = 'ONLINE'; el.className = 'on'; el.title = `Port ${s.port}, up ${s.uptime} s`;
        return s.engine !== false;   // false: the site answers but the engine is not ready
      } catch { el.textContent = 'OFFLINE'; el.className = 'off'; el.title = 'The server is not responding.'; return false; }
    }
    async function engine() {
      const el = document.getElementById('gh-eng'); el.textContent = 'TESTING'; el.className = 'wait';
      const t0 = performance.now();
      try {
        const r = await (await fetch('/api/engine/query', { method: 'POST', headers: hdr(), body: JSON.stringify({ sql: 'SELECT sum(range) AS s FROM range(1000000)' }) })).json();
        if (!r.ok || r.rows[0][0] !== 499999500000) throw new Error(r.error || 'wrong answer');
        const s = await (await fetch('/api/engine/status', { headers: hdr(), cache: 'no-store' })).json();
        el.textContent = 'ONLINE'; el.className = 'on';
        el.title = `Native engine ${s.version}: ${s.workers} workers on ${s.cores} cores, memory budget ${(s.memory.budget / 1073741824).toFixed(1)} GB, test ${Math.round(performance.now() - t0)} ms. Click to re-test.`;
      } catch (e) { el.textContent = 'OFFLINE'; el.className = 'off'; el.title = e.message; }
    }
    document.getElementById('gh-eng').onclick = engine;
    // Status every 2 s; when the server comes back, the engine is re-tested too.
    let wasOff = false;
    // Server down = engine down (it runs in the server and stops with it); back up = re-test the engine.
    const poll = async () => {
      const off = !(await server());
      if (off && !wasOff) { const e = document.getElementById('gh-eng'); e.textContent = 'OFFLINE'; e.className = 'off'; e.title = 'The server is stopped.'; }
      if (wasOff && !off) engine();
      wasOff = off;
    };
    poll(); setInterval(poll, 2000); engine();
  });

  // Every activity log (.log): 5 lines, with a Show More / Show Less link above it. Show More grows the log down to
  // 20px above the bottom of the window (at least 5 lines). window.LogMore(el) adds the link to a log created later.
  const fitLog = log => { log.style.height = log.classList.contains('more') ? Math.max(innerHeight - log.getBoundingClientRect().top - 20, 5 * 21) + 'px' : ''; };
  addEventListener('resize', () => document.querySelectorAll('.log.more').forEach(fitLog));
  const logMore = window.LogMore = log => {
    if (log.dataset.more) return; log.dataset.more = '1';
    const a = document.createElement('a'); a.href = '#'; a.className = 'log-more'; a.textContent = 'Show More';
    a.onclick = ev => { ev.preventDefault(); a.textContent = log.classList.toggle('more') ? 'Show Less' : 'Show More'; fitLog(log); };
    const wrap = document.createElement('div'); wrap.className = 'log-more-row'; log.before(wrap); wrap.append(a);
  };
  addEventListener('DOMContentLoaded', () => document.querySelectorAll('.log').forEach(logMore));

  // Mouse wheel, every page: Ctrl + wheel scrolls 4x faster vertically (instead of zooming);
  // Shift + wheel scrolls tables horizontally.
  const scroller = (el, axis) => {
    for (; el && el !== document.documentElement; el = el.parentElement) {
      const cs = getComputedStyle(el), ov = axis === 'y' ? cs.overflowY : cs.overflowX;
      const room = axis === 'y' ? el.scrollHeight > el.clientHeight : el.scrollWidth > el.clientWidth;
      if (room && /auto|scroll/.test(ov)) return el;
    }
    return axis === 'y' ? document.scrollingElement : null;
  };
  addEventListener('wheel', e => {
    if (e.ctrlKey) {
      e.preventDefault();
      scroller(e.target, 'y')?.scrollBy({ top: e.deltaY * 4 });
    } else if (e.shiftKey) {
      const t = e.target.closest?.('.table-wrap'); const el = t && scroller(e.target, 'x');
      if (el) { e.preventDefault(); el.scrollBy({ left: e.deltaY || e.deltaX }); }
    }
  }, { passive: false });

  // Tooltips, every page: title="..." shows a themed, rounded tooltip instead of the browser's square one.
  // While hovered the title moves to data-tip-title (so the native one stays hidden) and comes back on leave.
  let tipEl, tipFor, tipT;
  const tipHide = () => {
    clearTimeout(tipT); if (tipEl) tipEl.style.display = 'none';
    if (tipFor) { if (!tipFor.hasAttribute('title')) tipFor.setAttribute('title', tipFor.dataset.tipTitle); delete tipFor.dataset.tipTitle; tipFor = null; }
  };
  addEventListener('mouseover', e => {
    const el = e.target.closest?.('[title]:not(svg title)');
    if (!el || el === tipFor || !el.getAttribute('title')) return;
    tipHide(); tipFor = el; el.dataset.tipTitle = el.getAttribute('title'); el.removeAttribute('title');
    const x = e.clientX, y = e.clientY;
    tipT = setTimeout(() => {
      if (!tipEl) { tipEl = document.createElement('div'); tipEl.className = 'gtip'; document.body.append(tipEl); }
      tipEl.textContent = el.dataset.tipTitle; tipEl.style.display = 'block';
      const r = tipEl.getBoundingClientRect();
      tipEl.style.left = Math.max(4, Math.min(x + 12, innerWidth - r.width - 4)) + 'px';
      tipEl.style.top = (y + 18 + r.height > innerHeight ? y - r.height - 8 : y + 18) + 'px';
    }, 500);
  });
  addEventListener('mouseout', e => { if (tipFor && !tipFor.contains(e.relatedTarget)) tipHide(); });
  addEventListener('mousedown', tipHide, true);
  addEventListener('scroll', tipHide, true);
})();

=== FILE text 5453 5453 863de27bdcc6bc4dcf39b35fd2a4fa5b0e35d1b78c4562deca77e569d73a1fb9 74 js/core/engine-client.js
// Client for the native C# data engine (runs inside the local server; see .claude/docs/ARCHITECTURE.md). Global: Engine.
// The browser never crunches data: it sends SQL (or a declarative query) and gets compact results back.
//   await Engine.query(sql, { views, limit, workers })   -> { cols, types, rows, rowCount, truncated, ms }
//   await Engine.describe(sql, views)                    -> [{ name, type }]
//   await Engine.count(fromSql, views)                   -> number of rows
//   await Engine.check(sql, views)                       -> [{ pos, end, line, message, code }] syntax / name errors (editor)
//   await Engine.preview(sql, { views, limit, workers }) -> query result + { count }: first rows and the total of a query or
//                                                           script (statements ending in a SELECT), rows and count in parallel
//   await Engine.open(src, table)                        -> { kind, tables, columns, rows, size, modified }  (project path or X:\... / \\server\...)
//   await Engine.write({ sql, views, dest, meta }, onProgress)    -> dataset manifest { path, files, rowCount, bytes, columns, version, ... }
//   await Engine.exportTo({ sql, views, to, format, table }, onProgress) -> { path, rows, bytes, format }
//   await Engine.pipeline(spec, onProgress)              -> { outputs, skipped, order, ms }
//   Engine.src(path, table)  SQL source for a file: read_csv / read_parquet / read_sqlite
//   Engine.views(datasets)   { name: 'SELECT * FROM read_parquet(...)' } for a project's datasets
//   Engine.q(name) / Engine.lit(text)   quote an identifier / a string literal
// Views are named SQL snippets the query can use as tables (datasets, pipeline steps).
const Engine = (() => {
  const KINDS = { csv: 'csv', tsv: 'csv', txt: 'csv', parquet: 'parquet', pq: 'parquet', sqlite: 'sqlite', sqlite3: 'sqlite', db: 'sqlite' };
  const kind = path => KINDS[(String(path).split('.').pop() || '').toLowerCase()] || null;
  const q = s => '"' + String(s).replace(/"/g, '""') + '"';
  const lit = s => "'" + String(s).replace(/'/g, "''") + "'";

  async function call(op, body, method = body === undefined ? 'GET' : 'POST') {
    let r;
    try {
      r = await fetch('/api/engine/' + op, { method, cache: 'no-store', headers: { 'X-DN-Token': window.DN_TOKEN || '', 'Content-Type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });
    } catch (e) { throw new Error('Engine not reachable: is the server running?'); }
    let j;
    try { j = await r.json(); } catch { throw new Error(`Engine: HTTP ${r.status}`); }
    if (!j.ok) { const e = new Error(j.error || `Engine: HTTP ${r.status}`); e.code = j.code; e.status = r.status; throw e; }
    return j;
  }

  const src = (path, table) => {
    const k = kind(path);
    if (k === 'csv') return `read_csv(${lit(path)})`;
    if (k === 'sqlite') return `read_sqlite(${lit(path)}, ${lit(table || '')})`;
    return `read_parquet(${lit(path)})`;   // a .parquet file or a dataset folder
  };
  // A dataset record { path, parts } as SQL: the folder (or legacy single file) holds its own part list.
  const dataset = d => `read_parquet(${lit(d.path)})`;
  const views = (datasets = []) => Object.fromEntries(datasets.map(d => [d.name, `SELECT * FROM ${dataset(d)}`]));

  const query = (sql, { views, limit, workers } = {}) => call('query', { sql, views, limit, workers });
  const describe = async (sql, views) => (await call('describe', { sql, views })).columns;
  const count = async (from, views) => Number((await query(`SELECT count(*) FROM ${from}`, { views })).rows[0][0]);
  const preview = (sql, { views, limit = 100, workers } = {}) => call('preview', { sql, views, limit, workers });
  const check = async (sql, views) => (await call('check', { sql, views })).errors;
  const open = (src, table) => call('open', { src, table });

  // Start a job and poll it until it ends. onProgress(job) gets { state, stage, progress, rowsProcessed, ... }.
  async function job(op, body, onProgress = () => {}) {
    let j = await call(op, body);
    const id = j.jobId;
    for (let wait = 150; ; wait = Math.min(1000, wait * 1.5)) {
      if (j.state === 'done') { onProgress(j); return j.result; }
      if (j.state === 'failed' || j.state === 'cancelled') { const e = new Error(j.error?.message || `Job ${j.state}`); e.code = j.error?.code; throw e; }
      onProgress(j);
      await new Promise(r => setTimeout(r, wait));
      j = await call('job?id=' + encodeURIComponent(id), undefined, 'GET');
    }
  }
  const write = (o, onProgress) => job('write', o, onProgress);
  const exportTo = (o, onProgress) => job('export', o, onProgress);
  const pipeline = (spec, onProgress) => job('pipeline', spec, onProgress);
  const cancel = id => call('job/cancel?id=' + encodeURIComponent(id), {});
  const status = () => call('status');
  const cache = { load: (name, sql, views, workers) => call('cache/load', { name, sql, views, workers }), drop: name => call('cache/drop', { name }) };

  // Columns of a written dataset manifest, in the { name, type } form dataset records use.
  const columnsOf = m => (m.columns || []).map(c => ({ name: c.name, type: c.type }));

  return { kind, q, lit, src, dataset, views, query, describe, count, preview, check, open, job, write, exportTo, pipeline, cancel, status, cache, columnsOf, call };
})();

=== FILE text 2727 2727 81a72bce05de8a6cd127b5c13d8990e05bd6c8cc2be8c3f81f3e07ca72c16bbb 48 js/core/module-page.js
// Common start-up for module pages (import, pipeline, ...). Global: ModulePage.
//   const ctx = await ModulePage.init('import', 'Import Data')
//   ctx = { folder, cfg, dir, log(msg, level), reload() }
// Fills the page header (#title, #sub), reads ?project=<folder>, and writes to the project log.
// The global header (embed.js) shows the module title and project name.
const ModulePage = {
  async init(module, title) {
    const folder = UI.params().project;
    document.title = `${title} · Data Noodler`;
    const set = (id, t) => { const el = document.getElementById(id); if (el) el.textContent = t; };
    set('title', title);
    if (!folder) { set('sub', 'No project selected. Open this module from the Project Manager.'); throw new Error('No project given (?project=<folder>).'); }
    let cfg;
    try { cfg = await Projects.get(folder); }
    catch { set('sub', `Project "${folder}" not found.`); throw new Error(`Project "${folder}" not found.`); }
    set('sub', `${cfg.name} · projects/${folder}`);
    window.GlobalHeader?.setInfo(title, cfg.name);
    const ctx = {
      folder, cfg, module, dir: Projects.dir(folder),
      // Log to the page (#log, if any) and to the project activity log.
      log(msg, level = 'info') {
        const el = document.getElementById('log');
        if (el) {
          const d = document.createElement('div');
          d.className = level === 'error' ? 'err' : level === 'ok' ? 'ok' : level === 'warn' ? 'warn' : '';
          d.innerHTML = `<span class="t">${UI.stamp()}</span>  ${UI.esc(msg)}`;
          el.prepend(d);
        }
        ProjectLog.write(folder, module, msg, level === 'ok' ? 'info' : level === 'warn' ? 'warn' : level);
      },
      // Work in progress: a live line at the top of the log, timer last ("msg… 1.23 s"), ticking every 100 ms.
      // s.set(msg) changes the text; s.done(msg?, level) logs it with the time "(1.23 s)" and removes the live line.
      step(msg) {
        const el = document.getElementById('log'), t0 = performance.now();
        const d = document.createElement('div'); el?.prepend(d);
        const paint = () => { d.innerHTML = `<span class="t">${UI.stamp()}</span>  ${UI.esc(msg)} ${UI.ms(performance.now() - t0)}`; };
        paint(); const tick = setInterval(paint, 100);
        return {
          set(m) { msg = m; paint(); },
          done(m = msg.replace(/…$/, ''), level = 'ok') { clearInterval(tick); d.remove(); ctx.log(`${m} (${UI.ms(performance.now() - t0)})`, level); },
          fail(m) { this.done(m, 'error'); },
        };
      },
      async reload() { ctx.cfg = await Projects.get(folder); return ctx.cfg; },
    };
    return ctx;
  },
};

=== FILE text 2004 2004 7c74e838af96c7160c0076508f6e4fd55c37a1a4b58f3aeb19f2fefb774956ab 41 js/core/project-log.js
// Project activity log: <project>/logs/activity.log, capped at the newest MAX lines (older ones drop off). Global: ProjectLog.
//   await ProjectLog.write('sales-q3', 'import', 'Imported orders.csv: 1,000,000 rows')
//   await ProjectLog.read('sales-q3')   -> lines, newest first (at most MAX)
// Older versions wrote one file per month (activity-YYYY-MM.log); the first write merges those in and removes them.
const ProjectLog = (() => {
  const MAX = 1000;
  const dir = folder => `projects/${folder}/logs`;
  const file = folder => `${dir(folder)}/activity.log`;
  let queue = Promise.resolve(); // serialise appends from the same page

  const monthly = async folder => {
    try { return (await DNFS.list(dir(folder))).filter(f => /^activity-\d{4}-\d{2}\.log$/.test(f.name)).sort((a, b) => a.name.localeCompare(b.name)); }
    catch { return []; }
  };
  const lines = text => text.split('\n').filter(Boolean);

  function write(folder, module, msg, level = 'info') {
    const line = `${new Date().toISOString()}  ${level.toUpperCase().padEnd(5)} ${module.padEnd(9)} ${msg}`;
    queue = queue.then(async () => {
      const p = file(folder);
      let all = (await DNFS.exists(p)) ? lines(await DNFS.readText(p)) : [];   // new project: no file yet
      const old = await monthly(folder);
      if (old.length) {
        const prev = [];
        for (const f of old) prev.push(...lines(await DNFS.readText(f.path)));
        all = prev.concat(all);
      }
      all.push(line);
      await DNFS.writeText(p, all.slice(-MAX).join('\n') + '\n');
      for (const f of old) await DNFS.remove(f.path).catch(() => {});
    }).catch(e => console.warn('ProjectLog:', e.message));
    return queue;
  }
  async function read(folder) {
    const out = [];
    for (const f of await monthly(folder)) out.push(...lines(await DNFS.readText(f.path)));
    try { out.push(...lines(await DNFS.readText(file(folder)))); } catch {}
    return out.slice(-MAX).reverse();
  }
  return { write, read, MAX };
})();

=== FILE text 8104 8104 10404746735504cf99be141423d9467c8125298f75c4ca177167327749eab062 135 js/core/projects.js
// Project CRUD on top of DNFS. Global: Projects.
// A project is a folder under projects/ with the standard layout and a project-config.json.
//   await Projects.list()                       [config...]
//   await Projects.create({ name, owner, ... }) config (folder made from the name)
//   await Projects.update(folder, patch)        config
//   await Projects.rename(folder, newName)      config (folder renamed too)
//   await Projects.trash(folder)                moves it to projects/.trash/
const Projects = (() => {
  const ROOT = 'projects';
  const LAYOUT = ['data/raw', 'data/source', 'data/staged', 'data/cache', 'pipeline', 'dashboard', 'publish', 'archives', 'logs'];
  const MODULES = ['import', 'pipeline', 'dashboard', 'publish', 'update', 'archives'];
  // Option lists: [stored value, label]. The value is also the badge class.
  const PHASE = [['not-started', 'Not Started'], ['planning', 'Planning'], ['development', 'Development'], ['testing', 'Testing'], ['production', 'Production']];
  const STATUS = [0, 25, 50, 75, 100].map(n => [n, n + '%']); // percent complete
  const CLASSIFICATION = [['unclassified', 'UNCLASSIFIED'], ['unnpi', 'UNNPI'], ['cui', 'CUI']];
  const label = (list, v) => (list.find(([k]) => String(k) === String(v)) || [, v ?? ''])[1];
  // Older configs: status was a word (active/complete/planning...), classification public/internal/confidential/restricted.
  const migrate = c => {
    if (typeof c.status !== 'number') {
      const old = String(c.status ?? '');
      if (!c.phase || !PHASE.some(([k]) => k === c.phase)) c.phase = PHASE.some(([k]) => k === old) ? old : old === 'complete' ? 'production' : 'not-started';
      c.status = Number.isFinite(+old) && old !== '' ? +old : old === 'complete' || old === 'production' ? 100 : 0;
    }
    if (c.handling === 'unnpi' && c.classification !== 'cui') c.classification = 'unnpi'; // handling was folded into classification
    delete c.handling;
    if (!CLASSIFICATION.some(([k]) => k === c.classification)) c.classification = ['confidential', 'restricted'].includes(c.classification) ? 'cui' : 'unclassified';
    return c;
  };
  const cfgPath = folder => `${ROOT}/${folder}/project-config.json`;

  // "Sales Q3 2026!" -> "sales-q3-2026"
  const slug = name => name.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);
  const validName = name => {
    if (!name || !name.trim()) return 'A name is required.';
    if (!slug(name)) return 'The name needs at least one letter or digit.';
    return '';
  };
  const id = () => [...crypto.getRandomValues(new Uint8Array(8))].map(b => b.toString(16).padStart(2, '0')).join('');

  async function list() {
    let dirs = [];
    try { dirs = (await DNFS.list(ROOT)).filter(e => e.dir); } catch (e) { if (e.status !== 404) throw e; await DNFS.mkdir(ROOT); }
    const out = [];
    for (const d of dirs) {
      try { out.push(migrate(await DNFS.readJSON(cfgPath(d.name)))); }
      catch { out.push({ folder: d.name, name: d.name, broken: true, status: 'archived', modified: d.modified }); }
    }
    return out;
  }
  const get = async folder => migrate(await DNFS.readJSON(cfgPath(folder)));
  async function save(cfg) { cfg.modified = new Date().toISOString(); await DNFS.writeJSON(cfgPath(cfg.folder), cfg); return cfg; }

  async function create({ name, owner = '', developers = [], updaters = [], description = '', phase = 'not-started', status = 0, classification = 'unclassified', tags = [] }) {
    const err = validName(name); if (err) throw new Error(err);
    const folder = slug(name);
    if (await DNFS.exists(`${ROOT}/${folder}`)) throw new Error(`A project folder "${folder}" already exists.`);
    for (const d of LAYOUT) await DNFS.mkdir(`${ROOT}/${folder}/${d}`);
    const now = new Date().toISOString();
    const cfg = {
      schemaVersion: 1, id: id(), name: name.trim(), folder, description, owner, developers, updaters, phase, status: +status || 0, classification, tags,
      created: now, modified: now,
      modules: Object.fromEntries(MODULES.map(m => [m, { lastRun: null }])),
      datasets: [], settings: {},
    };
    await DNFS.writeJSON(cfgPath(folder), cfg);
    await ProjectLog.write(folder, 'project', `Project created: ${cfg.name}`);
    return cfg;
  }

  async function update(folder, patch) {
    const cfg = await get(folder);
    for (const k of ['name', 'owner', 'developers', 'updaters', 'description', 'phase', 'status', 'classification', 'tags', 'settings', 'datasets', 'modules']) if (k in patch) cfg[k] = patch[k];
    return save(cfg);
  }

  // Rename: new display name, and the folder follows the new name.
  async function rename(folder, name) {
    const err = validName(name); if (err) throw new Error(err);
    const to = slug(name);
    if (to !== folder) {
      if (await DNFS.exists(`${ROOT}/${to}`)) throw new Error(`A project folder "${to}" already exists.`);
      await DNFS.move(`${ROOT}/${folder}`, `${ROOT}/${to}`);
    }
    const cfg = await get(to);
    cfg.name = name.trim(); cfg.folder = to;
    await save(cfg);
    await ProjectLog.write(to, 'project', `Renamed to ${cfg.name}${to !== folder ? ` (folder ${folder} -> ${to})` : ''}`);
    return cfg;
  }

  // Moves the project to projects/.trash/<folder>-<timestamp> (server call: dot-folders are off-limits to DNFS).
  async function trash(folder) {
    const r = await fetch(`/api/project/trash?folder=${encodeURIComponent(folder)}`, { method: 'POST', headers: { 'X-DN-Token': window.DN_TOKEN } });
    const j = await r.json().catch(() => ({}));
    if (!r.ok || j.ok === false) throw new Error(j.error || `Delete failed (${r.status})`);
    return j;
  }

  // Trash (projects/.trash, closed to the file API): list, restore one, empty all.
  async function trashApi(op, q = '') {
    const r = await fetch(`/api/project/trash/${op}${q}`, { method: op === 'list' ? 'GET' : 'POST', headers: { 'X-DN-Token': window.DN_TOKEN } });
    const j = await r.json().catch(() => ({}));
    if (!r.ok || j.ok === false) throw new Error(j.error || `Trash ${op} failed (${r.status})`);
    return j;
  }
  const trashList = async () => (await trashApi('list')).items || [];
  const restore = id => trashApi('restore', `?id=${encodeURIComponent(id)}`);
  const emptyTrash = () => trashApi('empty');

  // Record that a module ran (shown on the Project Manager page).
  async function touchModule(folder, module, info = {}) {
    const cfg = await get(folder);
    cfg.modules ||= {};
    cfg.modules[module] = { ...cfg.modules[module], lastRun: new Date().toISOString(), ...info };
    return save(cfg);
  }

  // Datasets (always Parquet): { name, path, parts?, stage, direct?, rows, columns: [{ name, type }], source, imported }
  //   stage 'staged' = data/staged (Import > Stage; input for Pipeline)
  //   stage 'source' = data/source (Import > Import Directly, or Pipeline output; ready for Dashboard)
  //   path = dataset folder (part-NNNNNN.parquet + dataset.json, written by the engine); parts = its part files.
  //   version = dataset.json version (bumped on every rewrite). Older records may point at a single .parquet file.
  async function upsertDataset(folder, ds) {
    const cfg = await get(folder);
    cfg.datasets ||= [];
    const i = cfg.datasets.findIndex(d => d.name === ds.name);
    if (i >= 0) cfg.datasets[i] = { ...cfg.datasets[i], ...ds }; else cfg.datasets.push(ds);
    return save(cfg);
  }
  const dir = folder => `${ROOT}/${folder}`;
  // 'staged' | 'source' (older records have no stage: taken from the path; pipeline outputs are 'source').
  const stageOf = d => d.stage || (d.source?.kind !== 'pipeline' && d.path.includes('/data/staged/') ? 'staged' : 'source');

  return { ROOT, LAYOUT, MODULES, PHASE, STATUS, CLASSIFICATION, label, slug, validName, list, get, save, create, update, rename, trash, trashList, restore, emptyTrash, touchModule, upsertDataset, dir, stageOf };
})();

=== FILE text 1678 1678 d1b5f342219cf9d56b4b7951eb104f482db4c07b88421b2674d922a664238c69 25 js/core/theme.js
// Light / dark mode for every page. Global: Theme. Load in <head> (before the page paints).
//   Theme.apply('light')   sets the mode here (and in pages loaded in this window's frames)
// The mode is chosen in the server panel (Settings > Appearance) and saved in settings.json (default dark).
// The app shell picks it up from /api/status; localStorage only avoids a flash on load and syncs other
// windows of this site instantly (storage event).
const Theme = (() => {
  const KEY = 'dn-theme';
  const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
  function apply(t) {
    t = t === 'light' ? 'light' : 'dark';
    document.documentElement.dataset.theme = t;
    try { if (localStorage.getItem(KEY) !== t) localStorage.setItem(KEY, t); } catch {}
    for (const f of document.querySelectorAll('iframe')) { try { f.contentDocument.documentElement.dataset.theme = t; } catch {} }
    return t;
  }
  apply(read() || 'dark');
  addEventListener('storage', e => { if (e.key === KEY && e.newValue) apply(e.newValue); });
  // The server panel runs on its own origin (no shared localStorage): ask the site for the mode every second, so a
  // change in Settings > Appearance reaches every open window right away.
  async function poll() {
    try { const r = await fetch('/api/theme', { cache: 'no-store' }); if (r.ok) { const s = await r.json(); if (s.theme && s.theme !== (document.documentElement.dataset.theme || 'dark')) apply(s.theme); } } catch {}
  }
  if (/^https?:$/.test(location.protocol)) { poll(); setInterval(poll, 1000); }
  return { apply, get current() { return document.documentElement.dataset.theme || 'dark'; } };
})();

=== FILE text 8426 8426 699636e2971b1bdf53d20cef9e8449a469e99159b5c68d882f751fa4a5e3fe30 119 js/core/ui.js
// Shared UI helpers. Global: UI.
//   UI.toast('Saved', 'ok')                      bottom-right message (kind: '', 'ok', 'err')
//   await UI.confirm('Delete?', { danger: true }) true / false (styled dialog; the browser's confirm() is not used)
//   await UI.form('New project', fields)         { values } or null; fields = [{ name, label, type, value, options, required }]
//   UI.dataTable(el, cols, rows)                 query results as a table
const UI = (() => {
  const $ = id => document.getElementById(id);
  const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  let toasts;
  function toast(msg, kind = '', ms = 3500) {
    toasts ||= document.body.appendChild(Object.assign(document.createElement('div'), { className: 'toasts' }));
    const t = Object.assign(document.createElement('div'), { className: `toast ${kind}`, textContent: msg });
    toasts.append(t);
    setTimeout(() => t.remove(), kind === 'err' ? ms * 2 : ms);
  }

  // A modal <dialog>. body = HTML string; buttons = [{ label, value, kind }]. Resolves with the clicked value (null on Esc).
  function dialog(title, body, buttons) {
    return new Promise(res => {
      const d = document.createElement('dialog');
      d.innerHTML = `<header>${esc(title)}</header><form method="dialog"><div class="body">${body}</div><footer>${
        buttons.map((b, i) => `<button value="${i}" class="${b.kind || ''}" ${b.submit ? '' : 'formnovalidate'}>${esc(b.label)}</button>`).join('')}</footer></form>`;
      document.body.append(d);
      const form = d.querySelector('form');
      // Handle the submit itself (the dialog 'close' event is not reliable in every embedded browser).
      let done = false;
      const finish = i => {
        if (done) return; done = true;
        const b = buttons[+i];
        const out = b ? (typeof b.value === 'function' ? b.value(form) : b.value) : null;
        if (d.open) d.close();
        d.remove(); res(out);
      };
      form.addEventListener('submit', ev => { ev.preventDefault(); finish(ev.submitter?.value); });
      d.addEventListener('cancel', ev => { ev.preventDefault(); finish(null); });
      d.addEventListener('keydown', ev => { if (ev.key === 'Escape') { ev.preventDefault(); finish(null); } });
      if (typeof UserPicker !== 'undefined') UserPicker.bind(d);
      d.showModal();
      d.querySelector('input, select, textarea')?.focus();
    });
  }
  const confirm = (msg, { danger = false, ok = 'OK' } = {}) =>
    dialog('Confirm', `<div>${esc(msg)}</div>`, [{ label: 'Cancel', value: false, kind: 'ghost' }, { label: ok, value: true, kind: danger ? 'danger' : '' }]);
  const alert = (title, msg) => dialog(title, `<div>${esc(msg)}</div>`, [{ label: 'OK', value: true }]);

  function fieldHtml(f) {
    const v = esc(f.value ?? ''), req = f.required ? 'required' : '';
    if (f.type === 'user' || f.type === 'users') return UserPicker.html({ ...f, multi: f.type === 'users' });
    if (f.type === 'select') return `<label class="field">${esc(f.label)}<select name="${f.name}">${f.options.map(o => { const [val, lab] = Array.isArray(o) ? o : [o, o]; return `<option value="${esc(val)}" ${String(val) === String(f.value) ? 'selected' : ''}>${esc(lab)}</option>`; }).join('')}</select></label>`;
    if (f.type === 'textarea') return `<label class="field">${esc(f.label)}<textarea name="${f.name}" ${req}>${v}</textarea></label>`;
    return `<label class="field">${esc(f.label)}<input name="${f.name}" type="${f.type || 'text'}" value="${v}" ${req} ${f.pattern ? `pattern="${f.pattern}"` : ''} placeholder="${esc(f.placeholder || '')}"></label>`;
  }
  // Form dialog: resolves { name: value, ... } or null when cancelled.
  const form = (title, fields, { ok = 'Save' } = {}) => dialog(title, fields.map(fieldHtml).join(''), [
    { label: 'Cancel', value: null, kind: 'ghost' },
    { label: ok, submit: true, kind: /^save/i.test(ok) ? 'go' : '', value: f => Object.fromEntries(new FormData(f)) },
  ]);

  // ---- formatting ----
  const num = v => v == null ? '' : Number(v).toLocaleString();
  const bytes = b => b >= 1073741824 ? (b / 1073741824).toFixed(2) + ' GB' : b >= 1048576 ? (b / 1048576).toFixed(1) + ' MB' : b >= 1024 ? Math.round(b / 1024) + ' KB' : (b || 0) + ' B';
  const ms = v => (v / 1000).toFixed(1) + ' s';   // every timer: seconds, 1 decimal
  const date = iso => iso ? new Date(iso).toLocaleString(undefined, { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
  const rows = n => n >= 1e9 ? +(n / 1e9).toFixed(2) + 'B' : n >= 1e6 ? +(n / 1e6).toFixed(2) + 'M' : n >= 1e3 ? +(n / 1e3).toFixed(1) + 'k' : String(n);

  // Query results as an HTML table. rows = arrays of plain values.
  function dataTable(el, cols, data, { max = 500 } = {}) {
    el.innerHTML = `<div class="table-wrap"><table class="grid data"><thead><tr>${cols.map(c => `<th>${esc(c)}</th>`).join('')}</tr></thead><tbody>${
      data.slice(0, max).map(r => `<tr>${r.map(v => v == null ? '<td class="null">null</td>' : `<td>${esc(v)}</td>`).join('')}</tr>`).join('')}</tbody></table></div>` +
      (data.length > max ? `<div class="muted" style="margin-top:4px">Showing ${max} of ${num(data.length)} rows.</div>` : '');
  }

  // Wrap an async handler: errors become a red toast instead of a silent failure.
  const guard = fn => async (...a) => { try { return await fn(...a); } catch (e) { console.error(e); toast(e.message || String(e), 'err'); } };
  const debounce = (fn, wait = 200) => { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), wait); }; };
  // Log time stamp: yyyy-mm-dd hh:mm:ss, 24 h, local time.
  const stamp = (d = new Date()) => { const p = n => String(n).padStart(2, '0'); return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`; };
  const params = () => Object.fromEntries(new URLSearchParams(location.search));

  // Table scrollbars stay hidden until the mouse is within 10px of one. The vertical one is drawn
  // as an overlay thumb (native bar has zero width) so it sits over the rows, below the sticky header.
  function vthumb(w) {
    let t = w.querySelector(':scope > .vthumb');
    if (!t) {
      t = w.appendChild(Object.assign(document.createElement('div'), { className: 'vthumb' }));
      w.addEventListener('scroll', () => placeThumb(w), { passive: true });
      t.addEventListener('mousedown', e => {
        e.preventDefault(); t.classList.add('drag');
        const y0 = e.clientY, s0 = w.scrollTop, g = w._thumb;
        const move = ev => { w.scrollTop = s0 + (ev.clientY - y0) * (w.scrollHeight - w.clientHeight) / Math.max(1, g.track - g.h); };
        const up = () => { t.classList.remove('drag'); removeEventListener('mousemove', move); removeEventListener('mouseup', up); };
        addEventListener('mousemove', move); addEventListener('mouseup', up);
      });
    }
    return t;
  }
  function placeThumb(w) {
    const t = vthumb(w), over = w.scrollHeight > w.clientHeight;
    t.hidden = !over; if (!over) return;
    const head = w.querySelector('thead')?.offsetHeight || 0, track = w.clientHeight - head - 4;
    const h = Math.max(24, track * w.clientHeight / w.scrollHeight);
    const top = head + 2 + (track - h) * w.scrollTop / (w.scrollHeight - w.clientHeight);
    w._thumb = { track, h };
    Object.assign(t.style, { height: h + 'px', top: w.scrollTop + top + 'px', left: w.scrollLeft + w.clientWidth - 8 + 'px' });
  }
  document.addEventListener('mousemove', e => {
    for (const w of document.querySelectorAll('.table-wrap')) {
      placeThumb(w);
      const r = w.getBoundingClientRect(), sb = 10;
      const inY = e.clientY >= r.top - sb && e.clientY <= r.bottom + sb, inX = e.clientX >= r.left - sb && e.clientX <= r.right + sb;
      const nearV = w.scrollHeight > w.clientHeight && inY && Math.abs(r.right - 4 - e.clientX) <= sb + 4;
      const nearH = w.scrollWidth > w.clientWidth && inX && Math.abs(r.bottom - 5 - e.clientY) <= sb + 5;
      w.classList.toggle('near', nearV || nearH);
    }
  }, { passive: true });

  return { $, esc, stamp, toast, dialog, confirm, alert, form, num, bytes, ms, date, rows, dataTable, guard, debounce, params };
})();

=== FILE text 5617 5617 e83701d446908213d529f8d20d5cea43053130dce1acde6d7a822f37c3e3c949 75 js/core/user-picker.js
// User drop-downs fed by config/users.json (edited in the server panel's User Access dialog). Global: UserPicker.
//   await UserPicker.load()                       fetch the user list (call before building a form)
//   UserPicker.html({ name, label, value, multi }) field HTML; single -> hidden input = display name,
//                                                  multi -> hidden input = JSON array of display names
//   UserPicker.bind(rootEl)                       wire every picker inside rootEl (UI.dialog calls this)
//   UserPicker.parse(v)                           JSON array string -> array
const UserPicker = (() => {
  let users = [];
  const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  // Same format as the server panel: "Last, First M. TYPE" (type omitted for N/A).
  const display = u => u.last ? `${u.last}, ${u.first || ''}${u.middle ? ' ' + u.middle.toUpperCase() + '.' : ''}${u.type && u.type.toUpperCase() !== 'N/A' ? ' ' + u.type.toUpperCase() : ''}` : u.display;
  const names = () => users.map(display).filter(Boolean).sort((a, b) => a.localeCompare(b));

  async function load() {
    try { const r = await fetch('/config/users.json', { cache: 'no-store' }); users = r.ok ? await r.json() : []; }
    catch { users = []; }
    return names();
  }
  const parse = v => { try { const a = JSON.parse(v || '[]'); return Array.isArray(a) ? a : []; } catch { return []; } };

  // A + before the label that drops the searchable list; picked names show as removable chips below.
  function html(f) {
    const v = f.multi ? JSON.stringify(Array.isArray(f.value) ? f.value : parse(f.value)) : (f.value || '');
    return `<div class="field upick${f.multi ? ' multi' : ''}" data-name="${f.name}">
      <div class="uhead"><div class="ubox"><button type="button" class="uopen uplus" title="${f.multi ? `Add to ${esc(f.label)}` : `Choose the ${esc(f.label).toLowerCase()}`}"><svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>${menu()}</div>${esc(f.label)}</div>
      <input type="hidden" name="${f.name}" value="${esc(v)}">
      <div class="chips"></div></div>`;
  }
  const menu = () => `<div class="umenu" hidden><input type="search" class="uq" placeholder="Search users"><div class="uitems"></div></div>`;

  function bind(root) {
    root.querySelectorAll('.upick').forEach(el => {
      const hidden = el.querySelector('input[type=hidden]'), multi = el.classList.contains('multi');
      const m = el.querySelector('.umenu'), q = el.querySelector('.uq'), items = el.querySelector('.uitems');
      const chosen = () => multi ? parse(hidden.value) : [hidden.value].filter(Boolean);
      const show = () => {
        el.querySelector('.chips').innerHTML = [...chosen()].sort((a, b) => a.localeCompare(b)).map(n => `<span class="chip">${esc(n)}<button type="button" data-rm="${esc(n)}" title="Remove">✕</button></span>`).join('');
      };
      const fill = () => {
        const s = q.value.trim().toLowerCase(), have = chosen();
        const list = names().filter(n => n.toLowerCase().includes(s) && !(multi && have.includes(n)));
        items.innerHTML = list.map(n => `<div class="${!multi && n === hidden.value ? 'sel' : ''}" data-n="${esc(n)}">${esc(n)}</div>`).join('')
          || `<div class="muted empty">${users.length ? 'No match' : 'No users. Add them in the server panel (User Access).'}</div>`;
      };
      const close = () => { m.hidden = true; };
      el.querySelector('.uopen').onclick = () => { if (!m.hidden) return close(); root.querySelectorAll('.umenu').forEach(x => x.hidden = true); m.hidden = false; q.value = ''; fill(); q.focus(); };
      q.oninput = fill;
      q.onkeydown = ev => {
        if (ev.key === 'Escape') { ev.preventDefault(); ev.stopPropagation(); close(); }
        if (ev.key === 'Enter') { ev.preventDefault(); items.querySelector('[data-n]')?.click(); }
      };
      // Keep focus in the search box while picking, so the focus-outside check doesn't close the menu first.
      items.onmousedown = ev => ev.preventDefault();
      items.onclick = ev => {
        const n = ev.target.closest('[data-n]')?.dataset.n; if (!n) return;
        hidden.value = multi ? JSON.stringify([...chosen(), n].sort((a, b) => a.localeCompare(b))) : n;
        close(); show();
      };
      el.querySelector('.chips').onclick = ev => {
        const n = ev.target.closest('[data-rm]')?.dataset.rm; if (n == null) return;
        hidden.value = multi ? JSON.stringify(chosen().filter(x => x !== n)) : ''; show();
      };
      // Clicks anywhere outside close it (backdrop too); focus moving to another field closes it,
      // but focus landing on the dialog itself (a click on plain space) is handled by the click.
      const outside = ev => { if (!m.hidden && !el.contains(ev.target)) close(); };
      const focusOut = ev => { if (!m.hidden && !el.contains(ev.target) && ev.target !== root) close(); };
      document.addEventListener('pointerdown', outside, true);
      document.addEventListener('focusin', focusOut, true);
      new MutationObserver((_, o) => { if (!root.isConnected) { document.removeEventListener('pointerdown', outside, true); document.removeEventListener('focusin', focusOut, true); o.disconnect(); } })
        .observe(document.body, { childList: true });
      show();
    });
  }
  return { load, html, bind, parse, names };
})();

=== FILE text 1611 1611 39bb963c6872eff125edb9e2a7a71f344e0f906229697005b2442fd4e32c4185 27 js/core/windows.js
// Module navigation. Global: Windows.
// Every module opens in its own window, 95% of the screen height at 16:10, centred (one window per module + project).
// initials = the global header logo for that module (js/core/embed.js).
const Windows = (() => {
  const MODULES = [
    { id: 'import', label: 'Import', page: 'import.html', initials: 'IM', enabled: true },
    { id: 'pipeline', label: 'Transform', page: 'transform.html', initials: 'PL', enabled: true },
    { id: 'dashboard', label: 'Dashboard', page: 'dashboard.html', initials: 'DA', enabled: true },
    { id: 'publish', label: 'Publish', page: 'publish.html', initials: 'PU', enabled: true },
    { id: 'update', label: 'Update', page: 'update.html', initials: 'UP', enabled: true },
  ];
  // Window features: 95% of the available height, 16:10 width (capped to the screen), centred.
  function features() {
    const H = Math.round(screen.availHeight * 0.95), W = Math.min(Math.round(H * 1.6), screen.availWidth);
    const L = (screen.availLeft || 0) + Math.round((screen.availWidth - W) / 2), T = (screen.availTop || 0) + Math.round((screen.availHeight - H) / 2);
    return `popup=yes,width=${W},height=${H},left=${L},top=${T}`;
  }
  function open(moduleId, folder) {
    const m = MODULES.find(x => x.id === moduleId);
    if (!m?.enabled) return false;
    const url = m.global ? `/html/${m.page}` : `/html/${m.page}?${new URLSearchParams({ project: folder })}`;
    const w = window.open(url, m.global ? `dn-${moduleId}` : `dn-${moduleId}-${folder}`, features());
    w?.focus();
    return true;
  }
  return { MODULES, open };
})();

=== FILE text 3436 3436 2e5a7e1b4be9c2c496754b930adb5062786ab43b1dd631963be4c6975ded8d86 55 js/dn-fs.js
// Project file access through the Data Noodler server (.server/server.ps1).
// All paths are relative to the project root, e.g. 'test-data/sales_1k.csv'.
// Nothing outside the project root (or inside dot-folders) is reachable.
//
//   const csv = await DNFS.readText('test-data/sales_1k.csv');
//   await DNFS.writeText('output/summary.json', JSON.stringify(data));
//   await DNFS.upload(fileFromInput, 'test-data');
const DNFS = (() => {
  async function call(op, params = {}, init = {}) {
    if (!window.DN_TOKEN) throw new Error('DNFS: page was not served by the Data Noodler server.');
    const qs = new URLSearchParams(Object.entries(params).filter(([, v]) => v !== undefined));
    const r = await fetch(`/api/fs/${op}?${qs}`, { ...init, headers: { 'X-DN-Token': window.DN_TOKEN, ...init.headers } });
    if (!r.ok) {
      let msg = r.statusText;
      try { msg = (await r.json()).error || msg; } catch {}
      const e = new Error(`DNFS ${op}: ${msg}`); e.status = r.status; throw e;
    }
    return r;
  }
  const json = async p => (await p).json();
  // Writes from one page go one at a time: the server handles writes one by one anyway, and many large
  // uploads at once can exhaust the page's memory.
  let writeQueue = Promise.resolve();
  const queued = fn => { const p = writeQueue.then(fn, fn); writeQueue = p.catch(() => {}); return p; };

  return {
    // [{ name, path, dir, size, modified }]
    list: async (path = '', { recursive = false } = {}) =>
      (await json(call('list', { path, recursive: recursive ? 1 : undefined }))).entries,
    stat: path => json(call('stat', { path })),
    exists: async path => (await json(call('stat', { path }))).exists,

    read: path => call('read', { path }),                          // raw Response (stream it for big files)
    readText: async path => (await call('read', { path })).text(),
    readJSON: async path => (await call('read', { path })).json(),
    readBuffer: async path => (await call('read', { path })).arrayBuffer(),
    // Optional file (may not exist yet, e.g. a new project): fallback instead of a 404 in the server log.
    readJSONOr: async (path, fallback) => (await DNFS.exists(path)) ? (await call('read', { path })).json() : fallback,

    // data: string, Blob/File, ArrayBuffer or typed array. Creates folders as needed.
    write: (path, data, { overwrite = true } = {}) =>
      queued(() => json(call('write', { path, overwrite: overwrite ? undefined : 0 }, { method: 'PUT', body: data }))),
    writeText: (path, text, opts) => DNFS.write(path, text, opts),
    writeJSON: (path, obj, opts) => DNFS.write(path, JSON.stringify(obj, null, 2), opts),

    // Copies a user-picked File (from <input type=file> or drag/drop) into a project folder.
    upload: (file, folder = '', opts) => DNFS.write(folder ? `${folder.replace(/\/+$/, '')}/${file.name}` : file.name, file, opts),

    mkdir: path => json(call('mkdir', { path }, { method: 'POST' })),
    remove: (path, { recursive = false } = {}) => json(call('delete', { path, recursive: recursive ? 1 : undefined }, { method: 'DELETE' })),
    move: (from, to, { overwrite = false } = {}) => json(call('move', { from, to, overwrite: overwrite ? 1 : undefined }, { method: 'POST' })),
    // Copies a file or a whole folder.
    copy: (from, to, { overwrite = false } = {}) => json(call('copy', { from, to, overwrite: overwrite ? 1 : undefined }, { method: 'POST' })),
  };
})();

=== FILE text 4967 4967 722b7818924d7415cc8b3ba7a3ab6f438f6a98e7347ea536ece430ba7797312b 75 js/import/external-source.js
// Source files OUTSIDE the project (local or network drives), through the server's import API.
// Global: ExternalSource. Needs dn-fs.js (window.DN_TOKEN).
//   const info = await ExternalSource.probe('\\\\server\\share\\orders.csv')   { size, modified }  (throws a plain-English error)
//   ExternalSource.url(src)                       URL DuckDB can read in place (range reads, token in the query)
//   await ExternalSource.copy(src, 'projects/x/temp/orders.csv', (done, total) => …)   copies into the project
//   ExternalSource.drive(src)                     'X:' or '\\server\share'
//   await ExternalSource.verify(E, aSql, bSql, { values })   compares two sources: columns, types, rows, values
// The server gives up on a drive after 30 s without progress; this side warns the user after 10 s (onWait).
const ExternalSource = (() => {
  const WARN_MS = 10000;
  const isPath = s => /^[A-Za-z]:\\/.test(s) || /^\\\\[^\\]+\\[^\\]+\\/.test(s);
  const drive = s => (s.match(/^\\\\[^\\]+\\[^\\]+/) || s.match(/^[A-Za-z]:/) || [s])[0];
  const name = s => s.split(/[\\/]/).pop();
  const qs = p => new URLSearchParams(p).toString();

  // Calls the import API; after WARN_MS without an answer, onWait(drive) is called once.
  async function call(op, params, { method = 'GET', onWait } = {}) {
    if (!window.DN_TOKEN) throw new Error('Page was not served by the Data Noodler server.');
    const t = onWait && setTimeout(() => onWait(drive(params.src)), WARN_MS);
    try {
      const r = await fetch(`/api/import/${op}?${qs(params)}`, { method, headers: { 'X-DN-Token': window.DN_TOKEN } });
      let j = {}; try { j = await r.json(); } catch {}
      if (!r.ok || j.ok === false) { const e = new Error(j.error || `${op} failed (HTTP ${r.status})`); e.status = r.status; e.drive = j.drive; throw e; }
      return j;
    } finally { clearTimeout(t); }
  }

  const probe = (src, opts) => call('probe', { src }, opts);
  const url = src => `${location.origin}/api/import/read?${qs({ src, t: window.DN_TOKEN })}`;

  // Copies src into the project at `to` (project-relative). onProgress(done, total) about twice a second.
  // onWait(drive) if no progress for 10 s.
  async function copy(src, to, onProgress = () => {}, { onWait, overwrite = true } = {}) {
    const id = 'imp' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
    let last = -1, lastAt = Date.now(), warned = false;
    const poll = setInterval(async () => {
      try {
        const p = await call('progress', { id });
        if (p.done !== last) { last = p.done; lastAt = Date.now(); onProgress(p.done, p.total); }
        else if (!warned && onWait && Date.now() - lastAt > WARN_MS) { warned = true; onWait(drive(src)); }
      } catch {}
    }, 500);
    try { return await call('copy', { src, to, id, overwrite: overwrite ? 1 : 0 }, { method: 'POST', onWait }); }
    finally { clearInterval(poll); }
  }

  // Compares two SQL sources (e.g. read_parquet(...)). values = also compare every column's contents
  // (order-independent hash per column). Returns { ok, checks: [{ name, ok, detail }] }.
  async function verify(E, aSql, bSql, { values = true, types = true } = {}) {
    const desc = async s => (await E.query(`DESCRIBE SELECT * FROM ${s}`)).rows.map(r => ({ name: r[0], type: r[1] }));
    const [ca, cb] = await Promise.all([desc(aSql), desc(bSql)]);
    const checks = [];
    const add = (name, ok, detail) => checks.push({ name, ok, detail });
    add('Column count', ca.length === cb.length, `${ca.length} vs ${cb.length}`);
    const nameDiff = ca.findIndex((c, i) => c.name !== cb[i]?.name);
    add('Column names and order', nameDiff < 0 && ca.length === cb.length, nameDiff < 0 ? 'match' : `first difference at #${nameDiff + 1}: "${ca[nameDiff]?.name}" vs "${cb[nameDiff]?.name}"`);
    if (types) {
      const typeDiff = ca.findIndex((c, i) => c.type !== cb[i]?.type);
      add('Column types', typeDiff < 0, typeDiff < 0 ? 'match' : `"${ca[typeDiff].name}": ${ca[typeDiff].type} vs ${cb[typeDiff]?.type}`);
    }
    const count = async s => Number((await E.query(`SELECT count(*) FROM ${s}`)).rows[0][0]);
    const [na, nb] = [await count(aSql), await count(bSql)];
    add('Row count', na === nb, `${na.toLocaleString()} vs ${nb.toLocaleString()}`);
    if (values && nameDiff < 0 && na === nb) {
      // One streaming pass per file: XOR of row hashes per column (no rows kept in memory).
      const sums = async s => (await E.query(`SELECT bit_xor(hash(COLUMNS(*)))::VARCHAR FROM ${s}`)).rows[0];
      const [ha, hb] = [await sums(aSql), await sums(bSql)];
      const bad = ca.filter((c, i) => ha[i] !== hb[i]).map(c => c.name);
      add('Values', !bad.length, bad.length ? `differ in: ${bad.slice(0, 5).join(', ')}${bad.length > 5 ? ` (+${bad.length - 5} more)` : ''}` : 'match');
    }
    return { ok: checks.every(c => c.ok), checks, rows: na, columns: ca };
  }

  return { isPath, drive, name, probe, url, copy, verify };
})();

=== FILE text 5563 5563 cf073c33b0d0650d00a53375ea9419fc6efbd8645e81f58ff6798823ca147143 87 js/mem-monitor.js
// Live memory graph. Global: MemMonitor. Polls /api/mem (server process = the native engine, browser, system).
//   const m = MemMonitor.mount(el, { everyMs: 250, windowSec: 120 })
//   m.setLimit(bytes, 'Engine budget')              dashed limit line (null to hide)
//   m.mark('12 workers: Sort')                      labelled marker at the current time
//   m.resetPeak()
// Lines: the engine (server process, where all queries run), whole browser, system RAM in use.
const MemMonitor = (() => {
  const GB = 2 ** 30;
  const fmt = b => b >= GB ? (b / GB).toFixed(2) + ' GB' : Math.round(b / 2 ** 20) + ' MB';
  const css = (el, v, d) => getComputedStyle(el).getPropertyValue(v).trim() || d;

  function mount(el, { everyMs = 250, windowSec = 120 } = {}) {
    el.innerHTML = `<div class="legend"><span><i style="background:var(--s1)"></i>Engine (server) <b data-v="tab">-</b></span>
      <span><i style="background:var(--s3)"></i>Browser <b data-v="browser">-</b></span>
      <span><i style="background:var(--s4)"></i>System in use <b data-v="sys">-</b></span>
      <span><i style="background:var(--err)"></i><span data-v="limitLbl">Limit</span> <b data-v="limit">-</b></span>
      <span>Peak engine <b data-v="peak">-</b></span><span class="off" data-v="src"></span></div>
      <canvas style="width:100%;height:220px;display:block"></canvas>`;
    const cv = el.querySelector('canvas'), ctx = cv.getContext('2d'), V = k => el.querySelector(`[data-v="${k}"]`);
    const max = Math.ceil(windowSec * 1000 / everyMs);
    let samples = [], marks = [], limit = null, peak = 0, busy = false, sysTotal = 0, timer;

    async function poll() {
      if (busy) return; busy = true;
      try {
        const r = await fetch('/api/mem', { headers: { 'X-DN-Token': window.DN_TOKEN }, cache: 'no-store' });
        if (!r.ok) throw new Error(r.status);
        const j = await r.json();
        const eng = j.engine ?? j.tab;
        sysTotal = j.sysTotal; peak = Math.max(peak, eng);
        samples.push({ t: performance.now(), tab: eng, browser: j.browser, sys: j.sysTotal - j.sysFree });
        if (samples.length > max) samples.shift();
        V('tab').textContent = fmt(eng); V('browser').textContent = fmt(j.browser);
        V('sys').textContent = `${fmt(j.sysTotal - j.sysFree)} / ${fmt(j.sysTotal)}`; V('peak').textContent = fmt(peak);
        V('src').textContent = `(${j.source})`;
      } catch { V('src').textContent = '(no data: is the server running?)'; }
      finally { busy = false; draw(); }
    }

    function draw() {
      const w = cv.clientWidth, h = cv.clientHeight, dpr = devicePixelRatio || 1;
      if (cv.width !== w * dpr) { cv.width = w * dpr; cv.height = h * dpr; }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, w, h);
      const L = 56, R = 8, T = 8, B = 18, pw = w - L - R, ph = h - T - B;
      const now = performance.now(), t0 = now - windowSec * 1000;
      const top = Math.max(GB, limit || 0, ...samples.map(s => Math.max(s.tab, s.browser, s.sys))) * 1.1;
      const x = t => L + (t - t0) / (windowSec * 1000) * pw, y = b => T + ph - b / top * ph;
      const grid = css(el, '--border', '#444'), txt = css(el, '--text-2', '#aaa');
      ctx.font = '11px "Exo 2", system-ui'; ctx.lineWidth = 1;
      const step = top > 16 * GB ? 4 * GB : top > 6 * GB ? 2 * GB : top > 2 * GB ? GB : GB / 4;
      for (let b = 0; b <= top; b += step) {
        ctx.strokeStyle = grid; ctx.beginPath(); ctx.moveTo(L, y(b)); ctx.lineTo(w - R, y(b)); ctx.stroke();
        ctx.fillStyle = txt; ctx.textAlign = 'right'; ctx.fillText(fmt(b), L - 6, y(b) + 4);
      }
      ctx.textAlign = 'left'; ctx.fillText(`last ${windowSec} s`, L, h - 4);
      let lastX = -1e9; // labels only where there is room
      for (const m of marks.filter(m => m.t > t0)) {
        ctx.strokeStyle = grid; ctx.setLineDash([2, 3]); ctx.beginPath(); ctx.moveTo(x(m.t), T); ctx.lineTo(x(m.t), T + ph); ctx.stroke();
        ctx.setLineDash([]);
        if (x(m.t) - lastX > ctx.measureText(m.text).width + 8) { ctx.fillStyle = txt; ctx.fillText(m.text, x(m.t) + 3, T + 11); lastX = x(m.t); }
      }
      if (!samples.length) { ctx.fillStyle = txt; ctx.textAlign = 'center'; ctx.fillText('Waiting for memory data: restart the server to enable /api/mem', L + pw / 2, T + ph / 2); ctx.textAlign = 'left'; }
      if (limit) {
        ctx.strokeStyle = css(el, '--err', '#f66'); ctx.setLineDash([6, 4]);
        ctx.beginPath(); ctx.moveTo(L, y(limit)); ctx.lineTo(w - R, y(limit)); ctx.stroke(); ctx.setLineDash([]);
      }
      for (const [k, c] of [['sys', '--s4'], ['browser', '--s3'], ['tab', '--s1']]) {
        ctx.strokeStyle = css(el, c, '#39f'); ctx.lineWidth = k === 'tab' ? 2 : 1.5; ctx.beginPath();
        samples.filter(s => s.t >= t0).forEach((s, i) => i ? ctx.lineTo(x(s.t), y(s[k])) : ctx.moveTo(x(s.t), y(s[k])));
        ctx.stroke();
      }
      ctx.lineWidth = 1;
    }

    timer = setInterval(poll, everyMs); poll();
    addEventListener('resize', draw);
    return {
      setLimit(bytes, label = 'Limit') { limit = bytes || null; V('limit').textContent = limit ? fmt(limit) : '-'; V('limitLbl').textContent = label; draw(); },
      mark(text) { marks.push({ t: performance.now(), text }); if (marks.length > 200) marks.shift(); },
      resetPeak() { peak = 0; },
      get peak() { return peak; },
      get sysTotal() { return sysTotal; },
      stop() { clearInterval(timer); },
    };
  }
  return { mount, fmt };
})();

=== FILE text 4960 4960 450dbf69846c2eca9f215aff9a9d0c7ea0144ba3a3776df05cce2480817e4b0b 65 js/pipeline/runner.js
// Runs a project's transform on the native engine. Global: PipelineRunner. Needs projects.js, engine-client.js.
// pipeline/pipeline.json = { version: 2, queries: [{ id, name, sql }], active: id, output: 'CLEAN_...', rev, updated }.
// Each query is a SQL script (one SELECT, or statements ending in a SELECT; see engine/Core/Script.cs). The active query
// builds the output dataset.
//   await PipelineRunner.load(ctx)                   pipeline.json (older step lists are converted)
//   await PipelineRunner.views(ctx)                  the project's datasets as engine views { name: sql }
//   PipelineRunner.active(pipe)                      the active query, or undefined
//   await PipelineRunner.run(ctx, pipe, log, changed, onJob)   writes the active query's result to data/source/<output>/
//                                                    (Parquet parts, atomic) and records the run. changed: unused (the
//                                                    output always rebuilds), kept for Update.
const PipelineRunner = (() => {
  const file = ctx => `${ctx.dir}/pipeline/pipeline.json`, runsFile = ctx => `${ctx.dir}/pipeline/runs.json`;
  const blank = () => ({ version: 2, queries: [], active: null, output: '' });
  const runs = async ctx => { try { return await DNFS.readJSONOr(runsFile(ctx), []); } catch { return []; } };

  // Version 1 (ordered steps, each writing a dataset) -> version 2 (queries; the last step becomes the active one).
  function migrate(p) {
    if (!p || typeof p !== 'object') return blank();
    if (p.version === 2 && Array.isArray(p.queries)) return p;
    const steps = Array.isArray(p.steps) ? p.steps : [];
    const sqlOf = s => s.config?.query ?? (typeof PipelineSteps !== 'undefined' ? (() => { try { return PipelineSteps.sqlOf(s); } catch { return ''; } })() : '');
    const queries = steps.map(s => ({ id: s.id || crypto.randomUUID(), name: s.title || s.name || '', sql: sqlOf(s) }));
    const last = steps[steps.length - 1];
    let output = last?.name ? String(last.name).toUpperCase().replace(/\s/g, '_') : '';
    if (output && !output.startsWith('CLEAN_')) output = 'CLEAN_' + output;
    return { version: 2, queries, active: queries.length ? queries[queries.length - 1].id : null, output, rev: p.rev || 0, updated: p.updated };
  }
  const load = async ctx => { try { return migrate(await DNFS.readJSONOr(file(ctx), blank())); } catch { return blank(); } };

  async function views(ctx) { await ctx.reload(); return Engine.views(ctx.cfg.datasets || []); }
  const active = pipe => (pipe.queries || []).find(q => q.id === pipe.active);

  // Returns the run record { at, ms, ok, outputs: [{ name, rows, before }], error }.
  async function run(ctx, pipe, log = () => {}, changed = null, onJob = () => {}) {
    const t0 = performance.now(), rec = { at: new Date().toISOString(), outputs: [], ok: true };
    try {
      const q = active(pipe);
      if (!q) throw new Error('Set an active query first.');
      if (!q.sql.trim()) throw new Error(`Query "${q.name}" is empty.`);
      const name = pipe.output;
      if (!/^CLEAN_[A-Z0-9_]+$/.test(name || '')) throw new Error('The output dataset name must be CLEAN_ followed by letters, digits or _.');
      const cfg = await ctx.reload(), ds = cfg.datasets || [];
      const before = ds.find(d => d.name === name);
      if (before && before.source?.kind !== 'pipeline') throw new Error(`"${name}" is an imported dataset; pick another output name.`);
      let lastStage = '';
      log(`Building ${name} from query "${q.name}"…`);
      const meta = { lineage: { transformQuery: q.id, transformName: q.name, pipelineVersion: pipe.rev || 0 } };
      const w = await Engine.write({ sql: q.sql, views: Engine.views(ds), dest: `${ctx.dir}/data/source/${name}`, meta }, j => {
        onJob(j);
        if (j.stage && j.stage !== lastStage) { lastStage = j.stage; log(`${j.stage}…`); }
      });
      if (before && before.path !== w.path) await DNFS.remove(before.path, { recursive: !/\.parquet$/.test(before.path) }).catch(() => {});
      await Projects.upsertDataset(ctx.folder, { name, path: w.path, parts: w.files, stage: 'source', rows: w.rowCount, bytes: w.bytes, columns: Engine.columnsOf(w),
        version: w.version, imported: new Date().toISOString(), source: { kind: 'pipeline', query: q.id } });
      rec.outputs.push({ name, rows: w.rowCount, before: before?.rows ?? null });
      log(`${name}: ${UI.num(w.rowCount)} rows, ${(w.columns || []).length} columns, ${(w.files || []).length} part(s), ${UI.bytes(w.bytes)}`, 'ok');
    } catch (e) { rec.ok = false; rec.error = e.message; }
    rec.ms = Math.round(performance.now() - t0);
    const all = await runs(ctx); all.push(rec); await DNFS.writeJSON(runsFile(ctx), all.slice(-100));
    await Projects.touchModule(ctx.folder, 'pipeline', { ok: rec.ok });
    await ctx.reload();
    return rec;
  }
  return { load, runs, views, run, file, active, migrate };
})();

