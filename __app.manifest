<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Project Manager</title>
<script src="../js/core/embed.js"></script>
<script src="../js/core/theme.js"></script>
<link rel="stylesheet" href="../css/theme.css">
<style>
  .trash-list { max-height: 50vh; overflow: auto; border: 1px solid var(--border); border-radius: 4px; }
  .trash-list label { display: flex; align-items: center; gap: 8px; padding: 6px 10px; cursor: pointer; }
  .trash-list label + label { border-top: 1px solid var(--border); }
  .trash-list small { margin-left: auto; color: var(--muted); }
  dialog.flash { animation: flash .18s ease-in-out 8 alternate; }
  @keyframes flash { from { box-shadow: 0 12px 40px #0009; border-color: var(--border); } to { box-shadow: 0 0 0 4px var(--err), 0 0 40px var(--err); border-color: var(--err); } }
  .detail td { background: var(--panel) !important; white-space: normal; padding: 12px 16px 14px; }
  .detail .desc { color: var(--text-2); margin-bottom: 10px; }
  .detail .meta { display: flex; flex-wrap: wrap; gap: 6px 24px; font-size: 12px; color: var(--muted); margin-top: 10px; }
  .detail .actions { display: flex; gap: 5px; margin-top: 12px; }
  .detail .log { margin-top: 10px; }
  /* Status %: light red (0) to green (100). */
  #tbl tbody tr:not(.detail) td:not(:first-child) { font-weight: 400; }
  .pct.p0 { color: #ff8a8a; } .pct.p25 { color: #f5a35c; } .pct.p50 { color: #e8c547; } .pct.p75 { color: #a6cf3f; } .pct.p100 { color: #4cc27f; }
  th .arrow { color: var(--blue); }
  th .arrow.off { color: var(--muted); }
  .empty { text-align: center; padding: 40px; color: var(--muted); }
  /* No page scroll: only the projects table scrolls (its header row is sticky). */
  body { display: flex; flex-direction: column; overflow: hidden; }
  .app { flex: 1; min-height: 0; height: auto; }
  .main { display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
  .main > .table-wrap { flex: 1; min-height: 0; overflow-x: hidden; }   /* never scrolls sideways */
</style>
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="brand">
      <span class="logo">DN</span>
      <div><h1>Data Noodler</h1><div class="sub">Project Management</div></div>
    </div>
  </header>
  <div class="main">
    <h2>Projects</h2>
    <div class="row" style="margin-bottom:12px">
      <input id="q" class="search" type="search" placeholder="Search name, owner, description, tags">
      <select id="fPhase"><option value="">All Phases</option></select>
      <select id="fStatus"><option value="">All Statuses</option></select>
      <select id="fClass"><option value="">All Classifications</option></select>
      <div class="spacer" style="flex:1"></div>
      <button id="new">New project</button>
      <button id="refresh" class="ghost">Refresh</button>
      <button id="trash" class="ghost" title="Recover or permanently delete projects in projects/.trash">Trash</button>
      <button id="srvctl" class="danger" title="Open the server control panel">Server Control</button>
    </div>
    <div class="table-wrap">
      <table class="grid" id="tbl">
        <thead><tr>
          <th class="sort" data-k="name">Project Name</th><th class="sort" data-k="owner">Owner</th>
          <th class="sort" data-k="phase">Phase</th><th class="sort" data-k="status">Status</th><th class="sort" data-k="classification">Classification</th>
          <th class="sort num" data-k="datasets">Datasets</th>
          <th class="sort" data-k="created">Created</th><th class="sort" data-k="modified">Modified</th><th class="sort" data-k="updated">Last Updated</th>
        </tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<script src="../js/dn-fs.js"></script>
<script src="../js/core/ui.js"></script>
<script src="../js/core/user-picker.js"></script>
<script src="../js/core/project-log.js"></script>
<script src="../js/core/projects.js"></script>
<script src="../js/core/windows.js"></script>
<script>
const { $, esc } = UI, P = Projects;
// open = expanded project; Back from a module returns here with ?project=<folder> so it stays expanded.
let projects = [], sortKey = 'modified', sortDir = -1, open = UI.params().project || null;
// Filters: [value, label] lists from Projects.
const fill = (id, list) => list.forEach(([v, l]) => $(id).insertAdjacentHTML('beforeend', `<option value="${esc(v === '' ? '-' : v)}">${esc(l)}</option>`));
fill('fPhase', P.PHASE); fill('fStatus', P.STATUS); fill('fClass', P.CLASSIFICATION);
const badge = (list, v) => v === '' || v == null ? '-' : `<span class="badge ${esc(v)}">${esc(P.label(list, v))}</span>`;
const updated = p => p.modules?.update?.lastRun || '';
const COLS = 9;
const DATES = ['created', 'modified', 'updated']; // date columns always show their sort arrow, newest first on click

const load = UI.guard(async () => { projects = await P.list(); render(); });
const val = (p, k) => k === 'datasets' ? (p.datasets?.length || 0) : k === 'status' ? (+p.status || 0) : k === 'phase' ? P.PHASE.findIndex(([v]) => v === p.phase) : k === 'updated' ? updated(p) : String(p[k] ?? '').toLowerCase();

function render() {
  const q = $('q').value.trim().toLowerCase(), fs = $('fStatus').value, fc = $('fClass').value, fp = $('fPhase').value;
  const list = projects
    .filter(p => (!fp || p.phase === fp) && (!fs || String(p.status) === fs) && (!fc || p.classification === fc))
    .filter(p => !q || [p.name, p.owner, p.description, ...(p.tags || [])].join(' ').toLowerCase().includes(q))
    .sort((a, b) => { const x = val(a, sortKey), y = val(b, sortKey); return (x > y ? 1 : x < y ? -1 : 0) * sortDir; });
  document.querySelectorAll('th.sort').forEach(th => th.innerHTML = th.textContent.replace(/[▲▼]/g, '').trim() + (th.dataset.k === sortKey ? ` <span class="arrow">${sortDir > 0 ? '▲' : '▼'}</span>` : DATES.includes(th.dataset.k) ? ' <span class="arrow off">▼</span>' : ''));
  const body = $('tbl').querySelector('tbody');
  if (!list.length) { body.innerHTML = `<tr><td colspan="${COLS}" class="empty">${projects.length ? 'No projects match the filters.' : 'No projects yet. Click <b>New project</b> to create one.'}</td></tr>`; return; }
  body.innerHTML = list.map(p => `
    <tr class="click ${open === p.folder ? 'open' : ''}" data-f="${esc(p.folder)}">
      <td><b>${esc(p.name)}</b>${p.broken ? ' <span class="err">(config missing)</span>' : ''}<div class="sub">${esc(p.folder)}</div></td>
      <td>${esc(p.owner)}</td><td>${badge(P.PHASE, p.phase)}</td><td class="pct p${+p.status || 0}">${+p.status || 0}%</td>
      <td>${badge(P.CLASSIFICATION, p.classification)}</td>
      <td class="num">${p.datasets?.length || 0}</td><td>${UI.date(p.created)}</td><td>${UI.date(p.modified)}</td><td>${updated(p) ? UI.date(updated(p)) : '-'}</td>
    </tr>${open === p.folder ? detail(p) : ''}`).join('');
  if (open) loadLog(open);
}

function detail(p) {
  const mods = Windows.MODULES.filter(m => !m.global).map(m => `<button data-mod="${m.id}" ${m.enabled && !p.broken ? '' : 'disabled'} title="${m.enabled ? `Open ${m.label}` : 'Not built yet'}">${m.label}</button>`).join('');
  const last = Object.entries(p.modules || {}).filter(([, v]) => v?.lastRun).map(([k, v]) => `${k}: ${UI.date(v.lastRun)}`).join(' · ');
  return `<tr class="detail"><td colspan="${COLS}">
    <div class="desc">${p.description ? esc(p.description) : '<span class="muted">No description.</span>'}</div>
    <div class="modules">${mods}</div>
    <div class="meta"><span>Developers: ${(p.developers || []).map(esc).join(', ') || '-'}</span><span>Updaters: ${(p.updaters || []).map(esc).join(', ') || '-'}</span><span>Tags: ${(p.tags || []).map(esc).join(', ') || '-'}</span><span>Last runs: ${last || '-'}</span><span>Datasets: ${(p.datasets || []).map(d => `${esc(d.name)} (${UI.rows(d.rows)} rows)`).join(', ') || '-'}</span></div>
    <div class="actions"><button class="ghost" data-act="edit">Edit details</button><button class="ghost" data-act="rename">Rename</button><button class="danger" data-act="delete">Delete</button></div>
    <div class="log" id="plog"></div>
  </td></tr>`;
}
async function loadLog(folder) {
  const lines = await ProjectLog.read(folder).catch(() => []);
  const el = $('plog'); if (!el) return;
  // Same look as the module logs: local "yyyy-mm-dd hh:mm:ss", then module and message; warnings orange, errors red.
  el.innerHTML = lines.slice(0, ProjectLog.MAX).map(l => {
    const m = l.match(/^(\S+)\s+(\S+)\s+(\S+)\s+(.*)$/); if (!m) return `<div>${esc(l)}</div>`;
    const [, at, lvl, mod, msg] = m, cls = lvl === 'ERROR' ? 'err' : lvl === 'WARN' ? 'warn' : '';
    return `<div class="${cls}"><span class="t">${UI.stamp(new Date(at))}</span>  ${esc(mod)}: ${esc(msg)}</div>`;
  }).join('') || '<span class="muted">No activity yet.</span>';
  window.LogMore?.(el);
}

// ---- events ----
$('q').oninput = render;   // instant: filtering is in memory
$('fPhase').onchange = $('fStatus').onchange = $('fClass').onchange = render;
$('refresh').onclick = load;

// ---- trash: recover selected projects, or empty it (typed acknowledgement) ----
$('trash').onclick = UI.guard(async () => {
  for (;;) {
    const items = (await P.trashList()).sort((a, b) => b.trashed.localeCompare(a.trashed));
    const body = items.length
      ? `<div class="trash-list">${items.map(t => `<label><input type="checkbox" name="pick" value="${esc(t.id)}"> ${esc(t.name)}<small>trashed ${UI.date(t.trashed)}</small></label>`).join('')}</div>`
      : '<div class="muted">The trash is empty.</div>';
    const picked = f => [...f.querySelectorAll('input[name=pick]:checked')].map(c => c.value);
    const act = await UI.dialog('Trash', body, items.length
      ? [{ label: 'Close', value: null, kind: 'ghost' }, { label: 'Empty Trash', value: 'empty', kind: 'danger' }, { label: 'Recover Selected', value: f => ({ recover: picked(f) }) }]
      : [{ label: 'Close', value: null }]);
    if (!act) return;
    if (act === 'empty') {
      if (!await confirmEmpty(items.length)) continue;
      const r = await P.emptyTrash();
      UI.toast(`Trash emptied: ${r.deleted} project(s) permanently deleted`, 'ok');
      return;
    }
    if (!act.recover.length) { UI.toast('Tick at least one project to recover.', 'err'); continue; }
    for (const id of act.recover) { const r = await P.restore(id); UI.toast(`Recovered to projects/${r.folder}`, 'ok'); }
    await load();
  }
});
// Second confirmation: flashes red 4 times, Empty stays disabled until "I Acknowledge" is typed (any case).
async function confirmEmpty(n) {
  const p = UI.dialog('Empty trash', `<div>Are you sure you want to empty the trash?</div>
    <div class="err"><b>WARNING:</b> This will permanently delete all ${n} project(s) in the trash. This cannot be undone.</div>
    <label class="field">Type I Acknowledge to continue<input type="text" class="ack" autocomplete="off" spellcheck="false"></label>`,
    [{ label: 'Cancel', value: false, kind: 'ghost' }, { label: 'Empty', value: true, kind: 'danger' }]);
  const d = [...document.querySelectorAll('dialog')].pop(), ok = d.querySelector('footer button.danger'), ack = d.querySelector('.ack');
  ok.disabled = true;
  ack.oninput = () => { ok.disabled = ack.value.trim().toLowerCase() !== 'i acknowledge'; };
  ack.onkeydown = ev => { if (ev.key === 'Enter') { ev.preventDefault(); if (!ok.disabled) ok.click(); } };
  d.classList.add('flash');
  return p;
}
document.querySelectorAll('th.sort').forEach(th => th.onclick = () => { sortDir = sortKey === th.dataset.k ? -sortDir : DATES.includes(th.dataset.k) ? -1 : 1; sortKey = th.dataset.k; render(); });
$('tbl').onclick = UI.guard(async ev => {
  const mod = ev.target.closest('[data-mod]'), act = ev.target.closest('[data-act]');
  if (mod) { Windows.open(mod.dataset.mod, open); return; }
  if (act) return actions[act.dataset.act](projects.find(p => p.folder === open));
  const tr = ev.target.closest('tr.click'); if (!tr) return;
  open = open === tr.dataset.f ? null : tr.dataset.f; render();
});

const fields = p => [
  { name: 'name', label: 'Name', value: p?.name, required: true, placeholder: 'e.g. Sales Q3' },
  { name: 'owner', label: 'Owner', type: 'user', value: p?.owner },
  { name: 'developers', label: 'Developer(s)', type: 'users', value: p?.developers || [] },
  { name: 'updaters', label: 'Updater(s)', type: 'users', value: p?.updaters || [] },
  { name: 'description', label: 'Description', type: 'textarea', value: p?.description },
  { name: 'phase', label: 'Phase', type: 'select', options: P.PHASE, value: p?.phase || 'not-started' },
  { name: 'status', label: 'Status', type: 'select', options: P.STATUS, value: p?.status ?? 0 },
  { name: 'classification', label: 'Classification', type: 'select', options: P.CLASSIFICATION, value: p?.classification || 'unclassified' },
  { name: 'tags', label: 'Tags (comma separated)', value: (p?.tags || []).join(', ') },
];
const clean = async v => ({ ...v, status: +v.status || 0, developers: UserPicker.parse(v.developers), updaters: UserPicker.parse(v.updaters), tags: tagsOf(v.tags) });
const tagsOf = s => (s || '').split(',').map(t => t.trim()).filter(Boolean);

// This window owns the server: closing it stops the server (a reload says hello within 4 s and cancels that).
const srv = op => fetch(`/api/${op}`, { method: 'POST', keepalive: true, headers: { 'X-DN-Token': window.DN_TOKEN } }).catch(() => {});
srv('hello'); addEventListener('pagehide', () => srv('bye'));
$('srvctl').onclick = () => fetch('/api/panel', { method: 'POST', headers: { 'X-DN-Token': window.DN_TOKEN } }).catch(() => {});
$('new').onclick = UI.guard(async () => {
  await UserPicker.load();
  const v = await UI.form('New project', fields(), { ok: 'Create' }); if (!v) return;
  const cfg = await P.create(await clean(v));
  UI.toast(`Created ${cfg.name} (projects/${cfg.folder})`, 'ok');
  open = cfg.folder; await load();
});
const actions = {
  async edit(p) {
    await UserPicker.load();
    const v = await UI.form(`Edit ${p.name}`, fields(p).filter(f => f.name !== 'name')); if (!v) return;
    await P.update(p.folder, await clean(v));
    await ProjectLog.write(p.folder, 'project', 'Details edited');
    UI.toast('Saved', 'ok'); await load();
  },
  async rename(p) {
    const v = await UI.form(`Rename ${p.name}`, [{ name: 'name', label: 'New name', value: p.name, required: true }], { ok: 'Rename' }); if (!v) return;
    const cfg = await P.rename(p.folder, v.name);
    UI.toast(`Renamed to ${cfg.name}`, 'ok'); open = cfg.folder; await load();
  },
  async delete(p) {
    if (!await UI.dialog('Delete project', `<div>Are you sure you want to delete <b>${esc(p.name)}</b>?</div>
      <div class="muted"><b>NOTE:</b> This only removes the project from the list and moves it to the trash (projects/.trash). If the trash is emptied, the project is permanently deleted.</div>`,
      [{ label: 'Cancel', value: false, kind: 'ghost' }, { label: 'Delete', value: true, kind: 'danger' }])) return;
    const r = await P.trash(p.folder);
    UI.toast(`Moved to ${r.trashed}`, 'ok'); open = null; await load();
  },
};
load();
</script>
</body>
</html>

=== FILE text 9067 9067 0addbc5ba0715dc9585fe28cc4ed91d631e1379a63ff8d8f5930407b1b4c1cb1 150 html/publish.html
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Publish</title>
<script src="../js/core/embed.js"></script>
<script src="../js/core/theme.js"></script>
<link rel="stylesheet" href="../css/theme.css">
<style>
  .list div { display: flex; gap: 10px; align-items: center; padding: 5px 0; border-bottom: 1px solid var(--border); }
  .list div span:first-child { flex: 1; }
  .opts { display: grid; gap: 6px; }
</style>
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="brand"><span class="logo">DN</span><div><h1 id="title">Publish</h1><div class="sub" id="sub"></div></div></div>
  </header>
  <div class="main stack">
    <div class="grid2">
      <section class="box stack">
        <h3>Dashboard as a web page</h3>
        <div class="muted">One self-contained HTML file with the current results built in: it opens anywhere, without the server or the data.</div>
        <label class="field">Name<input id="dName" type="text" value="dashboard"></label>
        <button id="pubDash">Publish dashboard</button>
      </section>
      <section class="box stack">
        <h3>Datasets</h3>
        <div class="muted">Copies of staged datasets for other tools.</div>
        <div class="opts" id="dsOpts"></div>
        <label class="field">Format<select id="fmt"><option value="csv">CSV (with header)</option><option value="parquet">Parquet (Snappy)</option><option value="sqlite">SQLite</option></select></label>
        <button id="pubData">Export selected</button>
      </section>
    </div>
    <h2>Published</h2>
    <div class="list" id="pubs"></div>
    <h2>Activity</h2>
    <div class="log" id="log"></div>
  </div>
</div>

<script src="../js/dn-fs.js"></script>
<script src="../js/core/engine-client.js"></script>
<script src="../js/core/ui.js"></script>
<script src="../js/core/project-log.js"></script>
<script src="../js/core/projects.js"></script>
<script src="../js/core/module-page.js"></script>
<script src="../js/vendor/apexcharts.min.js"></script>
<script src="../js/vendor/apextree.min.js"></script>
<script type="module" src="../js/widgets/apex-grid-loader.js"></script>
<script src="../js/widgets/apex-render.js"></script>
<script src="../js/widgets/apex-widget.js"></script>
<script>
const { $, esc } = UI;
let ctx;
const stamp = () => new Date().toISOString().slice(0, 19).replace(/[-:T]/g, '').replace(/(\d{8})(\d{6})/, '$1-$2');
const slug = s => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'export';

async function listPubs() {
  let items = [];
  try { items = await DNFS.list(`${ctx.dir}/publish`, { recursive: true }); } catch {}
  const files = items.filter(f => !f.dir).sort((a, b) => b.modified.localeCompare(a.modified));
  $('pubs').innerHTML = files.map(f => `<div><span class="mono">${esc(f.path.replace(`${ctx.dir}/publish/`, ''))}</span><span class="muted">${UI.bytes(f.size)} · ${UI.date(f.modified)}</span>${f.name.endsWith('.html') ? `<a class="btn" href="/${esc(f.path)}" target="_blank">Open</a>` : ''}<button class="danger small" data-del="${esc(f.path)}">Delete</button></div>`).join('') || '<div class="muted">Nothing published yet.</div>';
}
$('pubs').onclick = UI.guard(async ev => {
  const p = ev.target.dataset.del; if (!p) return;
  if (!await UI.confirm(`Delete ${p.split('/').pop()}?`, { danger: true, ok: 'Delete' })) return;
  await DNFS.remove(p); ctx.log(`Deleted published file ${p}`); listPubs();
});

// ---- dashboard page: results computed now, embedded as JSON; renderer, theme and helpers inlined ----
$('pubDash').onclick = UI.guard(async () => {
  const dash = await DNFS.readJSONOr(`${ctx.dir}/dashboard/dashboard.json`, null);
  if (!dash) throw new Error('No dashboard yet. Build one in the Dashboard module first.');
  if (!dash.widgets?.length) throw new Error('The dashboard has no widgets.');
  $('pubDash').disabled = true;
  try {
    // Each widget is drawn here (Apex) at its dashboard size and embedded as static SVG: the page needs no JavaScript.
    const pkgs = new Map((await WidgetRegistry.list(true)).map(m => [m.id, m]));
    const COLS = dash.cols || 48, ROWS = dash.rows || 27, CELL = 30, cards = [];
    const host = Object.assign(document.createElement('div'), { style: 'position:fixed;left:-99999px;top:0' }); document.body.append(host);
    try {
      for (const w of dash.widgets) {
        const m = pkgs.get(w.pkg), d = ctx.cfg.datasets.find(x => x.name === w.dataset);
        let body;
        if (!m) body = `<div class="note err">Widget package ${esc(w.pkg)} not found</div>`;
        else if (!ApexWidget.ready(m, w)) continue;   // not set up yet: left out
        else if (!d) body = `<div class="note err">Dataset ${esc(w.dataset)} not found</div>`;
        else {
          const r = await Engine.call('query', { query: ApexWidget.query(m, w), views: Engine.views([d]) });
          const el = Object.assign(document.createElement('div'), { style: `width:${w.w * CELL - 16}px;height:${w.h * CELL - 44}px` }); host.append(el);
          try { await ApexWidget.render(el, m, m.specJson, w, ApexWidget.objects(r), { columns: d.columns || [] }); body = el.innerHTML; }
          catch (e) { body = `<div class="note err">${esc(String(e.message || e).split('\n')[0])}</div>`; }
        }
        cards.push(`<div class="card" style="left:${w.x / COLS * 100}%;top:${w.y / ROWS * 100}%;width:${w.w / COLS * 100}%;height:${w.h / ROWS * 100}%"><h3>${esc(w.title || m?.name || '')}</h3><div class="body">${body}</div></div>`);
      }
    } finally { host.remove(); }
    if (!cards.length) throw new Error('No widget is set up yet (dataset + data inputs).');
    const css = await (await fetch('/css/theme.css')).text();
    const html = `<!doctype html><html lang="en"><head><meta charset="utf-8"><title>${esc(ctx.cfg.name)} · Dashboard</title>
<style>${css.replace(/@font-face[^}]+}/g, '')}
.board{position:relative;width:min(100%,calc((100vh - 120px) * 16 / 9));aspect-ratio:16/9;margin:0 auto}
.card{position:absolute;box-sizing:border-box;padding:4px;display:flex}
.card>*{min-width:0}
.card{flex-direction:column}
.card h3{margin:0;padding:6px 10px;font-size:13px;font-weight:600;background:var(--panel);border:1px solid var(--border);border-bottom:0;border-radius:4px 4px 0 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .body{flex:1;min-height:0;background:var(--panel);border:1px solid var(--border);border-radius:0 0 4px 4px;padding:6px 8px;overflow:hidden}
.card .body>svg,.card .body>figure>svg:last-child{width:100%;height:100%}
.card .body>figure{margin:0;height:100%;display:flex;flex-direction:column}
.card .body>figure>svg:last-child{flex:1;min-height:0}
.note{height:100%;display:grid;place-items:center;color:var(--muted)}</style></head>
<body><div class="app"><header class="topbar"><div class="brand"><span class="logo">DN</span><div><h1>${esc(ctx.cfg.name)}</h1><div class="sub">Dashboard published ${esc(new Date().toLocaleString())}${ctx.cfg.classification ? ` (classification: ${esc(ctx.cfg.classification)})` : ''}</div></div></div></header>
<div class="main"><div class="board">${cards.join('\n')}</div></div></div></body></html>`;
    const name = slug($('dName').value), path = `${ctx.dir}/publish/${name}-${stamp()}.html`;
    await DNFS.writeText(path, html);
    await Projects.touchModule(ctx.folder, 'publish');
    ctx.log(`Published dashboard → ${path} (${UI.bytes(html.length)})`, 'ok'); UI.toast('Dashboard published', 'ok');
    await listPubs();
  } finally { $('pubDash').disabled = false; }
});

// ---- dataset exports ----
$('pubData').onclick = UI.guard(async () => {
  const names = [...document.querySelectorAll('#dsOpts input:checked')].map(c => c.value);
  if (!names.length) throw new Error('Tick at least one dataset.');
  const fmt = $('fmt').value, dir = `${ctx.dir}/publish/data-${stamp()}`;
  $('pubData').disabled = true;
  try {
    for (const n of names) {
      const d = ctx.cfg.datasets.find(x => x.name === n), st = ctx.step(`Exporting ${n} as ${fmt.toUpperCase()}…`);
      // One file per dataset; the engine streams it, so a big dataset never has to fit in memory.
      const r = await Engine.exportTo({ sql: `SELECT * FROM ${Engine.dataset(d)}`, to: `${dir}/${n}.${fmt}`, format: fmt, table: n }).catch(e => { st.fail(`Export ${n} failed: ${e.message}`); throw e; });
      st.done(`Exported ${n} as ${fmt.toUpperCase()}: ${UI.num(r.rows)} rows, ${UI.bytes(r.bytes)}`);
    }
    await Projects.touchModule(ctx.folder, 'publish');
    UI.toast('Export finished', 'ok'); await listPubs();
  } finally { $('pubData').disabled = false; }
});

(async () => {
  try {
    ctx = await ModulePage.init('publish', 'Publish');
    $('dsOpts').innerHTML = (ctx.cfg.datasets || []).map(d => `<label class="row"><input type="checkbox" value="${esc(d.name)}"> ${esc(d.name)} <span class="muted">${UI.rows(d.rows)} rows · ${UI.bytes(d.bytes)}</span></label>`).join('') || '<span class="muted">No datasets yet.</span>';
    await listPubs();
  } catch (e) { UI.toast(e.message, 'err'); }
})();
</script>
</body>
</html>

=== FILE text 15187 15187 4fcc780966cbbc153a303c3bdaba259214223861cb9b9f07577d4cc8976b0d63 242 html/thread-bench.html
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Engine Benchmark</title>
<style>
  @font-face { font-family: 'Exo 2'; font-weight: 400; src: url(../assets/fonts/exo2-400.ttf) format('truetype'); }
  @font-face { font-family: 'Exo 2'; font-weight: 600; src: url(../assets/fonts/exo2-600.ttf) format('truetype'); }
  :root {
    color-scheme: light;
    --bg: #fcfcfb; --panel: #f4f4f2; --border: #dddcd6;
    --text: #0b0b0b; --text-2: #52514e; --muted: #85837c;
    --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a; --s4: #c9a227; --s5: #9b6bd6; --s6: #d6529a;
    --ok: #0a7a3d; --err: #c42b2b;
  }
  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) {
      color-scheme: dark;
      --bg: #1a1a19; --panel: #242422; --border: #3a3936;
      --text: #ffffff; --text-2: #c3c2b7; --muted: #8d8b82;
      --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c9a227; --s5: #9b6bd6; --s6: #d6529a;
      --ok: #4cc27f; --err: #ff7b7b;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 16px 20px; font: 14px 'Exo 2', system-ui, sans-serif; background: var(--bg); color: var(--text); }
  h1 { font-size: 18px; margin: 0 0 12px; }
  h2 { font-size: 14px; margin: 18px 0 6px; color: var(--text-2); font-weight: 600; }
  button, input, select { font: inherit; }
  button { padding: 4px 10px; }
  input[type=number] { width: 52px; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; margin-bottom: 8px; }
  .box { background: var(--panel); border: 1px solid var(--border); border-radius: 4px; padding: 10px 12px; }
  #env { display: flex; flex-wrap: wrap; gap: 4px 22px; font-size: 13px; color: var(--text-2); margin-bottom: 10px; }
  #env b { color: var(--text); font-weight: 600; }
  #bar { height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; margin: 6px 0; }
  #fill { height: 100%; width: 0; background: var(--s1); transition: width .15s; }
  #msg { font-family: ui-monospace, Consolas, monospace; font-size: 13px; color: var(--text-2); }
  #log { font: 12px ui-monospace, Consolas, monospace; max-height: 120px; overflow: auto; color: var(--muted); white-space: pre-wrap; }
  .err { color: var(--err); } .ok { color: var(--ok); }
  .charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 16px; margin-top: 12px; }
  .chart h3 { margin: 0 0 4px; font-size: 13px; }
  .legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12px; color: var(--text-2); margin-bottom: 4px; }
  .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 5px; }
  .note { font-size: 12px; color: var(--muted); margin-top: 6px; }
  svg { width: 100%; height: auto; display: block; }
  svg text { fill: var(--text-2); font-size: 11px; }
  svg .grid { stroke: var(--border); stroke-width: 1; }
  svg .ref { stroke: var(--text-2); stroke-width: 1; stroke-dasharray: 4 3; }
  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { padding: 4px 8px; text-align: right; border-bottom: 1px solid var(--border); white-space: nowrap; }
  th:first-child, td:first-child { text-align: left; }
  th { color: var(--text-2); font-weight: 600; }
  #tbl { overflow-x: auto; }
  #tip { position: fixed; pointer-events: none; background: var(--text); color: var(--bg); padding: 4px 8px; border-radius: 4px; font-size: 12px; display: none; z-index: 9; }
</style>
</head>
<body>
<h1>Worker benchmark: native engine workers on Parquet</h1>

<div id="env">Starting engine…</div>

<div class="row">
  <label>Data <select id="data">
    <option value="test-data/sales_1m">sales_1m (1M rows)</option>
    <option value="test-data/sales_10m">sales_10m (10M rows)</option>
  </select></label>
  <label>Read from <select id="source">
    <option value="file">Parquet (read from disk)</option>
    <option value="table">In-memory table (cached in the engine)</option>
  </select></label>
  <label>Runs <input id="runs" type="number" min="1" max="10" value="3"></label>
  <span>Workers <span id="threads"></span></span>
  <button id="go" disabled>Run benchmark</button>
</div>

<div class="box">
  <div id="msg">Idle.</div>
  <div id="bar"><div id="fill"></div></div>
  <div id="log"></div>
</div>

<div class="charts">
  <div class="box chart"><h3>Query time by worker count (median, lower is better)</h3><div class="legend" id="lg1"></div><div id="c1"></div></div>
  <div class="box chart"><h3>Speedup vs 1 worker (higher is better)</h3><div class="legend" id="lg2"></div><div id="c2"></div></div>
</div>

<h2>Results</h2>
<div id="tbl" class="box">Run the benchmark to fill this in.</div>
<div id="tip"></div>

<script src="../js/dn-fs.js"></script>
<script src="../js/core/engine-client.js"></script>
<script src="../js/test-data-gen.js"></script>
<script>
const $ = id => document.getElementById(id);
const log = (m, c = '') => { const d = document.createElement('div'); d.className = c; d.textContent = m; $('log').append(d); $('log').scrollTop = 1e9; };
const fmtMs = ms => (ms / 1000).toFixed(1) + ' s';
const med = a => { const b = [...a].sort((x, y) => x - y), h = b.length >> 1; return b.length % 2 ? b[h] : (b[h - 1] + b[h]) / 2; };
const COLORS = ['var(--s1)', 'var(--s2)', 'var(--s3)', 'var(--s4)', 'var(--s5)', 'var(--s6)'];
const guard = fn => async () => { try { await fn(); } catch (e) { log('FAILED: ' + e.message, 'err'); console.error(e); } };
// Engine time of one query at n workers (the engine reports its own ms; JSON transfer not included).
const timed = async (sql, n) => (await Engine.query(sql, { workers: n, limit: 10 })).ms;

// Each query reads from SRC (the Parquet file or the engine's in-memory table).
let SRC = '';
const QUERIES = [
  { id: 'scan',   label: 'Scan + sum',  sql: () => `SELECT count(*), sum(total), avg(unit_price), max(order_date) FROM ${SRC}` },
  { id: 'group',  label: 'Group by',    sql: () => `SELECT region, category, count(*), sum(total), avg(discount) FROM ${SRC} GROUP BY ALL` },
  { id: 'dist',   label: 'Distinct',    sql: () => `SELECT count(DISTINCT customer_id), count(DISTINCT (customer_id, category)) FROM ${SRC}` },
  { id: 'sort',   label: 'Full sort',   sql: () => `SELECT max(rn) FROM (SELECT row_number() OVER (ORDER BY total DESC, id) rn FROM ${SRC})` },
  { id: 'join',   label: 'Join',        sql: () => `SELECT count(*), sum(s.total / c.avg_total) FROM ${SRC} s JOIN (SELECT customer_id, avg(total) avg_total FROM ${SRC} GROUP BY 1) c USING (customer_id)` },
  { id: 'window', label: 'Window',      sql: () => `SELECT sum(rt) FROM (SELECT sum(total) OVER (PARTITION BY customer_id ORDER BY order_date, id) rt FROM ${SRC})` },
];

// ---- progress ----
let step = 0, total = 1, t0 = 0, label = '';
const paint = () => { $('fill').style.width = (100 * step / total) + '%'; $('msg').textContent = `${step}/${total}  ${label}  ${((performance.now() - t0) / 1000).toFixed(1)} s`; };
const begin = l => { label = l; t0 = performance.now(); paint(); };

// ---- start ----
let info;
(async () => {
  try {
    info = await Engine.status();
    $('env').innerHTML = [
      ['Engine', `native ${info.version}`], ['Workers', info.workers], ['CPU logical cores', info.cores],
      ['Memory budget', (info.memory.budget / 1073741824).toFixed(1) + ' GB'], ['Process', info.is64 ? '64-bit' : '32-bit'],
    ].map(([k, v]) => `<span>${k}: <b>${v}</b></span>`).join('');
    const opts = [...new Set([1, 2, 4, 8, 16, 32, 64].filter(n => n <= info.workers).concat(info.workers))];
    $('threads').innerHTML = opts.map(n => `<label><input type="checkbox" value="${n}" ${n <= 4 || n === info.workers ? 'checked' : ''}> ${n}</label>`).join(' ');
    log(`Native engine ${info.version} ready (${info.workers} workers)`, 'ok');
    $('go').disabled = false;
  } catch (e) { $('env').textContent = 'Engine not available: ' + e.message; log(e.message, 'err'); console.error(e); }
})();

// Generated datasets (test-data/gen/<name>/) are listed too and read as dataset folders.
TestDataGen.list().then(list => list.forEach(m => $('data').insertAdjacentHTML('beforeend', `<option value="gen:${m.name}">${m.name} (${(m.rows / 1e6).toFixed(1)}M rows)</option>`)));
// Make sure <base>.parquet exists; build it from <base>.csv on first use.
async function ensureParquet(base) {
  if (base.startsWith('gen:')) return `${TestDataGen.DIR}/${base.slice(4)}`;
  const pq = base + '.parquet';
  if ((await DNFS.stat(pq)).exists) return pq;
  begin(`Converting ${base}.csv to Parquet (one time)`);
  const t = performance.now();
  const w = await Engine.exportTo({ sql: `SELECT * FROM read_csv(${Engine.lit(base + '.csv')})`, to: pq, format: 'parquet' });
  log(`Wrote ${pq}: ${(w.bytes / 1048576).toFixed(1)} MB in ${fmtMs(performance.now() - t)}`, 'ok');
  return pq;
}

// ---- benchmark ----
let results = null; // { threads: [..], q: { id: { [workers]: [ms...] } }, peak: { [workers]: bytes } }
$('go').onclick = guard(async () => {
  const threads = [...$('threads').querySelectorAll('input:checked')].map(c => +c.value).sort((a, b) => a - b);
  if (!threads.length) return log('Pick at least one worker count.', 'err');
  const runs = Math.max(1, +$('runs').value || 3);
  $('go').disabled = true;
  const tick = setInterval(paint, 100);
  try {
    step = 0; total = QUERIES.length * threads.length * (runs + 1);
    const pq = await ensureParquet($('data').value);
    if ($('source').value === 'table') {
      begin('Loading Parquet into an in-memory table');
      const t = await Engine.cache.load('bench_t', `SELECT * FROM read_parquet(${Engine.lit(pq)})`);
      log(`Loaded into engine memory in ${fmtMs(t.ms)} (${(t.bytes / 1048576).toFixed(0)} MB)`);
      SRC = 'bench_t';
    } else { await Engine.cache.drop('bench_t'); SRC = `read_parquet(${Engine.lit(pq)})`; }
    const rows = Number((await Engine.query(`SELECT count(*) FROM ${SRC}`)).rows[0][0]);
    log(`${pq}: ${rows.toLocaleString()} rows, source = ${$('source').value === 'table' ? 'in-memory table' : 'Parquet from disk'}`);

    results = { threads, q: {}, rows, peak: {} };
    for (const q of QUERIES) {
      results.q[q.id] = Object.fromEntries(threads.map(n => [n, []]));
      // Warm-up at each worker count, then interleave the runs so drift hits every count equally.
      for (const n of threads) { begin(`${q.label}: warm-up, ${n} worker(s)`); await timed(q.sql(), n); step++; }
      for (let r = 0; r < runs; r++) {
        for (const n of threads) {
          begin(`${q.label}: run ${r + 1}/${runs}, ${n} worker(s)`);
          results.q[q.id][n].push(await timed(q.sql(), n));
          const m = (await Engine.status()).memory; results.peak[n] = Math.max(results.peak[n] || 0, m.process);
          step++;
        }
      }
      log(`${q.label}: ` + threads.map(n => `${n}w ${fmtMs(med(results.q[q.id][n]))}`).join(', '), 'ok');
      render();
    }
    label = 'Done'; step = total; paint();
  } finally { clearInterval(tick); $('go').disabled = false; }
});

// ---- charts ----
const tip = $('tip');
const showTip = (e, t) => { tip.textContent = t; tip.style.display = 'block'; tip.style.left = e.clientX + 12 + 'px'; tip.style.top = e.clientY + 12 + 'px'; };
const hideTip = () => tip.style.display = 'none';
const nice = max => { const p = 10 ** Math.floor(Math.log10(max || 1)); for (const m of [1, 2, 5, 10]) if (m * p >= max) return m * p; return max; };

// Grouped bars: cats on x, one bar per series. ref = optional dashed reference value.
function bars(el, cats, series, unit, ref) {
  const W = 640, H = 290, L = 56, R = 8, T = 10, B = 30, iw = W - L - R, ih = H - T - B;
  const max = nice(Math.max(...series.flatMap(s => s.vals.map(v => v || 0)), ref || 0, 0.001));
  const y = v => T + ih - ih * v / max;
  const gw = iw / cats.length, bw = Math.min(26, (gw - 14) / series.length - 2);
  let s = `<svg viewBox="0 0 ${W} ${H}" role="img">`;
  for (let i = 0; i <= 4; i++) { const v = max * i / 4; s += `<line class="grid" x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}"/><text x="${L - 6}" y="${y(v) + 4}" text-anchor="end">${+v.toPrecision(3)}${unit}</text>`; }
  cats.forEach((c, i) => {
    const gx = L + gw * i + (gw - series.length * (bw + 2)) / 2;
    series.forEach((se, j) => {
      const v = se.vals[i]; if (v == null) return;
      const x = gx + j * (bw + 2), h = ih - (y(v) - T), r = Math.min(4, h / 2);
      s += `<path d="M${x},${T + ih} V${y(v) + r} Q${x},${y(v)} ${x + r},${y(v)} H${x + bw - r} Q${x + bw},${y(v)} ${x + bw},${y(v) + r} V${T + ih} Z" fill="${se.color}" data-tip="${c} · ${se.name}: ${se.fmt(v)}"/>`;
    });
    s += `<text x="${L + gw * i + gw / 2}" y="${H - 10}" text-anchor="middle">${c}</text>`;
  });
  if (ref) s += `<line class="ref" x1="${L}" x2="${W - R}" y1="${y(ref)}" y2="${y(ref)}"/>`;
  el.innerHTML = s + '</svg>';
  el.querySelectorAll('[data-tip]').forEach(p => { p.onmousemove = e => showTip(e, p.dataset.tip); p.onmouseleave = hideTip; });
}

function render() {
  const { threads, q } = results, done = QUERIES.filter(x => q[x.id]);
  const cats = done.map(x => x.label), base = threads[0];
  const series = threads.map((n, i) => ({ n, name: `${n} thread${n > 1 ? 's' : ''}`, color: COLORS[i % COLORS.length] }));
  const legend = series.map(s => `<span><i style="background:${s.color}"></i>${s.name}</span>`).join('');
  $('lg1').innerHTML = $('lg2').innerHTML = legend;
  bars($('c1'), cats, series.map(s => ({ ...s, vals: done.map(x => med(q[x.id][s.n])), fmt: fmtMs })), ' ms');
  bars($('c2'), cats, series.map(s => ({ ...s, vals: done.map(x => med(q[x.id][base]) / med(q[x.id][s.n])), fmt: v => v.toFixed(2) + '×' })), '×', 1);
  $('c2').insertAdjacentHTML('beforeend', `<div class="note">Speedup = median time at ${base} thread${base > 1 ? 's' : ''} ÷ median time at N threads. Dashed line = no change.</div>`);

  const sum = n => done.reduce((a, x) => a + med(q[x.id][n]), 0);
  $('tbl').innerHTML = `<table><tr><th>Query</th>${threads.map(n => `<th>${n}w median</th><th>${n}w min / max</th>`).join('')}<th>Best speedup</th></tr>` +
    done.map(x => {
      const best = Math.max(...threads.map(n => med(q[x.id][base]) / med(q[x.id][n])));
      return `<tr><td>${x.label}</td>${threads.map(n => { const a = q[x.id][n]; return `<td>${fmtMs(med(a))}</td><td>${fmtMs(Math.min(...a))} / ${fmtMs(Math.max(...a))}</td>`; }).join('')}<td>${best.toFixed(2)}×</td></tr>`;
    }).join('') +
    `<tr><td><b>Total</b></td>${threads.map(n => `<td><b>${fmtMs(sum(n))}</b></td><td>${(sum(base) / sum(n)).toFixed(2)}×</td>`).join('')}<td></td></tr>` +
    `<tr><td>Peak engine process memory</td>${threads.map(n => `<td colspan="2">${((results.peak[n] || 0) / 1073741824).toFixed(2)} GiB</td>`).join('')}<td></td></tr></table>` +
    `<div class="note">${results.rows.toLocaleString()} rows. Each query gets one discarded warm-up per worker count; runs are interleaved across worker counts. Times are measured inside the engine (planning + execution), excluding the trip to the page. SQL:<br>${done.map(x => `<b>${x.label}</b>: <code>${x.sql().replace(/</g, '&lt;')}</code>`).join('<br>')}</div>`;
}
</script>
</body>
</html>

