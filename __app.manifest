}
function profilePlan(p, rows, source, tests) {
  const byId = {}, perTest = [];
  for (const q of tests) {
    const es = Object.values(p.tests?.[q.id]?.entries || {}).filter(e => e.source === source && e.engines);
    if (!es.length) continue;
    const e = es.reduce((a, b) => Math.abs(Math.log(b.rows / rows)) < Math.abs(Math.log(a.rows / rows)) ? b : a);
    byId[q.id] = Math.min(e.engines, MAXW);
    perTest.push({ id: q.id, n: byId[q.id], src: 'profile', from: e.rows });
  }
  return { byId, perTest };
}
async function renderProfile(p) {
  p ||= await loadProfile();
  const cols = [...new Set(Object.values(p.tests || {}).flatMap(t => Object.values(t.entries)).map(e => `${e.source}:${e.rows}`))]
    .sort((a, b) => a.split(':')[0].localeCompare(b.split(':')[0]) || a.split(':')[1] - b.split(':')[1]);
  if (!cols.length) { $('prof').innerHTML = 'No profile yet. Use "Profile this dataset" or "Profile all datasets".'; return; }
  const fmtRps = v => v >= 1e6 ? (v / 1e6).toFixed(1) + 'M/s' : Math.round(v / 1e3) + 'k/s';
  $('prof').innerHTML = `<table><tr><th>Test</th>${cols.map(c => { const [src, r] = c.split(':'); return `<th>${fmtRows(+r)} <span class="off">${src}</span></th>`; }).join('')}</tr>` +
    QUERIES.filter(q => p.tests[q.id]).map(q => `<tr><td>${q.label}</td>${cols.map(c => {
      const e = p.tests[q.id].entries[c];
      return e?.engines ? `<td title="${Object.entries(e.timings).map(([k, v]) => `${k}: ${fmtMs(v)}`).join('&#10;')}"><b>${e.engines}</b> wkr · ${fmtRps(e.rowsPerSec)}</td>` : '<td>-</td>';
    }).join('')}</tr>`).join('') +
    `</table><div class="note">Best worker count and rows/s per test and row count (hover a cell for every worker count's time). Updated ${p.updated ? new Date(p.updated).toLocaleString() : '-'} on a ${p.cores}-core machine.</div>`;
}
renderProfile();

// Same answer? Floats get a tiny relative tolerance: summing in a different order changes the last digits.
const close = (a, b) => typeof a === 'number' && typeof b === 'number' ? Math.abs(a - b) <= 1e-9 * Math.max(1, Math.abs(a), Math.abs(b)) : a === b;
const same = (a, b) => a.length === b.length && a.every((row, i) => row.length === b[i].length && row.every((v, j) => close(v, b[i][j])));

// ---- benchmark ----
let results = null;
const pickedTests = () => { const want = new Set([...$('tests').querySelectorAll('input:checked')].map(c => c.value)); return QUERIES.filter(q => want.has(q.id)); };
const busy = on => ['go', 'prof1', 'profAll'].forEach(id => $(id).disabled = on);

// One benchmark on one dataset. profile = every worker count 1..MAXW; the best is saved.
async function runBench({ ds, counts, auto, runs, inMem, profile = false }) {
  await ready;
  const tick = setInterval(paint, 100);
  try {
    step = 0; total = (counts.length + (auto ? 1 : 0)) * (1 + TESTS.length * (runs + 1)) + 1;
    const d = await ensureData(ds), rows = d.rows;
    let src = d.src, loadMs = null;
    if (inMem) {
      begin('Loading the data into engine memory');
      const t = await Engine.cache.load('bench_t', `SELECT ${NEED} FROM ${d.src}`);
      loadMs = t.ms; src = 'bench_t';
      log(`Loaded ${rows.toLocaleString()} rows into engine memory in ${fmtMs(t.ms)} (${(t.bytes / 1048576).toFixed(0)} MB)`);
    } else await Engine.cache.drop('bench_t');
    step++;
    let plan = null;
    if (auto) {
      const fromProfile = profilePlan(await loadProfile(), rows, inMem ? 'memory' : 'file', TESTS);
      const missing = TESTS.filter(q => fromProfile.byId[q.id] == null);
      const pre = missing.length ? await autoPlan(d.src, rows, missing) : { byId: {}, perTest: [], ms: 0 };
      const byId = { ...pre.byId, ...fromProfile.byId };
      plan = { byId, ms: pre.ms,
        perTest: TESTS.map(q => fromProfile.perTest.find(p => p.id === q.id) || { ...pre.perTest.find(p => p.id === q.id), src: 'prescan' }),
        label: !missing.length ? 'Auto (profile)' : missing.length === TESTS.length ? 'Auto (prescan)' : 'Auto (profile + prescan)' };
      log(`${plan.label}: workers per test: ` + plan.perTest.map(p => `${QUERIES.find(q => q.id === p.id).label} ${p.n}` +
        (p.src === 'profile' ? ` (profile @ ${fmtRows(p.from)} rows)` : ' (prescan)')).join(', ') + '.', 'ok');
    }
    const runList = counts.map(n => ({ key: n })).concat(plan ? [{ key: 'auto', auto: true }] : []);
    results = { tests: TESTS, counts: runList.map(r => r.key), base: ds.name, inMem, rows, plan, profile, q: {}, check: {}, fail: {}, load: loadMs, peak: {} };
    for (const q of TESTS) { results.q[q.id] = {}; results.check[q.id] = {}; results.fail[q.id] = {}; }
    // Reference answers: each test once with 1 worker.
    const ref = {};
    for (const q of TESTS) { try { begin(`Reference answer: ${q.label}`); ref[q.id] = (await run(q.sql(src), 1)).rows; } catch (e) { log(`No reference answer for ${q.label}: ${e.message}`, 'err'); } }
    for (const R of runList) {
      const key = R.key;
      begin(`Starting ${nameOf(key)}`); step++;
      MEM.mark(nameOf(key).replace(' workers', ' wkr').replace(' worker', ' wkr')); MEM.resetPeak();
      for (const q of TESTS) {
        const n = R.auto ? plan.byId[q.id] : key;
        try {
          begin(`${q.label}: warm-up, ${nameOf(key)}`);
          const w = await run(q.sql(src), n); step++;
          if (ref[q.id]) results.check[q.id][key] = same(ref[q.id], w.rows);
          const a = results.q[q.id][key] = [];
          for (let r = 0; r < runs; r++) { begin(`${q.label}: run ${r + 1}/${runs}, ${nameOf(key)}`); a.push((await run(q.sql(src), n)).ms); step++; }
        } catch (e) {
          results.fail[q.id][key] = e.message; delete results.q[q.id][key];
          log(`${q.label}, ${nameOf(key)}: FAILED: ${e.message}`, 'err'); step += runs;
        }
        render();
      }
      results.peak[key] = MEM.peak;
      log(`${nameOf(key)}: ` + TESTS.map(q => `${q.label} ${results.q[q.id][key] ? fmtMs(med(results.q[q.id][key])) : 'failed'}`).join(', ') + ` · peak engine memory ${MemMonitor.fmt(MEM.peak)}`, 'ok');
    }
    if (profile) {
      const p = await saveProfile(ds, results), s = inMem ? 'memory' : 'file';
      renderProfile(p);
      log(`Profile saved for ${ds.name} (${fmtRows(rows)} rows): ` + TESTS.map(q => `${q.label} → ${p.tests[q.id].entries[`${s}:${rows}`]?.engines ?? '?'}`).join(', '), 'ok');
    }
    label = 'Done'; step = total; paint(); render();
  } finally { clearInterval(tick); if (inMem) await Engine.cache.drop('bench_t').catch(() => {}); }
}

const uiOptions = () => ({ ds: dsOf($('data').value), runs: Math.max(1, +$('runs').value || 3), inMem: $('source').value === 'table' });
$('go').onclick = guard(async () => {
  TESTS = pickedTests();
  if (!TESTS.length) return log('Pick at least one test.', 'err');
  const picked = [...$('counts').querySelectorAll('input:checked')].map(c => c.value);
  if (!picked.length) return log('Pick at least one worker count.', 'err');
  busy(true);
  try { await runBench({ ...uiOptions(), counts: picked.filter(v => v !== 'auto').map(Number).sort((a, b) => a - b), auto: picked.includes('auto') }); }
  finally { busy(false); }
});
const ALL = () => [...new Set([1, 2, 3, 4, 6, 8, 12, 16, 24, 32, 48, 64].filter(n => n <= MAXW).concat(MAXW))];
$('prof1').onclick = guard(async () => {
  TESTS = pickedTests();
  if (!TESTS.length) return log('Pick at least one test.', 'err');
  busy(true);
  try { await ready; await runBench({ ...uiOptions(), counts: ALL(), auto: false, profile: true }); }
  finally { busy(false); }
});
$('profAll').onclick = guard(async () => {
  TESTS = pickedTests();
  if (!TESTS.length) return log('Pick at least one test.', 'err');
  const list = [...DATASETS.values()].sort((a, b) => a.rows - b.rows);
  if (!list.length) return log('No generated datasets yet: run generate-test-parquet-files.html first.', 'err');
  busy(true);
  try {
    await ready;
    for (const ds of list) {
      log(`=== Profiling ${ds.name} (${fmtRows(ds.rows)} rows) ===`);
      await runBench({ ...uiOptions(), ds, inMem: false, counts: ALL(), auto: false, profile: true });
    }
    log('Profile of all datasets finished.', 'ok');
  } finally { busy(false); }
});
$('unit').onchange = () => results && render();

// ?profile=all&runs=N profiles every generated dataset without clicks; ?profile=this does the selected one.
(async () => {
  const qs = new URLSearchParams(location.search);
  if (!qs.get('profile')) return;
  await datasetsReady; await ready;
  if (qs.get('runs')) $('runs').value = qs.get('runs');
  if (qs.get('data')) $('data').value = qs.get('data');
  if (qs.get('source')) $('source').value = qs.get('source');
  (qs.get('profile') === 'all' ? $('profAll') : $('prof1')).click();
})();

// ---- charts ----
const tip = $('tip');
const showTip = (e, t) => { tip.textContent = t; tip.style.display = 'block'; tip.style.left = e.clientX + 12 + 'px'; tip.style.top = e.clientY + 12 + 'px'; };
const hideTip = () => tip.style.display = 'none';
const nice = max => { const p = 10 ** Math.floor(Math.log10(max || 1)); for (const m of [1, 2, 5, 10]) if (m * p >= max) return m * p; return max; };

// Grouped bars: cats on x, one bar per series. ref = optional dashed reference value.
function bars(el, cats, series, unit, ref) {
  const W = 640, H = 290, L = 56, R = 8, T = 10, B = 30, iw = W - L - R, ih = H - T - B;
  const max = nice(Math.max(...series.flatMap(s => s.vals.map(v => v || 0)), ref || 0, 0.001));
  const y = v => T + ih - ih * v / max;
  const gw = iw / cats.length, bw = Math.min(26, (gw - 14) / series.length - 2);
  let s = `<svg viewBox="0 0 ${W} ${H}" role="img">`;
  for (let i = 0; i <= 4; i++) { const v = max * i / 4; s += `<line class="grid" x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}"/><text x="${L - 6}" y="${y(v) + 4}" text-anchor="end">${+v.toPrecision(3)}${unit}</text>`; }
  cats.forEach((c, i) => {
    const gx = L + gw * i + (gw - series.length * (bw + 2)) / 2;
    series.forEach((se, j) => {
      const v = se.vals[i]; if (v == null) return;
      const x = gx + j * (bw + 2), h = ih - (y(v) - T), r = Math.min(4, h / 2);
      s += `<path d="M${x},${T + ih} V${y(v) + r} Q${x},${y(v)} ${x + r},${y(v)} H${x + bw - r} Q${x + bw},${y(v)} ${x + bw},${y(v) + r} V${T + ih} Z" fill="${se.color}" data-tip="${c} · ${se.name}: ${se.fmt(v)}"/>`;
    });
    s += `<text x="${L + gw * i + gw / 2}" y="${H - 10}" text-anchor="middle">${c}</text>`;
  });
  if (ref) s += `<line class="ref" x1="${L}" x2="${W - R}" y1="${y(ref)}" y2="${y(ref)}"/>`;
  el.innerHTML = s + '</svg>';
  el.querySelectorAll('[data-tip]').forEach(p => { p.onmousemove = e => showTip(e, p.dataset.tip); p.onmouseleave = hideTip; });
}

function render() {
  const { q, check } = results, counts = results.counts.filter(n => results.tests.some(x => q[x.id][n]?.length));
  if (!counts.length) return;
  const done = results.tests.filter(x => counts.some(n => q[x.id][n]?.length)), base = counts[0];
  const m = (id, n) => q[id][n]?.length ? med(q[id][n]) : null;
  const perSec = $('unit').value === 'rows', rps = ms => results.rows / (ms / 1000);
  const fmtRps = v => v >= 1e6 ? (v / 1e6).toFixed(1) + 'M rows/s' : Math.round(v / 1e3) + 'k rows/s';
  const show = ms => perSec ? fmtRps(rps(ms)) : fmtMs(ms);
  const series = counts.map((n, i) => ({ n, name: nameOf(n), color: n === 'auto' ? 'var(--auto)' : COLORS[i % COLORS.length] }));
  $('lg1').innerHTML = $('lg2').innerHTML = series.map(s => `<span><i style="background:${s.color}"></i>${s.name}</span>`).join('');
  $('h1').textContent = perSec ? 'Rows per second by worker count (median, higher is better)' : 'Query time by worker count (median, lower is better)';
  bars($('c1'), done.map(x => x.label), series.map(s => ({ ...s,
    vals: done.map(x => m(x.id, s.n) && (perSec ? rps(m(x.id, s.n)) / 1e6 : m(x.id, s.n))),
    fmt: perSec ? v => fmtRps(v * 1e6) : fmtMs })), perSec ? 'M' : ' ms');
  bars($('c2'), done.map(x => x.label), series.map(s => ({ ...s, vals: done.map(x => m(x.id, s.n) && m(x.id, base) / m(x.id, s.n)), fmt: v => v.toFixed(2) + '×' })), '×', 1);
  $('c2').insertAdjacentHTML('beforeend', `<div class="note">Speedup = median time with ${nameOf(base)} ÷ median time for each column. Dashed line = no change.</div>`);
  const sum = n => done.reduce((a, x) => a + (m(x.id, n) || 0), 0);
  const ok = (id, n) => check[id][n] == null ? '' : check[id][n] ? ' <span class="ok">✓</span>' : ' <span class="err">✗</span>';
  const range = a => perSec ? `${show(Math.max(...a))} / ${show(Math.min(...a))}` : `${show(Math.min(...a))} / ${show(Math.max(...a))}`;
  $('tbl').innerHTML = `<table><tr><th>Query</th>${counts.map(n => `<th>${nameOf(n)}</th><th>min / max</th>`).join('')}<th>Best speedup</th></tr>` +
    done.map(x => {
      const best = Math.max(...counts.filter(n => m(x.id, n)).map(n => m(x.id, base) / m(x.id, n)));
      return `<tr><td>${x.label}</td>${counts.map(n => { const a = q[x.id][n]; return a?.length ? `<td>${show(med(a))}${ok(x.id, n)}${n === 'auto' ? ` <span class="off">(${results.plan.byId[x.id]})</span>` : ''}</td><td>${range(a)}</td>` : '<td>-</td><td>-</td>'; }).join('')}<td>${best.toFixed(2)}×</td></tr>`;
    }).join('') +
    `<tr><td><b>Total</b> (all queries)</td>${counts.map(n => `<td><b>${perSec ? fmtRps(results.rows * done.length / (sum(n) / 1000)) : fmtMs(sum(n))}</b></td><td>${(sum(base) / sum(n)).toFixed(2)}×</td>`).join('')}<td></td></tr>` +
    (results.inMem ? `<tr><td>Load into engine memory</td><td colspan="${counts.length * 2}">${results.load != null ? fmtMs(results.load) : '-'}</td><td></td></tr>` : '') +
    `<tr><td>Peak engine memory (server process)</td>${counts.map(n => `<td colspan="2">${results.peak[n] != null ? MemMonitor.fmt(results.peak[n]) : '-'}</td>`).join('')}<td></td></tr></table>` +
    `<div class="note">${results.base} (${results.rows.toLocaleString()} rows), ${results.inMem ? 'in-memory table' : 'Parquet from disk'}. ` +
    (results.plan ? `<b>Auto</b>${results.plan.ms ? ` (prescan ${fmtMs(results.plan.ms)})` : ''}: worker count per test (in brackets) from the saved profile, else √(work ÷ cost per worker) measured on a sample. ` : '') +
    `Times are measured inside the engine (planning + execution). Rows/s = source rows ÷ query time. ✓ = same answer as 1 worker. One discarded warm-up per query.</div>`;
}
</script>
</body>
</html>

=== FILE text 3404 3404 cd54ffcad9047f0c942cdffdfd78d098d7b71a62aa8f6c37638fd0f35d6657b1 71 html/engine-test.html
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Engine Test</title>
<script src="../js/core/theme.js"></script>
<link rel="stylesheet" href="../css/theme.css">
<style>
  textarea#sql { width: 100%; height: 110px; font-family: 'Syne Mono', ui-monospace, Consolas, monospace; }
  #path { min-width: 360px; }
  #out .table-wrap { max-height: 520px; }
</style>
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="brand"><span class="logo">ET</span><div><h1>Engine Test</h1><div class="sub" id="sub">Native C# engine: SQL console</div></div></div>
  </header>
  <div class="main stack">
    <div class="row">
      <label class="field">Project file or dataset folder<input id="path" type="text" value="test-data/sales_1m.parquet" spellcheck="false"></label>
      <button id="open" class="ghost" disabled>Use project file</button>
    </div>
    <label class="field">SQL<textarea id="sql" spellcheck="false">SELECT 42 AS answer</textarea></label>
    <div class="row">
      <button id="run" disabled>Run SQL</button>
      <button id="save" disabled>Write query to test-data/export.parquet</button>
      <span id="status" class="muted"></span>
    </div>
    <div class="log" id="log"></div>
    <div id="out"></div>
  </div>
</div>

<script src="../js/dn-fs.js"></script>
<script src="../js/core/ui.js"></script>
<script src="../js/core/engine-client.js"></script>
<script>
const { $ } = UI;
const log = (msg, cls = '') => { const d = document.createElement('div'); d.className = cls; d.textContent = `${UI.stamp()}  ${msg}`; $('log').prepend(d); };
const guard = fn => async () => { try { await fn(); } catch (e) { log('FAILED: ' + e.message, 'err'); console.error(e); } };

guard(async () => {
  const s = await Engine.status();
  log(`Native engine ${s.version} ready (${s.workers} workers on ${s.cores} cores, memory budget ${(s.memory.budget / 1073741824).toFixed(1)} GB)`, 'ok');
  ['open', 'run', 'save'].forEach(id => $(id).disabled = false);
})();
$('open').onclick = guard(async () => {
  const p = $('path').value.trim(), o = await Engine.open(p);
  log(`Using ${p}: ${o.kind}, ${o.columns.length} columns${o.rows != null ? `, ${UI.num(o.rows)} rows` : ''}`, 'ok');
  $('sql').value = `SELECT * FROM ${Engine.src(p, o.tables?.[0])} LIMIT 100`;
});
$('run').onclick = guard(async () => {
  $('status').textContent = 'Running…';
  const t0 = performance.now();
  try {
    const r = await Engine.query($('sql').value, { limit: 1000 });
    UI.dataTable($('out'), r.cols, r.rows, { max: 1000 });
    log(`Query: ${UI.num(r.rowCount)} row(s)${r.truncated ? ' (first 1,000 shown)' : ''}, engine ${UI.ms(r.ms)}, total ${UI.ms(performance.now() - t0)}`, 'ok');
  } finally { $('status').textContent = ''; }
});
$('save').onclick = guard(async () => {
  const t0 = performance.now();
  const r = await Engine.exportTo({ sql: $('sql').value, to: 'test-data/export.parquet', format: 'parquet' }, j => $('status').textContent = `${j.stage || 'Working'}… ${UI.num(j.rowsProcessed)} rows`);
  $('status').textContent = '';
  log(`Wrote ${r.path}: ${UI.num(r.rows)} rows, ${UI.bytes(r.bytes)} in ${UI.ms(performance.now() - t0)}`, 'ok');
});
$('sql').addEventListener('keydown', ev => { if (ev.key === 'Enter' && (ev.ctrlKey || ev.metaKey)) $('run').click(); });
</script>
</body>
</html>

=== FILE text 11048 11048 add06d00e1f9bde020e2f60ae553659ba24b9d4b834bc7096d375b668007d3b9 203 html/generate-test-parquet-files.html
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Test Parquet Generator</title>
<style>
  @font-face { font-family: 'Exo 2'; font-weight: 400; src: url(../assets/fonts/exo2-400.ttf) format('truetype'); }
  @font-face { font-family: 'Exo 2'; font-weight: 600; src: url(../assets/fonts/exo2-600.ttf) format('truetype'); }
  :root {
    color-scheme: light;
    --bg: #fcfcfb; --panel: #f4f4f2; --border: #dddcd6;
    --text: #0b0b0b; --text-2: #52514e; --muted: #85837c; --s1: #2a78d6;
    --ok: #0a7a3d; --err: #c42b2b;
  }
  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) {
      color-scheme: dark;
      --bg: #1a1a19; --panel: #242422; --border: #3a3936;
      --text: #ffffff; --text-2: #c3c2b7; --muted: #8d8b82; --s1: #3987e5;
      --ok: #4cc27f; --err: #ff7b7b;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 16px 20px; font: 14px 'Exo 2', system-ui, sans-serif; background: var(--bg); color: var(--text); }
  h1 { font-size: 18px; margin: 0 0 8px; }
  h2 { font-size: 14px; margin: 18px 0 6px; color: var(--text-2); font-weight: 600; }
  p { color: var(--text-2); margin: 0 0 10px; font-size: 13px; }
  button, input { font: inherit; }
  button { padding: 4px 10px; }
  input[type=number] { width: 52px; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; margin-bottom: 8px; }
  .box { background: var(--panel); border: 1px solid var(--border); border-radius: 4px; padding: 10px 12px; }
  #bar { height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; margin: 6px 0; }
  #fill { height: 100%; width: 0; background: var(--s1); transition: width .2s; }
  #msg { font-family: ui-monospace, Consolas, monospace; font-size: 13px; color: var(--text-2); }
  #log { font: 12px ui-monospace, Consolas, monospace; max-height: 160px; overflow: auto; color: var(--muted); white-space: pre-wrap; }
  .err { color: var(--err); } .ok { color: var(--ok); } .muted { color: var(--muted); }
  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { padding: 4px 8px; text-align: right; border-bottom: 1px solid var(--border); white-space: nowrap; }
  th:first-child, td:first-child { text-align: left; }
  th { color: var(--text-2); font-weight: 600; }
  .scroll { overflow-x: auto; }
  code { font: 12px ui-monospace, Consolas, monospace; }
</style>
</head>
<body>
<h1>Test Parquet generator</h1>
<p>Builds datasets of synthetic sales data with 50 columns into <code>test-data/gen/&lt;name&gt;/</code>: Parquet part files (Snappy, 100k-row row groups) plus a <code>manifest.json</code>.
Every value is computed from the row id, so the data is the same every time and an interrupted run picks up where it stopped. The native engine generates each part on all its workers; several parts can be in progress at once.</p>

<div class="row">
  <span>Datasets <span id="sizes"></span></span>
</div>
<div class="row">
  <label>Parts at once <input id="engines" type="number" min="1" max="8"></label>
  <button id="go">Generate</button>
  <button id="verify">Verify</button>
  <button id="stop" disabled>Stop after current parts</button>
</div>

<div class="box">
  <div id="msg">Idle.</div>
  <div id="bar"><div id="fill"></div></div>
  <div id="log"></div>
</div>

<h2>Datasets</h2>
<div id="tbl" class="box scroll"></div>

<h2>Columns</h2>
<div class="box scroll"><code id="cols"></code></div>

<script src="../js/dn-fs.js"></script>
<script src="../js/core/engine-client.js"></script>
<script src="../js/test-data-gen.js"></script>
<script>
const $ = id => document.getElementById(id), T = TestDataGen;
const log = (m, c = '') => { const d = document.createElement('div'); d.className = c; d.textContent = `${new Date().toLocaleString('sv-SE')}  ${m}`; $('log').append(d); $('log').scrollTop = 1e9; };
const fmtS = ms => (ms / 1000).toFixed(1) + ' s';
const MB = b => (b / 1048576).toFixed(0) + ' MB';
const fmtRows = n => n >= 1e6 ? (n / 1e6) + 'M' : (n / 1e3) + 'k';
const guard = fn => async () => { try { await fn(); } catch (e) { log('FAILED: ' + e.message, 'err'); console.error(e); } };
$('engines').value = 2;
$('sizes').innerHTML = T.SIZES.map(([n, r]) => `<label><input type="checkbox" value="${n}" checked> ${fmtRows(r)}</label>`).join(' ');
$('cols').textContent = T.COLUMNS.map(([n]) => n).join(', ');

// Status of each dataset on disk: { name, rows, parts, done, bytes, manifest }
const status = {};
async function scan() {
  for (const [name, rows] of T.SIZES) {
    const parts = T.plan(name, rows);
    let files = [];
    try { files = await DNFS.list(`${T.DIR}/${name}`); } catch {}
    const have = new Map(files.filter(f => !f.dir).map(f => [f.path, f.size]));
    const done = parts.filter(p => have.get(p.path) > 0);
    status[name] = { name, rows, parts, done: done.length, bytes: done.reduce((s, p) => s + have.get(p.path), 0), manifest: have.has(`${T.DIR}/${name}/manifest.json`), verified: status[name]?.verified };
  }
  render();
}
function render() {
  $('tbl').innerHTML = `<table><tr><th>Dataset</th><th>Rows</th><th>Parts</th><th>Size on disk</th><th>Status</th><th>Check</th></tr>` +
    T.SIZES.map(([name]) => {
      const s = status[name]; if (!s) return '';
      const st = s.manifest ? '<span class="ok">ready</span>' : s.done ? `${s.done}/${s.parts.length} parts` : '<span class="muted">not built</span>';
      return `<tr><td>${name}</td><td>${s.rows.toLocaleString()}</td><td>${s.parts.length}</td><td>${s.bytes ? MB(s.bytes) : '-'}</td><td>${st}</td><td>${s.verified || ''}</td></tr>`;
    }).join('') + '</table>';
}

// ---- generate ----
let stopping = false;
$('stop').onclick = () => { stopping = true; $('stop').disabled = true; log('Stopping after the parts in progress…'); };
$('go').onclick = guard(async () => {
  const want = [...$('sizes').querySelectorAll('input:checked')].map(c => c.value);
  if (!want.length) return log('Pick at least one dataset.', 'err');
  const n = Math.max(1, Math.min(8, +$('engines').value || 1));
  $('go').disabled = $('verify').disabled = true; $('stop').disabled = false; stopping = false;
  await scan();
  // One job per missing part, smallest datasets first.
  const jobs = [];
  for (const name of want) { const s = status[name]; for (const p of s.parts) if (!(await DNFS.stat(p.path)).exists) jobs.push({ name, p }); }
  const totalRows = jobs.reduce((s, j) => s + j.p.rows, 0);
  log(`${jobs.length} part(s) to build, ${totalRows.toLocaleString()} rows, ${n} part(s) at a time.`);
  const t0 = performance.now();
  let doneRows = 0, doneParts = 0, next = 0;
  const tick = setInterval(() => {
    const el = performance.now() - t0, rate = doneRows / (el / 1000);
    $('fill').style.width = (totalRows ? 100 * doneRows / totalRows : 100) + '%';
    $('msg').textContent = `${doneParts}/${jobs.length} parts · ${doneRows.toLocaleString()} rows · ${Math.round(rate).toLocaleString()} rows/s · ${fmtS(el)}` +
      (rate && doneRows < totalRows ? ` · about ${fmtS((totalRows - doneRows) / rate * 1000)} left` : '');
  }, 500);
  try {
    // n lanes; each takes the next part until none are left.
    await Promise.all(Array.from({ length: Math.min(n, jobs.length) }, async () => {
      while (!stopping && next < jobs.length) {
        const { name, p } = jobs[next++];
        // A failed write (e.g. a transient I/O error) is retried; one bad part must not stop the run.
        let ok = false;
        for (let attempt = 1; attempt <= 3 && !ok; attempt++) {
          try { await Engine.exportTo({ sql: T.sql(p.first, p.first + p.rows), to: p.path, format: 'parquet' }); ok = true; }
          catch (err) {
            log(`${p.path}: ${err.message}${attempt < 3 ? `; retrying (${attempt}/3)` : '; skipped. Run Generate again to build it.'}`, 'err');
            await new Promise(r => setTimeout(r, 1000 * attempt));
          }
        }
        doneRows += p.rows; doneParts++;
        if (!ok) continue;   // no manifest for this dataset until the part exists
        const s = status[name]; s.done++;
        if (s.done === s.parts.length) await finish(s);
      }
    }));
    for (const name of want) if (status[name].done === status[name].parts.length && !status[name].manifest) await finish(status[name]);
    log(stopping ? 'Stopped.' : `All done in ${fmtS(performance.now() - t0)}.`, 'ok');
  } finally {
    clearInterval(tick);
    $('go').disabled = $('verify').disabled = false; $('stop').disabled = true;
    await scan();
  }
});

// All parts written: record sizes and write the manifest.
async function finish(s) {
  let bytes = 0;
  for (const p of s.parts) bytes += (await DNFS.stat(p.path)).size;
  await DNFS.writeJSON(`${T.DIR}/${s.name}/manifest.json`, {
    name: s.name, rows: s.rows, columns: T.COLUMNS.length, bytes, created: new Date().toISOString(), generator: 'test-data-gen v1',
    parts: s.parts,
  });
  s.manifest = true; s.bytes = bytes;
  log(`${s.name}: ${s.rows.toLocaleString()} rows in ${s.parts.length} parts, ${MB(bytes)}. Manifest written.`, 'ok');
  render();
}

// ---- verify: every id 0..rows-1 present exactly once, 50 columns ----
// count = rows, min = 0, max = rows-1 and sum = rows*(rows-1)/2 together catch missing, extra and duplicated parts.
$('verify').onclick = guard(async () => {
  $('go').disabled = $('verify').disabled = true;
  try {
    await scan();
    for (const [name] of T.SIZES) {
      const s = status[name]; if (!s.manifest) continue;
      $('msg').textContent = `Verifying ${name}…`;
      const src = `read_parquet(${Engine.lit(`${T.DIR}/${name}`)})`;
      const t0 = performance.now();
      const [[c, mn, mx, sm]] = (await Engine.query(`SELECT count(*), min(id), max(id), CAST(sum(id) AS VARCHAR) FROM ${src}`)).rows;
      const cols = (await Engine.describe(`SELECT * FROM ${src}`)).length;
      const want = (BigInt(s.rows) * BigInt(s.rows - 1) / 2n).toString();
      const ok = +c === s.rows && +mn === 0 && +mx === s.rows - 1 && sm === want && cols === 50;
      s.verified = ok ? `<span class="ok">✓ ${(+c).toLocaleString()} rows, ids 0..${(s.rows - 1).toLocaleString()}, ${cols} columns</span>` : `<span class="err">✗ count ${c}, ids ${mn}..${mx}, sum ${sm} (want ${want}), ${cols} columns</span>`;
      log(`${name}: ${ok ? 'OK' : 'PROBLEM'} (${fmtS(performance.now() - t0)})`, ok ? 'ok' : 'err');
      render();
    }
    $('msg').textContent = 'Verify done.';
  } finally { $('go').disabled = $('verify').disabled = false; }
});

// ?auto=1&engines=N starts generating all datasets straight away (for unattended runs).
const qs = new URLSearchParams(location.search);
if (qs.get('engines')) $('engines').value = qs.get('engines');
scan().then(() => { if (qs.get('auto') === '1') $('go').click(); });
</script>
</body>
</html>

