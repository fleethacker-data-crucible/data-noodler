            return o;
        }
        public override Column Eval(Batch b)
        {
            BLit lit = r as BLit;
            if (lit != null && lit.Value != null) { Column fast = EvalConst(b, lit.Value); if (fast != null) return fast; }
            Column x = l.Eval(b), y = r.Eval(b);
            int n = b.Rows; Column o = new Column(DataType.Bool, n);
            bool[] d = o.B;
            for (int i = 0; i < n; i++)
            {
