document.documentElement.addEventListener('mouseleave', () => document.querySelectorAll('.sb-near').forEach(el => el.classList.remove('sb-near')));

// Dialogs close on Escape or a click on the dark backdrop.
const DIALOGS = ['mdlg', 'sdlg', 'udlg'];
addEventListener('keydown', e => { if (e.key === 'Escape') DIALOGS.forEach(id => $(id).hidden = true); });
DIALOGS.forEach(id => $(id).addEventListener('click', e => { if (e.target === $(id)) $(id).hidden = true; }));

// ---- Modules (developer shortcut): pick the served module, open the site ----
$('modules').onclick = async () => { $('msearch').value = ''; await loadState(true); $('mdlg').hidden = false; $('msearch').focus(); };
$('msearch').oninput = renderPages;
$('m-close').onclick = () => { $('mdlg').hidden = true; };
$('pages').addEventListener('click', e => {
  const d = e.target.closest('[data-p]');
  if (d) { selPage = d.dataset.p; renderPages(); }
});
// Opens the picked module in its own window for testing (default browser); the default is unchanged.
$('open').onclick = async () => {
  if (!selPage) return msg('Pick a module first.', false);
  const r = await api('open', { page: selPage });
  if (!r.ok) msg(r.error, false);
};

// ---- Settings: port (manual / random) and default browser ----
const radio = (name, v) => { if (v === undefined) return document.querySelector(`input[name=${name}]:checked`)?.value; document.querySelector(`input[name=${name}][value=${v}]`).checked = true; };
function syncPortMode() {
  const manual = radio('pmode') === 'manual';
  $('port').disabled = !manual; $('port').classList.toggle('off', !manual);
  if (!manual) { $('port').classList.remove('bad'); $('portnote').hidden = true; }
}
// Valid: a 5-digit port, 10000-65535 (65535 is the highest port).
function portError(p) {
