$('port').addEventListener('keydown', e => { if (e.key === 'Enter') $('s-save').click(); });
$('s-cancel').onclick = () => { $('sdlg').hidden = true; };
$('s-save').onclick = async () => {
  const body = { portMode: radio('pmode'), browser: radio('browser'), theme: radio('theme') };
