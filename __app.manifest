        ev.preventDefault();
        const line = ta.value.slice(lineStart(ta.selectionStart), ta.selectionStart), ind = line.match(/^[ \t]*/)[0];
        insert('\n' + ind + ((lang === 'json' ? /[{[]\s*$/ : /\(\s*$/).test(line) ? IND : ''));
      } else if (ev.key === ' ' && ev.ctrlKey) { ev.preventDefault(); suggest(true); }
    });
