<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Archives</title>
<script src="../js/core/embed.js"></script>
<script src="../js/core/theme.js"></script>
<link rel="stylesheet" href="../css/theme.css">
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="brand"><span class="logo">DN</span><div><h1 id="title">Archives</h1><div class="sub" id="sub"></div></div></div>
    <div class="spacer"></div>
    <input id="note" type="text" placeholder="Note for the snapshot (optional)" style="width:280px">
    <button id="snap">Take snapshot</button>
  </header>
  <div class="main stack">
    <div class="muted">A snapshot copies the project's settings, staged datasets, pipeline and dashboard into archives/. Source files and published output are not included.</div>
    <div class="table-wrap"><table class="grid" id="tbl"></table></div>
    <h2>Compare with current</h2>
    <div id="cmp" class="muted">Click Compare on a snapshot.</div>
    <h2>Activity</h2>
    <div class="log" id="log"></div>
  </div>
</div>

<script src="../js/dn-fs.js"></script>
<script src="../js/core/ui.js"></script>
<script src="../js/core/project-log.js"></script>
<script src="../js/core/projects.js"></script>
<script src="../js/core/module-page.js"></script>
<script>
const { $, esc } = UI;
let ctx;
const PARTS = ['project-config.json', 'data/staged', 'data/source', 'pipeline', 'dashboard']; // what a snapshot holds
const stamp = () => new Date().toISOString().slice(0, 19).replace(/[-:]/g, '').replace('T', '-');

async function snapshots() {
  let dirs = [];
  try { dirs = (await DNFS.list(`${ctx.dir}/archives`)).filter(d => d.dir); } catch {}
  const out = [];
  for (const d of dirs) { try { out.push({ ...(await DNFS.readJSON(`${d.path}/snapshot.json`)), path: d.path }); } catch {} }
  return out.sort((a, b) => b.at.localeCompare(a.at));
}
async function render() {
  const list = await snapshots();
  $('tbl').innerHTML = `<thead><tr><th>Taken</th><th>Note</th><th class="num">Datasets</th><th class="num">Size</th><th></th></tr></thead><tbody>` +
    list.map(s => `<tr data-p="${esc(s.path)}"><td>${UI.date(s.at)}</td><td>${esc(s.note || '')}</td><td class="num">${s.datasets.length}</td><td class="num">${UI.bytes(s.bytes)}</td>
      <td><button class="ghost small" data-act="cmp">Compare</button> <button class="small" data-act="restore">Restore</button> <button class="danger small" data-act="del">Delete</button></td></tr>`).join('') + '</tbody>';
  if (!list.length) $('tbl').innerHTML = '<tbody><tr><td class="muted">No snapshots yet.</td></tr></tbody>';
}

async function take(note) {
  await ctx.reload();
  const dir = `${ctx.dir}/archives/${stamp()}`;
  for (const p of PARTS) if ((await DNFS.stat(`${ctx.dir}/${p}`)).exists) await DNFS.copy(`${ctx.dir}/${p}`, `${dir}/${p}`);
  let bytes = 0;
  try { bytes = (await DNFS.list(dir, { recursive: true })).reduce((s, f) => s + (f.dir ? 0 : f.size), 0); } catch {}
  const info = { at: new Date().toISOString(), note, bytes, datasets: (ctx.cfg.datasets || []).map(d => ({ name: d.name, rows: d.rows, columns: d.columns.length })) };
  await DNFS.writeJSON(`${dir}/snapshot.json`, info);
  await Projects.touchModule(ctx.folder, 'archives');
  ctx.log(`Snapshot taken: ${dir.split('/').pop()}${note ? ` (${note})` : ''}, ${UI.bytes(bytes)}`, 'ok');
  return dir;
}
$('snap').onclick = UI.guard(async () => { $('snap').disabled = true; try { await take($('note').value.trim()); $('note').value = ''; UI.toast('Snapshot taken', 'ok'); await render(); } finally { $('snap').disabled = false; } });

// Current state vs a snapshot: datasets (rows, columns), pipeline steps, dashboard widgets.
async function compare(path) {
  const cur = await ctx.reload(), old = await DNFS.readJSON(`${path}/project-config.json`);
  const read = async p => { try { return await DNFS.readJSON(p); } catch { return null; } };
  const [pn, po, dn, dO] = await Promise.all([read(`${ctx.dir}/pipeline/pipeline.json`), read(`${path}/pipeline/pipeline.json`), read(`${ctx.dir}/dashboard/dashboard.json`), read(`${path}/dashboard/dashboard.json`)]);
  const names = [...new Set([...(old.datasets || []), ...(cur.datasets || [])].map(d => d.name))];
  const by = (l, n) => (l || []).find(d => d.name === n);
  const row = n => {
    const a = by(old.datasets, n), b = by(cur.datasets, n);
    const st = !a ? '<span class="ok">new</span>' : !b ? '<span class="err">removed</span>' : a.rows !== b.rows || a.columns.length !== b.columns.length ? '<span class="warn">changed</span>' : '<span class="muted">same</span>';
    return `<tr><td>${esc(n)}</td><td class="num">${a ? UI.num(a.rows) : '-'}</td><td class="num">${b ? UI.num(b.rows) : '-'}</td><td class="num">${a ? a.columns.length : '-'}</td><td class="num">${b ? b.columns.length : '-'}</td><td>${st}</td></tr>`;
  };
  $('cmp').innerHTML = `<div class="table-wrap"><table class="grid"><thead><tr><th>Dataset</th><th class="num">Rows then</th><th class="num">Rows now</th><th class="num">Columns then</th><th class="num">Columns now</th><th></th></tr></thead><tbody>${names.map(row).join('')}</tbody></table></div>
    <div style="margin-top:8px">Transform queries: ${(po?.queries || po?.steps || []).length} then, ${(pn?.queries || pn?.steps || []).length} now · Dashboard widgets: ${dO?.widgets?.length ?? 0} then, ${dn?.widgets?.length ?? 0} now · Status then: ${esc(old.status)}, now: ${esc(cur.status)}</div>`;
}

// Restore: snapshot the current state first, then copy the snapshot back. Name and folder stay as they are now.
async function restore(path) {
  if (!await UI.confirm('Restore this snapshot? Staged datasets, pipeline and dashboard are replaced. The current state is saved as a new snapshot first.', { danger: true, ok: 'Restore' })) return;
  await take(`Before restoring ${path.split('/').pop()}`);
  for (const p of PARTS.filter(p => p !== 'project-config.json')) {
    if ((await DNFS.stat(`${ctx.dir}/${p}`)).exists) await DNFS.remove(`${ctx.dir}/${p}`, { recursive: true });
    if ((await DNFS.stat(`${path}/${p}`)).exists) await DNFS.copy(`${path}/${p}`, `${ctx.dir}/${p}`); else await DNFS.mkdir(`${ctx.dir}/${p}`);
  }
  const old = await DNFS.readJSON(`${path}/project-config.json`), cur = await ctx.reload();
  await Projects.save({ ...old, name: cur.name, folder: cur.folder, id: cur.id, created: cur.created });
  ctx.log(`Restored snapshot ${path.split('/').pop()}`, 'ok'); UI.toast('Snapshot restored', 'ok');
}

$('tbl').onclick = UI.guard(async ev => {
  const b = ev.target.closest('[data-act]'); if (!b) return;
  const path = b.closest('tr').dataset.p;
  if (b.dataset.act === 'cmp') return compare(path);
  if (b.dataset.act === 'restore') { await restore(path); return render(); }
  if (!await UI.confirm(`Delete snapshot ${path.split('/').pop()}? This cannot be undone.`, { danger: true, ok: 'Delete' })) return;
  await DNFS.remove(path, { recursive: true }); ctx.log(`Deleted snapshot ${path.split('/').pop()}`); render();
});

(async () => {
  try { ctx = await ModulePage.init('archives', 'Archives'); await render(); }
  catch (e) { UI.toast(e.message, 'err'); }
})();
</script>
</body>
</html>

=== FILE text 6543 6543 6910769802d2cd240b4d41ef61015a1ed8f1947a43663da54b114cc013a9830b 100 html/dashboard-settings.html
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Widget Settings</title>
<script src="../js/core/theme.js"></script>
<link rel="stylesheet" href="../css/theme.css">
<style>
  html, body { height: 100%; margin: 0; overflow: hidden; background: var(--bg); color: var(--text); }
  .pop { display: grid; grid-template-columns: 300px 1fr; height: 100%; }
  .tree { border-right: 1px solid var(--border); background: var(--panel); overflow: auto; padding: 8px 0; user-select: none; }
  .tree .node { display: flex; align-items: center; gap: 6px; padding: 5px 12px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tree .node:hover { background: var(--panel-2); }
  .tree .node.on { background: var(--sel); }
  .tree .node .tw { width: 12px; flex: none; color: var(--muted); font-size: 11px; transition: transform .12s; text-align: center; }
  .tree .grp.open > .node .tw { transform: rotate(90deg); }
  .tree .node small { margin-left: auto; color: var(--muted); }
  .tree .kids { display: none; }
  .tree .grp.open > .kids { display: block; }
  .tree .kids .node { padding-left: 36px; color: var(--text-2); }
  .tree .root { font-weight: 600; padding: 8px 12px; color: var(--text); }
  .main { overflow: auto; padding: 16px 24px; }
  .main h2 { margin: 0 0 14px; }
  .body { display: flex; flex-direction: column; gap: 12px; max-width: 560px; text-align: left; }
  .empty { color: var(--muted); padding: 24px; }
  .flash { outline: 1px solid var(--blue); outline-offset: 3px; border-radius: 4px; }
</style>
</head>
<body>
<div class="pop">
  <nav class="tree" id="tree"></nav>
  <main class="main"><h2 id="h"></h2><div class="body" id="body"></div></main>
</div>
<script src="../js/widgets/color-picker.js"></script>
<script src="../js/widgets/apex-options.js"></script>
<script src="../js/widgets/apex-widget.js"></script>
<script src="../js/widgets/widget-settings.js"></script>
<script>
// Dashboard settings pop-out (opened by the Dashboard's "Pop-out Settings"). The Dashboard calls DNSettings.show() whenever
// the selection changes; everything is read from / written to the opener through window.opener.DashBridge.
// Left: tree (Widget, Inputs, option groups; expand a group for its settings). Right: the picked group's settings.
const $ = id => document.getElementById(id);
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const B = () => window.opener && !window.opener.closed ? window.opener.DashBridge : null;
let cur = null, group = 'Widget';
const openGroups = new Set(['Widget', 'Filter fields']);

function show() {
  const b = B(); cur = b ? b.state() : null;
  if (!cur) { $('tree').innerHTML = ''; $('h').textContent = ''; $('body').innerHTML = `<div class="empty">${b ? 'Click a widget on the dashboard to edit its settings.' : 'The dashboard window is closed.'}</div>`; return; }
  tree(); pane();
}
// The tree only (keeps the right side and its focus): after filter fields are added / removed / renamed.
function tree() {
  const groups = [{ name: 'Widget', count: 2, items: [{ label: 'Title', path: 'w:title' }, { label: 'Dataset', path: 'w:dataset' }] }, ...(cur.m ? WidgetSettings.tree(args()) : [])];
  if (!groups.some(g => g.name === group)) group = 'Widget';
  $('tree').innerHTML = `<div class="root">${esc(cur.title)}</div>` + groups.map(g => `<div class="grp ${openGroups.has(g.name) ? 'open' : ''}" data-g="${esc(g.name)}">
    <div class="node ${g.name === group ? 'on' : ''}"><span class="tw">&#9656;</span>${esc(g.name)}<small>${g.count}</small></div>
    <div class="kids">${g.items.map(i => `<div class="node" data-p="${esc(i.path)}">${esc(i.label)}</div>`).join('')}</div></div>`).join('');
}
const args = () => ({ manifest: cur.m, w: cur.w, columns: cur.columns, onChange: (kind, live) => { B()?.change(cur.w, kind, live); if (cur.m?.kind === 'filter') tree(); } });
function pane() {
  $('h').textContent = group;
  const el = $('body');
  if (group !== 'Widget') return WidgetSettings.render(el, { ...args(), only: group });
  const w = cur.w;
  el.innerHTML = `<label class="field" data-path="w:title">Title<input id="pTitle" type="text" value="${esc(w.title)}" placeholder="${esc(cur.pkgName)}"></label>
    <label class="field" data-path="w:dataset">Dataset<select id="pDs"><option value="">Select a dataset…</option>${cur.datasets.map(d => `<option ${d === w.dataset ? 'selected' : ''}>${esc(d)}</option>`).join('')}</select></label>
    ${cur.datasets.length ? '' : '<div class="muted">No ready datasets. Use Import Directly, or run the Transform on staged data.</div>'}`;
  $('pTitle').oninput = e => { B()?.setTitle(w, e.target.value); $('tree').querySelector('.root').textContent = e.target.value || cur.pkgName; };
  $('pDs').onchange = e => { B()?.setDataset(w, e.target.value); show(); };
}
$('tree').addEventListener('click', e => {
  const n = e.target.closest('.node'); if (!n) return;
  const p = n.dataset.p, g = n.closest('.grp');
  if (!g) return;
  if (!p) {   // group: toggle open (twisty) and show it
    const name = g.dataset.g;
    if (e.target.closest('.tw') || name === group) { g.classList.toggle('open'); g.classList.contains('open') ? openGroups.add(name) : openGroups.delete(name); }
    else { g.classList.add('open'); openGroups.add(name); }
    if (name !== group) { group = name; $('tree').querySelectorAll('.node.on').forEach(x => x.classList.remove('on')); n.classList.add('on'); pane(); }
    return;
  }
  // a setting: show its group, then scroll to it and flash it
  if (g.dataset.g !== group) { group = g.dataset.g; $('tree').querySelectorAll('.node.on').forEach(x => x.classList.remove('on')); g.querySelector('.node').classList.add('on'); pane(); }
  const row = [...$('body').querySelectorAll('[data-path]')].find(x => x.dataset.path === p);
  if (row) { row.scrollIntoView({ block: 'center', behavior: 'smooth' }); row.classList.add('flash'); setTimeout(() => row.classList.remove('flash'), 900); row.querySelector('input, select')?.focus(); }
});
// Own size / place (800 x 800, bottom-right corner of the screen), whatever the browser restored.
function place() {
  const W = 800, H = 800;
  try { resizeTo(W, H); moveTo((screen.availLeft ?? 0) + screen.availWidth - W, (screen.availTop ?? 0) + screen.availHeight - H); } catch {}
}
place(); addEventListener('load', place);
window.DNSettings = { show };
show();
setInterval(() => { if (!B() && cur) show(); }, 1500);   // the dashboard went away
</script>
</body>
</html>

