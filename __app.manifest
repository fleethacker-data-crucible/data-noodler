</head>
<body>
<h1>Engine benchmark: 1 vs 2 vs 4 ... native engine workers on Parquet</h1>
<div id="env">One native engine runs in the server; each query is split by Parquet row group across its workers (one compiled engine, up to 64 worker threads, never more than the CPU's logical cores), then the partial results are merged in row-group order. CPU logical cores: <b id="cores"></b>, engine workers: <b id="maxw"></b>.</div>

<div class="row">
  <label>Data <select id="data">
    <option value="test-data/sales_1m">sales_1m (1M rows)</option>
    <option value="test-data/sales_10m">sales_10m (10M rows)</option>
  </select></label>
  <label>Read from <select id="source">
    <option value="file">Parquet files (read from disk)</option>
    <option value="table">In-memory table (cached in the engine)</option>
  </select></label>
  <label>Runs <input id="runs" type="number" min="1" max="10" value="3"></label>
  <label>Show <select id="unit"><option value="time">Time (ms / s)</option><option value="rows">Rows per second</option></select></label>
  <span>Workers <span id="counts"></span></span>
</div>
<div class="row">
  <span>Tests <span id="tests"></span></span>
  <button id="go">Run benchmark</button>
  <button id="prof1" title="Runs every worker count from 1 to the engine's workers on this dataset and saves the fastest per test">Profile this dataset</button>
  <button id="profAll" title="Profiles every generated dataset, smallest first">Profile all datasets</button>
</div>

<div class="box">
  <div id="msg">Idle.</div>
  <div id="bar"><div id="fill"></div></div>
  <div id="log"></div>
</div>

<div class="box chart" style="margin-top:12px"><h3>Memory (live, every 250 ms)</h3><div id="mem"></div></div>

<div class="charts">
  <div class="box chart"><h3 id="h1">Query time by worker count (median, lower is better)</h3><div class="legend" id="lg1"></div><div id="c1"></div></div>
  <div class="box chart"><h3>Speedup vs 1 worker (higher is better)</h3><div class="legend" id="lg2"></div><div id="c2"></div></div>
</div>

<h2>Results</h2>
<div id="tbl" class="box">Run the benchmark to fill this in.</div>
<h2>Saved engine profile <span class="off">config/engine-profile.json</span></h2>
<div id="prof" class="box" style="overflow-x:auto">Loading…</div>
<div id="tip"></div>

<script src="../js/dn-fs.js"></script>
<script src="../js/core/engine-client.js"></script>
<script src="../js/test-data-gen.js"></script>
<script src="../js/mem-monitor.js"></script>
<script>
const $ = id => document.getElementById(id);
const log = (m, c = '') => { const d = document.createElement('div'); d.className = c; d.textContent = m; $('log').append(d); $('log').scrollTop = 1e9; };
const fmtMs = ms => (ms / 1000).toFixed(1) + ' s';
const med = a => { const b = [...a].sort((x, y) => x - y), h = b.length >> 1; return b.length % 2 ? b[h] : (b[h - 1] + b[h]) / 2; };
const COLORS = ['var(--s1)', 'var(--s2)', 'var(--s3)', 'var(--s4)', 'var(--s5)', 'var(--s6)', 'var(--s7)'];
const guard = fn => async () => { try { await fn(); } catch (e) { log('FAILED: ' + e.message, 'err'); console.error(e); } };

const MEM = MemMonitor.mount($('mem'));
let MAXW = 1, info = null;
const nameOf = k => k === 'auto' ? (results?.plan?.label || 'Auto') : `${k} worker${k > 1 ? 's' : ''}`;
const QUERIES = [
  { id: 'scan', label: 'Scan + sum', sql: s => `SELECT count(*) n, sum(total) total, sum(unit_price) / count(*) avg_price, max(order_date) last_date FROM ${s}` },
  { id: 'group', label: 'Group by', sql: s => `SELECT region, category, count(*) n, sum(total) total, avg(discount) avg_disc FROM ${s} GROUP BY ALL ORDER BY ALL` },
  { id: 'dist', label: 'Distinct', sql: s => `SELECT count(DISTINCT customer_id) customers, count(DISTINCT (customer_id, category)) customer_categories FROM ${s}` },
  { id: 'sort', label: 'Sort', sql: s => `SELECT max(rn) sorted_rows FROM (SELECT row_number() OVER (ORDER BY total DESC, id) rn FROM ${s})` },
  { id: 'join', label: 'Join', sql: s => `SELECT count(*) n, sum(s.total / c.max_total) v FROM ${s} s JOIN (SELECT customer_id, max(total) max_total FROM ${s} GROUP BY 1) c USING (customer_id)` },
  { id: 'window', label: 'Window', sql: s => `SELECT sum(rt) x FROM (SELECT sum(total) OVER (PARTITION BY customer_id ORDER BY order_date, id) rt FROM ${s})` },
];
$('tests').innerHTML = QUERIES.map(q => `<label><input type="checkbox" value="${q.id}" checked> ${q.label}</label>`).join(' ');
