    if (!n) return;
    Object.assign(u, n); uEdit = null;
    await saveUsers(`Saved ${u.display}.`);
  } else return;
  renderUsers();
});

// ---- Engine check: the native C# engine (in this server process) runs one query; click the value to re-run ----
async function engineTest() {
  const el = $('s-engine');
  el.textContent = 'TESTING'; el.className = ''; el.title = 'Click to re-run the test';
  try {
    const r = await api('engine');
    if (!r.ok) throw new Error(r.error || 'not loaded');
    el.textContent = 'ONLINE'; el.className = 'on';
    el.title = `Native engine ${r.version}: ${r.workers} workers on ${r.cores} cores, memory budget ${(r.memory.budget / 1073741824).toFixed(1)} GB. Click to re-run.`;
  } catch (e) {
    el.textContent = 'OFFLINE'; el.className = 'off'; el.title = e.message;
    if (state?.up) clientLog('err', `Engine check failed: ${e.message}`);   // stopped on purpose: not an error
  }
}
$('s-engine').onclick = engineTest;

loadState(true).then(poll);
engineTest();
  </script>
</body>
</html>

