}
$('settings').onclick = async () => {
  await loadState(false);
  radio('pmode', state.portMode || 'manual'); radio('browser', state.browser || 'edge'); radio('theme', state.theme || 'dark');
  $('port').value = state.portMode === 'manual' ? state.port : ''; $('port').classList.remove('bad'); $('portnote').hidden = true;
