                        {
                            string c = t.Col(o.Name);
                            if (t.Has(o.NewName) && !string.Equals(o.NewName, c, StringComparison.OrdinalIgnoreCase)) throw new EngineException("SQL_COLUMNS", "Column \"" + o.NewName + "\" already exists.");
