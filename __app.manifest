// Legacy: test-data/sales_*.csv converted once to test-data/sales_*.parquet.
// Generated: test-data/gen/<name>/ (generate-test-parquet-files.html), read as one dataset folder.
const DATASETS = new Map();
const fmtRows = n => n >= 1e6 ? +(n / 1e6).toFixed(1) + 'M' : Math.round(n / 1e3) + 'k';
const dsOf = v => DATASETS.get(v) || { base: v, name: v.split('/').pop() };
const datasetsReady = TestDataGen.list().then(list => {
  for (const m of list) {
    DATASETS.set('gen:' + m.name, { gen: true, ...m });
    $('data').insertAdjacentHTML('beforeend', `<option value="gen:${m.name}">${m.name} (${fmtRows(m.rows)} rows, ${m.columns} cols)</option>`);
  }
});
async function ensureData(ds) {
  if (ds.gen) return { src: `read_parquet(${Engine.lit(`${TestDataGen.DIR}/${ds.name}`)})`, rows: ds.rows };
  const pq = ds.base + '.parquet';
  if (!(await DNFS.stat(pq)).exists) {
    begin(`Converting ${ds.base}.csv to Parquet (one time)`);
    const t = performance.now();
    const w = await Engine.exportTo({ sql: `SELECT * FROM read_csv(${Engine.lit(ds.base + '.csv')})`, to: pq, format: 'parquet' });
    log(`Wrote ${pq}: ${(w.bytes / 1048576).toFixed(1)} MB in ${fmtMs(performance.now() - t)}`, 'ok');
  }
  const src = `read_parquet(${Engine.lit(pq)})`;
  return { src, rows: await Engine.count(src) };
}
const NEED = 'id, order_date, customer_id, region, category, unit_price, discount, total'; // columns the tests use

// Engine time of one query at n workers, and its rows.
async function run(sql, n) { const r = await Engine.query(sql, { workers: n, limit: 1000 }); return { ms: r.ms, rows: r.rows }; }

// Auto plan (prescan) for tests the profile does not cover, measured on a sample of up to 200k rows:
//  T(N) = W / N + c * N (W = work, c = cost per extra worker); from 1 and MAXW workers: c = (TM - T1 / M) / (M - 1 / M), W = T1 - c;
//  W scaled to all rows, N = sqrt(W / c) clamped to 1..MAXW.
async function autoPlan(src, rows, tests) {
  const t1 = performance.now(), S = Math.min(rows, 200000), M = MAXW;
  begin(`Auto: loading a ${S.toLocaleString()}-row sample`);
  await Engine.cache.load('bench_sample', `SELECT ${NEED} FROM ${src} LIMIT ${S}`);
  const time = async (q, n) => { await run(q.sql('bench_sample'), n); const ts = []; for (let r = 0; r < 3; r++) ts.push((await run(q.sql('bench_sample'), n)).ms); return med(ts); };
  const perTest = [];
  try {
    for (const q of tests) {
      begin(`Auto: timing ${q.label} on the sample`);
      const T1 = await time(q, 1), TM = M > 1 ? await time(q, M) : T1;
      const c = M > 1 ? Math.max(0.05, (TM - T1 / M) / (M - 1 / M)) : 0.05, w = Math.max(0, T1 - c) * rows / S;
      perTest.push({ id: q.id, w, c, n: Math.max(1, Math.min(M, Math.round(Math.sqrt(w / c)))) });
    }
  } finally { await Engine.cache.drop('bench_sample'); }
  return { byId: Object.fromEntries(perTest.map(p => [p.id, p.n])), perTest, ms: performance.now() - t1 };
}

// ---- saved engine profile: config/engine-profile.json ----
// tests.<id>.entries["<source>:<rows>"] = { rows, source, dataset, timings: { "<workers>": best median ms }, engines (= best workers), ms, rowsPerSec }
const PROFILE = 'config/engine-profile.json';
const loadProfile = async () => { try { return await DNFS.readJSONOr(PROFILE, { version: 1, tests: {} }); } catch { return { version: 1, tests: {} }; } };
async function saveProfile(ds, res) {
  const p = await loadProfile(), now = new Date().toISOString(), source = res.inMem ? 'memory' : 'file';
  Object.assign(p, { version: 1, cores: info.cores, workers: MAXW, updated: now, about: 'Fastest native-engine worker count per test and row count, measured by engine-bench.html. Auto picks the entry nearest the row count.' });
  p.tests ||= {};
  for (const q of res.tests) {
    const T = p.tests[q.id] ||= { label: q.label, entries: {} };
    const e = T.entries[`${source}:${res.rows}`] ||= { rows: res.rows, source, timings: {} };
    for (const k of res.counts) {
      const a = res.q[q.id][k];
      if (!a?.length || res.check[q.id][k] === false) continue;   // only correct runs count
      const m = Math.round(med(a) * 10) / 10;
      e.timings[k] = e.timings[k] == null ? m : Math.min(e.timings[k], m);
