<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <link rel="icon" href="favicon.ico?v=server">
  <title>Data Noodler Server</title>
  <style>
@font-face { font-family: 'Exo 2'; font-weight: 400; src: url(fonts/exo2-400.ttf) format('truetype'); }
@font-face { font-family: 'Exo 2'; font-weight: 600; src: url(fonts/exo2-600.ttf) format('truetype'); }
@font-face { font-family: 'Syne Mono'; src: url(fonts/SyneMono-Regular.ttf) format('truetype'); }

/* Dark by default; light when Settings > Appearance (settings.json theme) says so. */
:root {
  color-scheme: dark;
  --bg: #1a1a19; --panel: #242422; --border: #3a3936; --sel: #44433f;
  --text: #ffffff; --text-2: #c3c2b7; --muted: #8d8b82;
  --blue: #3987e5; --blue-h: #5a9cec; --ok: #4cc27f; --save: #3aa86a; --warn: #d9b343; --err: #e24c4c;
  --pink: #f27ab8; --engine: #3cc8c8; --lerr: #ff9090; --time: #aeaca4;
  --thumb: #3a3936; --thumb-h: #55534e;
}
:root[data-theme="light"] {
  color-scheme: light;
  --bg: #fcfcfb; --panel: #f4f4f2; --border: #dddcd6; --sel: #dcdbd5;
  --text: #0b0b0b; --text-2: #52514e; --muted: #85837c;
  --blue: #2a78d6; --blue-h: #1f66bd; --ok: #0a7a3d; --save: #086832; --warn: #a8850f; --err: #c42b2b;
  --pink: #d63a8a; --engine: #0e8a8a; --lerr: #c42b2b; --time: #85837c;
  --thumb: #c9c8c2; --thumb-h: #a9a8a1;
}

* { box-sizing: border-box; }
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: transparent; border-radius: 5px; border: 2px solid transparent; background-clip: padding-box; }
.sb-near::-webkit-scrollbar-thumb { background: var(--thumb); background-clip: padding-box; }
.sb-near::-webkit-scrollbar-thumb:hover { background: var(--thumb-h); background-clip: padding-box; }
::-webkit-scrollbar-corner { background: transparent; }
html, body { height: 100%; margin: 0; }
body {
  font-family: 'Exo 2', system-ui, sans-serif; font-size: 14px;
  background: var(--bg); color: var(--text);
  display: flex; flex-direction: column; padding: 0; gap: 0;
}
.mono { font-family: 'Syne Mono', ui-monospace, Consolas, monospace; font-size: 12px; }
h1 { font-size: 20px; font-weight: 600; margin: 0; }
h2 { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--text-2); margin: 0 0 10px; display: flex; align-items: center; gap: 10px; }
a { color: var(--blue); }

header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--border); }
.brand { display: flex; align-items: center; gap: 12px; }
.logo {
  width: 40px; height: 40px; border-radius: 8px; display: grid; place-items: center;
  background: var(--blue); color: #fff; font-weight: 600; font-size: 16px;
  padding-bottom: 2px; /* initials 1px up */
}
.sub { color: var(--muted); font-size: 12px; }

#s-status.on, #s-engine.on { color: var(--ok); } #s-status.off, #s-engine.off { color: var(--err); }
#s-engine { cursor: pointer; }


main { flex: 1; min-height: 0; display: grid; grid-template-columns: 365px 1fr; gap: 0; }
aside { display: flex; flex-direction: column; gap: 40px; overflow: auto; padding: 20px 25px 20px 20px; border-right: 1px solid var(--border); }
.panel { background: none; border: 0; padding: 0; margin: 0; }

.stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.stat { background: none; border: 0; padding: 0; margin: 0; min-width: 0; }
.stat label { display: block; font-size: 12px; color: var(--muted); }
.stat.wide { grid-column: 1 / -1; }
.stat b { display: block; font-size: 18px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.field { display: block; color: var(--text-2); margin-bottom: 12px; }
input[type=text] {
  display: block; width: 100%; margin-top: 4px; height: 25px; padding: 0 8px;
  font: inherit; color: var(--text); background: var(--bg);
  border: 1px solid var(--border); border-radius: 4px;
}
input:focus { outline: 2px solid var(--blue); outline-offset: -1px; }
input[type=radio], input[type=checkbox] { outline: none !important; }
*:focus, *:focus-visible { outline: none; }   /* no browser focus box anywhere */
input:focus { outline: 2px solid var(--blue); outline-offset: -1px; }

.pages { margin: 0 0 10px; border: 1px solid var(--border); border-radius: 4px; background: var(--bg); max-height: 320px; overflow: auto; }
.pages div { display: flex; justify-content: space-between; padding: 5px 8px; cursor: pointer; color: var(--text); }
.pages div + div { border-top: 1px solid var(--border); }
.pages div:hover { background: var(--panel); }
.pages div.sel { background: var(--sel); }
.pages div small { opacity: .7; }
.pages div small.def { color: var(--ok); opacity: 1; margin-left: 6px; }

.row { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; margin-bottom: 8px; }
#toggle { grid-column: 1 / -1; height: 55px; font-size: 16px; }   /* two button rows tall */
.actions-title { margin: 24px 0 10px; color: var(--blue); }
.dev-title { color: #d9822b; }
/* Fixed 40px gaps: last button row -> Port, Randomize -> Module, however many action buttons show. */
.panel > .row:last-child { margin-bottom: 0; }
#actions:not(:has(> :not([hidden]))) { display: none; }
.panel > .row:has(+ #actions:not(:has(> :not([hidden])))) { margin-bottom: 0; }
button.dev { background: #d9822b; }
.portrow { display: flex; align-items: center; gap: 10px; }
.portrow[hidden] { display: none; }
#port { width: 9ch; flex: none; }
#port.bad, #port.bad:focus { outline: 2px solid var(--err); outline-offset: -1px; }
.portnote { color: var(--err); font-size: 12px; }
.dialog.wide { width: min(460px, calc(100vw - 40px)); }
.dlg-btns:not(:has(> :not([hidden]))) { display: none; }
.sgroup { margin-bottom: 18px; }
.slabel { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--text-2); margin-bottom: 6px; }
.opt { display: flex; align-items: center; gap: 8px; padding: 4px 0; cursor: pointer; }
.opt .rec { color: var(--ok); font-size: 12px; }
#port { margin: 2px 0 6px 24px; }
.sgroup .off { opacity: .45; pointer-events: none; }
button {
  text-transform: capitalize;
  height: 25px; line-height: 1; padding: 0 14px 2px; border: 0; border-radius: 4px;
  background: var(--blue); color: #fff; font: inherit; font-weight: 600; cursor: pointer;
}
/* Hover, every button: the same colour, a little brighter. */
button:not(:disabled):hover { filter: brightness(1.15); }
:root[data-theme="light"] button:not(:disabled):hover { filter: brightness(0.9); }   /* light mode: hover darkens the button's own colour */
button.danger { background: var(--err); }
button.go { background: var(--save); }   /* green = Save buttons only */
button:disabled, button:disabled:hover { background: var(--sel); color: var(--muted); cursor: default; filter: none; }
button[hidden] { display: none; }

.logpanel { position: relative; display: flex; flex-direction: column; overflow: hidden; padding: 20px 20px 20px 25px; }
.loghead, .log .r { display: grid; grid-template-columns: var(--logcols, 19ch 6ch 4ch 9ch 7ch) minmax(0, 1fr); gap: 10px; }   /* --logcols: set from the longest values (addLines) */
.loghead { color: var(--muted); padding: 0 0 6px; }
.log { flex: 1; overflow-y: auto; overflow-x: hidden; }
.log .r { line-height: 1.6; }
.log .r > span { min-width: 0; overflow-wrap: anywhere; }
.log .t { color: var(--time); }
.log .m { color: var(--blue); }
.log .s, .log .ms { color: var(--text-2); }
.log .c2, .log .c3 { color: var(--ok); } .log .c4 { color: var(--warn); } .log .c5 { color: var(--lerr); }
.log .sys { color: var(--pink); grid-column: 2 / -1; }
.log .err { color: var(--lerr); grid-column: 2 / -1; }
.log .engine { color: var(--engine); grid-column: 2 / -1; }
.log .warn { color: #d9822b; grid-column: 2 / -1; }
.log .r.start, .log .r.stop { color: #fff; border-radius: 4px; margin: 0 -6px; padding: 0 6px; }
.log .r.start { background: var(--ok); }
.log .r.c4xx { background: #d9822b; color: #fff; border-radius: 4px; margin: 0 -6px; padding: 0 6px; }
.log .r.c4xx span { color: #fff; }
.log .r.stop { background: var(--err); }
.log .r.start .t, .log .r.stop .t { color: #fff; opacity: .85; }
.log .start, .log .stop { grid-column: 2 / -1; }
.log .client { color: var(--text-2); grid-column: 2 / -1; }
.notes { position: absolute; top: 24px; left: 50%; transform: translateX(-50%); width: min(520px, 90%); z-index: 11; display: flex; flex-direction: column; gap: 6px; pointer-events: none; }
.note { pointer-events: auto; position: relative; color: #fff; font-weight: 600; padding: 10px 34px 10px 14px; border-radius: 4px; box-shadow: 0 4px 14px #0006; animation: drop .25s ease-out; }
.note.ok { background: var(--ok); } .note.warn { background: #d9822b; } .note.err { background: var(--err); } .note.sys { background: var(--pink); } .note.engine { background: var(--engine); }
.note .x { position: absolute; top: 4px; right: 8px; background: none; border: 0; padding: 0; height: auto; color: #fff; font-size: 18px; line-height: 1; cursor: pointer; }
.note .x:hover { background: none; opacity: .8; }
@keyframes drop { from { transform: translateY(-100%); opacity: 0; } to { transform: none; opacity: 1; } }
.overlay { position: fixed; inset: 0; background: #0009; display: grid; place-items: center; z-index: 10; }
.overlay[hidden] { display: none; }
.dialog.users { width: min(640px, calc(100vw - 40px)); max-height: calc(100vh - 40px); display: flex; flex-direction: column; }
.uadd { display: grid; grid-template-columns: 1fr 1fr 44px 80px auto; gap: 6px; margin-bottom: 12px; }
.uadd input, .uedit input { margin-top: 0; }
.mi { text-align: center; text-transform: uppercase; }
select { height: 25px; font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--border); border-radius: 4px; }
/* Drop-down lists with rounded corners (Edge/Chrome customizable select; older browsers keep the plain list). */
@supports (appearance: base-select) {
  select:not([multiple]), ::picker(select) { appearance: base-select; }
  select:not([multiple]) { display: inline-flex; align-items: center; gap: 6px; padding: 0 6px 0 8px; cursor: pointer; }
  select:not([multiple])::picker-icon { color: var(--muted); font-size: 10px; }
  ::picker(select) {
    margin-top: 3px; padding: 4px; border: 1px solid var(--border); border-radius: 4px;
    background: var(--panel); color: var(--text); box-shadow: 0 6px 18px rgba(0, 0, 0, .35);
  }
  select option { padding: 4px 8px; border-radius: 4px; min-height: 0; }
  select option:hover, select option:focus-visible { background: var(--sel); outline: 0; }
  select option:checked { font-weight: 600; }
  select option::checkmark { display: none; }
}
.ulist { flex: 1; min-height: 60px; overflow: auto; border: 1px solid var(--border); border-radius: 4px; background: var(--bg); margin-bottom: 12px; }
.ulist .u + .u { border-top: 1px solid var(--border); }
.ulist .uname { padding: 6px 8px; cursor: pointer; }
.ulist .uname:hover { background: var(--panel); }
.ulist .u.open > .uname { background: var(--sel); font-weight: 600; }
.ubtns { display: flex; justify-content: space-between; padding: 6px 8px; }
.uedit { display: grid; grid-template-columns: 1fr 1fr 44px 80px auto; gap: 6px; padding: 0 8px 8px; }
.uhint { color: var(--muted); font-size: 12px; margin: -6px 0 10px; }
.uempty { padding: 6px 8px; color: var(--muted); }
.dialog { background: var(--panel); border: 1px solid var(--border); border-radius: 4px; padding: 20px 24px; width: 300px; }
.dialog b { display: block; font-size: 16px; font-weight: 600; margin-bottom: 14px; }
.dialog .row { margin-bottom: 10px; }
.dialog .cancel { width: 100%; background: var(--sel); color: var(--text); }
  </style>
  <!-- Last mode used, applied before paint (the server's setting is applied on the first poll). -->
  <script>try { document.documentElement.dataset.theme = localStorage.getItem('dn-theme') || 'dark'; } catch {}</script>
</head>
<body>
  <header>
    <div class="brand">
      <span class="logo" style="background: var(--err)">DN</span>
      <div>
        <h1>Data Noodler Server</h1>
        <div class="sub" id="root"></div>
      </div>
    </div>
  </header>

  <main>
    <aside>
      <section class="panel">
        <div class="stats">
        <div class="stat wide"><label>Current User</label><b id="s-user">-</b></div>
        <div class="stat"><label>Uptime</label><b id="s-uptime">0:00:00</b></div>
        <div class="stat"><label>Port</label><b id="s-port">-</b></div>
        <div class="stat"><label>Web Server (PowerShell)</label><b id="s-status">CONNECTING</b></div>
        <div class="stat"><label>Data Engine (C#)</label><b id="s-engine" title="Click to re-run the test">TESTING</b></div>
      </div>
      </section>

      <section class="panel">
        <div class="row"><button id="toggle" class="danger">Stop server</button></div>
        <h2 class="actions-title" style="margin-top: 37px">Server Actions</h2>
        <div id="actions" class="row sorted">
          <button id="clear" hidden>Clear log</button>
          <button id="users">Manage Users</button>
          <button id="settings">Settings</button>
        </div>
        <!-- Developer shortcuts (orange): this section goes away in production. -->
        <h2 class="actions-title dev-title">Dev Actions</h2>
        <div id="dev-actions" class="row sorted">
          <button id="modules" class="dev">Modules</button>
        </div>
      </section>
    </aside>

    <section class="panel logpanel">
      <div class="loghead mono"><span>TIMESTAMP</span><span>METHOD</span><span>CODE</span><span>SIZE</span><span>MS</span><span>PATH</span></div>
      <div id="notes" class="notes"></div>
      <div id="log" class="log mono"></div>
    </section>
  </main>

  <div id="mdlg" class="overlay" hidden>
    <div class="dialog wide">
      <b>Modules</b>
      <input id="msearch" type="text" placeholder="Search modules" spellcheck="false" autocomplete="off" style="width:100%;margin:8px 0">
      <div id="pages" class="pages"></div>
      <div class="row sorted dlg-btns">
        <button id="open" hidden>Open Module</button>
      </div>
      <button id="m-close" class="cancel">Close</button>
    </div>
  </div>

  <div id="sdlg" class="overlay" hidden>
    <div class="dialog wide">
      <b>Settings</b>
      <div class="sgroup">
        <div class="slabel">Port</div>
        <label class="opt"><input type="radio" name="pmode" value="manual"> Manual</label>
        <div id="portrow" class="portrow"><input id="port" type="text" inputmode="numeric" maxlength="5" autocomplete="off" spellcheck="false" placeholder="5 digits"><span id="portnote" class="portnote" hidden>Must be a 5-digit port, 10000-65535</span></div>
        <label class="opt"><input type="radio" name="pmode" value="random"> Random (new 5-digit port each time the server starts)</label>
      </div>
      <div class="sgroup">
        <div class="slabel">Default browser</div>
        <label class="opt"><input type="radio" name="browser" value="edge"> Edge <span class="rec">(Recommended: lighter on memory)</span></label>
        <label class="opt"><input type="radio" name="browser" value="chrome"> Chrome</label>
      </div>
      <div class="sgroup">
        <div class="slabel">Appearance (all windows)</div>
        <label class="opt"><input type="radio" name="theme" value="dark"> Dark</label>
        <label class="opt"><input type="radio" name="theme" value="light"> Light</label>
      </div>
      <div class="row">
        <button id="s-save" class="go">Save</button>
        <button id="s-cancel" class="cancel">Cancel</button>
      </div>
    </div>
  </div>

  <div id="udlg" class="overlay" hidden>
    <div class="dialog users">
      <b>Manage Users</b>
      <div class="uadd">
        <input id="u-last" type="text" placeholder="Last name" autocomplete="off">
        <input id="u-first" type="text" placeholder="First name" autocomplete="off">
        <input id="u-mid" class="mi" type="text" placeholder="MI" maxlength="1" autocomplete="off">
        <select id="u-type"><option>CIV</option><option>CTR</option><option>MIL</option><option>N/A</option></select>
        <button id="u-add">Add</button>
      </div>
      <div class="uhint">Enter Last, First, MI. Shown as: Last, First M. Type &mdash; saved to config/users.json</div>
      <div id="ulist" class="ulist"></div>
      <button id="u-close" class="cancel">Close</button>
    </div>
  </div>

  <script>
// Control panel for .server/server.ps1. The server writes every log entry to
// .server/logs/ as it happens; this panel mirrors the same entries.
const W = 1200, H = 800;   // control panel window size (capped to the screen below)
const $ = id => document.getElementById(id);
let state = null, selPage = null, since = 0, live = false;

// Size and center the app window.
function center() {
  const w = Math.min(W, screen.availWidth), h = Math.min(H, screen.availHeight);
  try {
    window.resizeTo(w, h);
    window.moveTo((screen.availLeft || 0) + (screen.availWidth - w) / 2, (screen.availTop || 0) + (screen.availHeight - h) / 2);
  } catch {}
}
center();
addEventListener('load', center);

async function api(path, body) {
  const r = await fetch('/api/' + path, body === undefined ? {} : { method: 'POST', body: JSON.stringify(body) });
  return r.json();
}

// Send panel-side errors to the server log too.
function clientLog(level, text) {
  try { navigator.sendBeacon('/api/clientlog', JSON.stringify({ level, text })); } catch {}
}
addEventListener('error', e => clientLog('err', `Panel error: ${e.message} (${e.filename}:${e.lineno}:${e.colno})`));
addEventListener('unhandledrejection', e => clientLog('err', `Panel unhandled rejection: ${e.reason?.stack || e.reason}`));

const fmtSize = n => n >= 1048576 ? Math.ceil(n / 1048576) + ' MB' : n >= 1024 ? Math.ceil(n / 1024) + ' KB' : n + ' B';
const fmtTime = s => [Math.floor(s / 3600), Math.floor(s / 60) % 60, s % 60].map((v, i) => i ? String(v).padStart(2, '0') : v).join(':');
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

function renderPages() {
  const f = ($('msearch').value || '').trim().toLowerCase();
  $('pages').innerHTML = state.pages.filter(p => !f || p.name.toLowerCase().includes(f)).map(p =>
    `<div data-p="${esc(p.name)}" class="${p.name === selPage ? 'sel' : ''}"><span>${esc(p.name)}</span><small>${fmtSize(p.size)}</small></div>`
  ).join('') || `<div>${f ? 'No matching modules' : 'No .html files found'}</div>`;
}

// ---- Light/dark: one global setting (Settings > Appearance, settings.json theme, default dark) ----
// Every window follows it: the app via /api/status, this panel via /api/state.
function applyTheme(t) {
  t = t === 'light' ? 'light' : 'dark';
  document.documentElement.dataset.theme = t;
  try { localStorage.setItem('dn-theme', t); } catch {}
}

async function loadState(resetForm) {
  const wasUp = state?.up;
  state = await api('state');
  if (wasUp !== undefined && wasUp !== state.up) engineTest();   // the engine stops and starts with the server
  if (state.theme && state.theme !== document.documentElement.dataset.theme) applyTheme(state.theme);
  $('root').textContent = state.root;
  // ONLINE only when the site is up and the engine is loaded and passed its start-up test.
  const ready = state.up && state.engine;
  $('s-status').textContent = ready ? 'ONLINE' : 'OFFLINE';
  $('s-status').className = ready ? 'on' : 'off';
  $('toggle').textContent = state.up ? 'Stop server' : 'Start server';
  $('toggle').className = state.up ? 'danger' : '';
  $('s-user').textContent = state.user || '-';
  $('s-port').textContent = state.port;
  $('s-uptime').textContent = fmtTime(state.uptime);
  $('open').hidden = !state.up;
  if (resetForm) { selPage = null; renderPages(); }
}
// Button groups (.sorted): visible buttons stack in alphabetical order; hidden ones take no space.
document.querySelectorAll('.sorted').forEach(g => [...g.children].sort((a, b) => a.textContent.localeCompare(b.textContent)).forEach(b => g.append(b)));
const syncClear = () => { $('clear').hidden = !$('log').children.length; };

// What usually causes each failing status code (shown in its notification).
const WHY = {
  400: 'Bad request: the request was malformed or had invalid values',
  401: 'Unauthorized: missing or wrong access token',
  403: 'Forbidden: path or origin not allowed (outside the project root, dot-folder, or other site)',
  404: 'Not found: no file or API at this path',
  405: 'Method not allowed for this path',
  409: 'Conflict: the target already exists or changed',
  413: 'Too large: the request body exceeds the limit',
  416: 'Range not satisfiable: requested byte range is outside the file',
  500: 'Server error: the server failed while handling this request',
};
// Column widths (mono font, so characters = ch): each fixed column as wide as its longest value; PATH gets the rest.
const colMax = ['TIMESTAMP', 'METHOD', 'CODE', 'SIZE', 'MS'].map(h => h.length);
function fitCols(vals) {
  let grew = false;
  vals.forEach((v, i) => { const n = String(v).length; if (n > colMax[i]) { colMax[i] = n; grew = true; } });
  if (grew) document.querySelector('.logpanel').style.setProperty('--logcols', colMax.map(n => n + 'ch').join(' '));
}
function addLines(lines) {
  const log = $('log');
  const atBottom = log.scrollTop + log.clientHeight >= log.scrollHeight - 4;
  for (const l of lines) {
    const r = document.createElement('div');
    r.className = 'r' + (l.k === 'start' || l.k === 'stop' ? ' ' + l.k : '');
    if (l.k === 'req' && l.c >= 400 && l.c < 500) r.classList.add('c4xx');
    fitCols(l.k === 'req' ? [l.t, l.m, l.c, fmtSize(l.s), `${l.ms} ms`] : [l.t]);
    if (l.k === 'req') {
      r.innerHTML = `<span class="t">${l.t}</span><span class="m">${esc(l.m)}</span><span class="c${String(l.c)[0]}">${l.c}</span>` +
        `<span class="s">${fmtSize(l.s)}</span><span class="ms">${l.ms} ms</span><span>${esc(l.p)}</span>`;
    } else {
      r.innerHTML = `<span class="t">${l.t}</span><span class="${l.k}">» ${esc(l.p)}</span>`;
    }
    log.appendChild(r);
    if (!live && l.k === 'err') note(l.p, 'err');   // errors from before the panel opened (startup) still notify
    if (live) {
