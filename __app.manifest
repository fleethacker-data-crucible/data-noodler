// ---- engine + worker counts ----
const ready = (async () => {
  info = await Engine.status();
  MAXW = info.workers;
  $('cores').textContent = info.cores; $('maxw').textContent = info.workers;
  const opts = [...new Set([1, 2, 3, 4, 6, 8, 12, 16, 24, 32, 48, 64].filter(n => n <= MAXW).concat(MAXW))];
  $('counts').innerHTML = opts.map(n => `<label><input type="checkbox" value="${n}" ${[1, 2, 4].includes(n) || n === MAXW ? 'checked' : ''}> ${n}</label>`).join(' ') +
    ` <label title="Uses the saved profile (nearest row count) for each test; a prescan fills any gaps"><input type="checkbox" value="auto" checked> <b>Auto</b></label>`;
