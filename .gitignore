server/.profile*/
server/logs/
server/.pid
# This install's settings (server/settings.json holds the tracked defaults and is never written at run time)
server/settings.local.json
server/settings.local.json.tmp
test-data/
temp/
.trash/
workspace/projects/*
!workspace/projects/.gitkeep

# Data files: never committed (any folder). Import reads these; datasets are Parquet.
*.csv
*.tsv
*.parquet
*.pq
*.sqlite
*.sqlite3
*.db
*.xlsx
*.xls
*.arrow
*.feather


# Installed version marker (Data_Noodler_Install.ps1)
version.txt

# Dashboard Studio: SAMPLE_ datasets ARE committed (overrides the data-file rules above)
!workspace/sample-data/**

# Claude Code files (local only)
/.claude/
/CLAUDE.md

# VS Code workspace (local only)
*.code-workspace

# User workspace (local only)
workspace/smpg/

# Local environment files (secrets)
.env
.env.*
!.env.example
!.env.sample
!.env.template
# Per-install user list (real names): never committed. See config/users.example.json
config/users.json

# Release packages written by Data_Noodler_Package.ps1
Data_Noodler_*.gz
