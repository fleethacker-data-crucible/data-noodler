{
  "$kind": "apexgrid",
  "data": [
    {
      "key": "fields",
      "label": "Fields",
      "role": "fields"
    }
  ],
  "columnDefaults": {
    "sort": true,
    "filter": true,
    "resizable": true
  },
  "sortConfiguration": {
    "multiple": true,
    "triState": true
  },
  "pagination": {
    "enabled": false,
    "pageSize": 25,
    "pageSizeOptions": [
      10,
      25,
      50,
      100,
      250
    ]
  },
  "selection": {
    "enabled": false,
    "mode": "multiple",
    "showCheckboxColumn": true
  },
  "editing": {
    "enabled": false,
    "mode": "cell",
    "trigger": "doubleClick"
  },
  "rowPinning": {
    "enabled": false
  },
  "rowReordering": {
    "enabled": false
  },
  "showQuickFilter": true,
  "showExport": true,
  "exportFilename": "data",
  "columnReordering": true,
  "columnSeparator": true,
  "columnMenu": true,
  "coordinateHints": false
}