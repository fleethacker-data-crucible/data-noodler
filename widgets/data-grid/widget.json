{
  "id": "data-grid",
  "name": "Data Grid",
  "description": "Table of the picked fields: sort, filter, search, resize, export",
  "version": 2,
  "kind": "apexgrid",
  "spec": "spec.json",
  "style": "style.css",
  "renderer": "grid.js",
  "inputs": [
    {
      "key": "fields",
      "label": "Fields",
      "role": "fields"
    }
  ],
  "options": [
    { "path": "columnDefaults.sort", "label": "Sortable columns", "group": "Columns", "type": "boolean", "default": true, "show": true },
    { "path": "columnDefaults.filter", "label": "Column filters", "group": "Columns", "type": "boolean", "default": true, "show": true },
    { "path": "columnDefaults.resizable", "label": "Resizable columns", "group": "Columns", "type": "boolean", "default": true, "show": true },
    { "path": "showQuickFilter", "label": "Search box", "group": "Toolbar", "type": "boolean", "default": true, "show": true },
    { "path": "showExport", "label": "Export button", "group": "Toolbar", "type": "boolean", "default": true, "show": true },
    { "path": "exportFilename", "label": "Export file name", "group": "Toolbar", "type": "text", "default": "data", "show": true }
  ]
}
